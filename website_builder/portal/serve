#!/bin/bash
# Website Builder Portal — local dev server
#
# Usage:
#   ./website_builder/portal/serve           # local sidecar (default)
#   ./website_builder/portal/serve --cloud   # use Cloud Run API
#
# Symlink to ~/.local/bin for convenience:
#   ln -s $(pwd)/website_builder/portal/serve ~/.local/bin/website-builder

set -e
cd "$(dirname "$0")"   # run from portal/

PORT=5174
SIDECAR_PORT=3456
URL="http://localhost:${PORT}"
MODE="local"
CLOUD_API_URL="https://ailang-dev-website-builder-ejjw6zt3bq-ew.a.run.app/api"

# Parse args
for arg in "$@"; do
  case "$arg" in
    --cloud)  MODE="cloud" ;;
    --local)  MODE="local" ;;
    *)        echo "Unknown option: $arg"; echo "Usage: serve [--local|--cloud]"; exit 1 ;;
  esac
done

echo "🌐 Starting Website Builder at ${URL}"
echo "   Mode: ${MODE}"
echo ""

# Install deps if needed
if [ ! -d node_modules ]; then
  echo "📦 Installing dependencies..."
  npm install
fi

SIDECAR_PID=""

if [ "$MODE" = "local" ]; then
  # Start Express sidecar (serves API + generated sites)
  echo "🔌 Starting sidecar API on port ${SIDECAR_PORT}..."
  node server.js &
  SIDECAR_PID=$!
  echo "   API: http://localhost:${SIDECAR_PORT}/api"
else
  echo "☁️  Using Cloud Run API: ${CLOUD_API_URL}"
  export VITE_API_URL="$CLOUD_API_URL"
fi

echo ""

# Start Vite in background
npx vite --port "$PORT" &
VITE_PID=$!

# Cleanup on exit
cleanup() {
  kill "$VITE_PID" 2>/dev/null
  [ -n "$SIDECAR_PID" ] && kill "$SIDECAR_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

# Wait for Vite to be ready
for i in $(seq 1 20); do
  sleep 0.5
  if curl -s -o /dev/null "http://localhost:${PORT}"; then
    break
  fi
done

# Open browser (macOS)
open "$URL" 2>/dev/null || echo "Open $URL in your browser"

echo ""
echo "Press Ctrl+C to stop"
wait "$VITE_PID"
