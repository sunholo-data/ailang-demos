#!/bin/bash
# Website Builder Portal — local dev server
#
# Usage:
#   ./website_builder/portal/serve
#
# Symlink to ~/.local/bin for convenience:
#   ln -s $(pwd)/website_builder/portal/serve ~/.local/bin/website-builder

set -e
cd "$(dirname "$0")"   # run from portal/

PORT=5174
SIDECAR_PORT=3456
URL="http://localhost:${PORT}"

echo "🌐 Starting Website Builder at http://localhost:${PORT}"
echo ""

# Install deps if needed
if [ ! -d node_modules ]; then
  echo "📦 Installing dependencies..."
  npm install
fi

# Start Express sidecar (serves API + generated sites)
echo "🔌 Starting sidecar API on port ${SIDECAR_PORT}..."
node server.js &
SIDECAR_PID=$!

# Start Vite in background
npx vite --port "$PORT" &
VITE_PID=$!

# Cleanup on exit
cleanup() {
  kill "$VITE_PID" 2>/dev/null
  kill "$SIDECAR_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

# Wait for Vite to be ready
for i in $(seq 1 20); do
  sleep 0.5
  if curl -s -o /dev/null "http://localhost:${PORT}"; then
    break
  fi
done

# Open browser (macOS)
open "$URL" 2>/dev/null || echo "Open $URL in your browser"

echo ""
echo "Press Ctrl+C to stop both servers"
wait "$VITE_PID"
