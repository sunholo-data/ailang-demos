module website_builder/services/site_structurer

-- Core AI module: takes uploaded content + description + style direction
-- and produces a structured website plan with design brief.

import std/ai (callJsonSimple)
import std/string (length)

-- Structure a website from uploaded content, description, and style direction.
-- Returns JSON with: title, description, designBrief (palette, typography, layout),
-- and pages (each with slug, title, and sections).
export func structureSite(contentJson: string, description: string, styleDirection: string) -> string ! {AI}
  ensures { length(result) > 10 }
{
  let prompt = "You are a talented website designer helping a non-technical person.\n\n" ++
    "The user wants a website for: " ++ description ++ "\n\n" ++
    "Style direction (starting point, you have creative freedom): " ++ styleDirection ++ "\n\n" ++
    "They uploaded this content:\n" ++ contentJson ++ "\n\n" ++
    "Create a complete website with MULTIPLE PAGES. Choose the right number of pages\n" ++
    "for this type of site (typically 3-7). Always include a home page.\n" ++
    "Pick pages that suit the business — e.g. portfolio, menu, services, testimonials,\n" ++
    "pricing, team, FAQ, blog, events, gallery, contact. Be creative.\n\n" ++
    "IMAGES — the uploaded content includes image items with a 'filename' field.\n" ++
    "Distribute image filenames across relevant sections. Any section showing images\n" ++
    "must include an 'images' array with the exact filenames.\n\n" ++
    "SECTIONS — be creative. Invent section types that suit the business and style.\n" ++
    "Examples: hero, story, split-image-text, masonry-gallery, team-grid,\n" ++
    "testimonials, stats-bar, features-grid, timeline, cta-banner, contact-form.\n" ++
    "Do not limit yourself to these — choose layouts that make this site distinctive.\n\n" ++
    "Return compact JSON (no whitespace) with this structure:\n" ++
    "{\"title\":\"...\",\"description\":\"...\",\"designBrief\":{" ++
    "\"mood\":\"...\",\"palette\":{\"primary\":\"#hex\",\"secondary\":\"#hex\"," ++
    "\"accent\":\"#hex\",\"background\":\"#hex\",\"text\":\"#hex\"}," ++
    "\"typography\":{\"headingFont\":\"Google Font name\",\"bodyFont\":\"Google Font name\"}," ++
    "\"layout\":{\"style\":\"...\",\"headerStyle\":\"...\",\"imageStyle\":\"...\"}," ++
    "\"personality\":\"one sentence describing how the website should feel\"}," ++
    "\"pages\":[" ++
    "{\"slug\":\"home\",\"title\":\"Home\",\"sections\":[{\"type\":\"hero\",\"title\":\"...\",\"images\":[\"filename.jpg\"],\"content\":\"...\"},{\"type\":\"features-grid\",\"title\":\"...\",\"content\":\"...\"}]}," ++
    "{\"slug\":\"about\",\"title\":\"About\",\"sections\":[...]}," ++
    "... more pages as appropriate for this business ..." ++
    "]}";
  callJsonSimple(prompt)
}

-- Suggest pages based on description alone (lightweight AI call).
export func suggestPages(description: string) -> string ! {AI}
  ensures { length(result) > 5 }
{
  let prompt = "A user wants a website for: " ++ description ++ "\n\n" ++
    "Suggest 3-5 pages that would work well. " ++
    "Return compact JSON array: [{\"slug\":\"home\",\"title\":\"Home\",\"purpose\":\"...\"},...]";
  callJsonSimple(prompt)
}

-- Refine site structure and/or design based on user feedback.
-- The AI decides whether the feedback is about content, design, or both.
export func refineSite(currentStructure: string, feedback: string) -> string ! {AI}
  ensures { length(result) > 10 }
{
  let prompt = "You are refining a website based on user feedback.\n\n" ++
    "Current website (structure + design brief):\n" ++ currentStructure ++ "\n\n" ++
    "User says: \"" ++ feedback ++ "\"\n\n" ++
    "The user is not technical. Interpret their feedback generously.\n" ++
    "Examples: 'more purple' = change palette, 'bigger photos' = change layout, " ++
    "'add my phone number' = change content.\n\n" ++
    "REMOVAL: If asked to remove an image or section, do it immediately and completely.\n" ++
    "Remove the filename from the section's 'images' array (or the whole section if empty).\n" ++
    "Do not keep something the user explicitly wants gone.\n\n" ++
    "Apply the requested changes and return the COMPLETE updated structure " ++
    "(including designBrief) as compact JSON. Keep everything they did not mention.";
  callJsonSimple(prompt)
}
