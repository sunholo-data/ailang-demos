-- Cognitive Commons — citizen behaviour.
--
-- The "main loop" of a single tab. Each tab is one citizen with one
-- persona. The compose function is invoked by the JS shell on a cadence
-- (or via the "Speak now" button). It:
--
--   1. Reads the current commons state (topic, sentiment, working statement)
--   2. Calls the AI to author a stanza + (if leading) an edit to the statement
--   3. Calls the judge to score the stanza on the (x, y) sentiment plane
--   4. Applies the score to local sentiment + decides if the manifesto
--      edit can land (edit-lock check is in consensus.ail)
--   5. Renders the chronicle panel via !: DOM and broadcasts to peer
--      tabs via !: Msg
--
-- IMPORTANT — this file was restructured 2026-05-21 to apply the 5
-- WASM-Friendly Patterns from `ailang devtools-prompt` § "WASM-Friendly
-- Patterns". The previous shape (triple-nested match in compose, three
-- back-to-back matches on score_result in speak, fat import list) hung
-- the WASM type-checker for 80+ seconds before the v0.22.x budget guard
-- shipped. The patterns below preserve identical behaviour while
-- staying inside the 2-second WASM budget.
--   - Pattern 1: flatten triple-nested match → sequential lets + helper
--   - Pattern 2: collapse three matches on Result[JudgeScore, _] → one unpack
--   - Pattern 3: trim consensus import to only used symbols
--   - Pattern 4: speak() already orchestrates (no change needed)
--   - Pattern 5: let-bind st.sentiment and proposer_target once
-- See demos/debug-notes/wasm-citizen-stack-overflow.md for the full
-- diagnostic trail that led to this refactor.

module cognitive_commons/services/citizen

import std/ai (callJson)
import std/json (Json, decode, getString)
import std/result (Result, Ok, Err)
import std/option (Some, None)
import std/string (length)

-- Pattern 3: trim. Drop leaderGap, EditOutcome, Accepted, RejectedNotLeader
-- (all imported in the previous version but never used). Drop DOMPatch
-- and println for the same reason.
import cognitive_commons/types/personas (Persona, Point, label, target, axis_definitions)
import cognitive_commons/services/consensus
  ( CommonsState
  , applyUtterance
  , applyManifestoEdit
  , currentLeader
  , RejectedTooShort
  )
import cognitive_commons/services/persuasion (JudgeScore, judgeUtterance)

-- The shape the citizen LLM is expected to return.
export type AuthorReply = {
  text: string,        -- one declarative sentence, 12-26 words
  glyph: string,       -- SVG path-d ornament; may be ""
  manifesto: string    -- proposed working-statement edit; ignored if not leading
}

-- Pattern 1 helper: extract one optional-string-with-default match into
-- a tiny pure function. Avoids the original's triple-nested match by
-- letting compose() call this once per field at the same nesting level.
pure func optional_string(j: Json, key: string) -> string =
  match getString(j, key) {
    Some(s) => s,
    None    => ""
  }

-- Build the system prompt for the author call. The user can override the
-- persona-specific portion via the JS UI; this function only assembles
-- the topic-anchor + edit-lock status that wraps it.
export pure func compose_system_prompt(
  persona_prompt: string,
  topic: string,
  st: CommonsState,
  proposer: Persona
) -> string = {
  let topic_line = if length(topic) > 0
    then "\n\n--- CURRENT DEBATE ---\nThe topic right now is: \"${topic}\"."
    else "";
  let leader_label = label(currentLeader(st));
  let proposer_label = label(proposer);
  let lock_status = if leader_label == proposer_label
    then "\nEDIT LOCK STATUS: ✓ You ARE currently leading the commons. YOUR manifesto edit WILL replace the working statement."
    else "\nEDIT LOCK STATUS: ✗ You are NOT leading — ${leader_label} is. Your manifesto field will be discarded. Focus your stanza on shifting sentiment to take over editing.";
  "${persona_prompt}${topic_line}${lock_status}"
}

-- Prompt-building helpers. Each is a small `pure func` that returns one
-- segment of the user-message prompt. The outer compose_user_prompt
-- concatenates them via a SHORT interpolation.
--
-- History: 2026-05-21 the WASM type-checker rejected the helper-decomposed
-- shape with a spurious "float vs int" error in commons_browser.ail. Root
-- cause was missing imported-alias + param/return annotation propagation
-- in the WASM ModuleRegistry.LoadModule path — fixed upstream in
-- ad84b68d (M-WASM-TYPECHECK-FLOAT-DIVERGENCE). With that fix, this
-- helper-decomposition pattern works again. We get the AILANG-side
-- conversation dynamics (address-by-name, react-to-last-move, force-by-
-- gap) back where they belong — in the typed effect-aware module — and
-- can drop the JS-side workaround in index.html::ailangSpeak.

pure func gap_force(gap: float) -> string =
  if gap < 0.3 then "gently reinforce"
  else if gap < 0.9 then "argue clearly to shift"
  else "argue forcefully to drag"

pure func conversation_block(recent: string) -> string =
  if length(recent) > 0
    then "THE CONVERSATION SO FAR (oldest first; you will speak NEXT):\n${recent}\n\nThe MOST RECENT speaker is the LAST line above. Your reply should REACT to them — name their move (agree-but-extend, partially-disagree, refute, or pivot away) before turning the floor.\n"
    else "You are the FIRST to speak in this commons. Set the opening tone for your persona.\n"

pure func sentiment_block(s: Point, t: Point, force: string) -> string =
  "Commons sentiment: x=${show(s.x)}, y=${show(s.y)}.\nYour preferred sentiment: x=${show(t.x)}, y=${show(t.y)}.\nYour task: ${force} the commons toward your corner, AS PART OF the ongoing argument.\n"

pure func constraints_block(proposer_label: string) -> string =
  "CONSTRAINTS:\n- Reply with ONE declarative sentence, 12-26 words.\n- ADDRESS the previous speakers BY NAME at least once when refuting (\"Skeptic, your...\", \"Synthesizer claims X — but...\", \"As Visionary just said...\"). Citizens know each other.\n- ACTIVELY REFUTE the strongest point against you; if you partially agree, name what you concede and what you reject.\n- Avoid fence-sitting and aphorisms. Make a specific move: refute / extend / pivot / yield-and-redirect.\n- Do NOT quote prior sentences verbatim. Do NOT repeat key phrases.\n- Do NOT start with your own persona name (\"As ${proposer_label}...\") or with quotation marks.\n- Use fresh vocabulary — surprise your interlocutors.\n"

pure func json_format_block() -> string =
  "Reply ONLY with strict JSON, no markdown fences:\n{\n  \"text\": \"<one declarative sentence, 12-26 words>\",\n  \"glyph\": \"<SVG path-d in -12..+12 range; M L A Q Z commands only>\",\n  \"manifesto\": \"<ONLY IF leading: 100-200 word edit of the working statement; otherwise empty string>\"\n}"

-- Build the user-message prompt by concatenating helper-built segments.
-- Restores the conversation dynamics from the original JS prototype:
-- addressing speakers by name, reacting to the most recent move,
-- dynamic force based on the (sentiment, target) gap.
export pure func compose_user_prompt(
  topic: string,
  recent_dialogue: string,
  proposer: Persona,
  st: CommonsState
) -> string = {
  let leader_label = label(currentLeader(st));
  let topic_block = if length(topic) > 0
    then "TOPIC OF DEBATE: \"${topic}\"\nEverything below is in service of arguing THIS topic. Stay on topic.\n\n"
    else "";
  let dialogue_block = conversation_block(recent_dialogue);
  let manifesto_block = if length(st.consensus_text) > 0
    then "\nTHE COMMONS' CURRENT WORKING STATEMENT (locked to ${leader_label}):\n\"\"\"\n${st.consensus_text}\n\"\"\"\n"
    else "\nTHE COMMONS' CURRENT WORKING STATEMENT: (empty — the first leader gets to draft it)\n";
  let proposer_label = label(proposer);
  let s = st.sentiment;
  let t = target(proposer);
  let dx = t.x - s.x;
  let dy = t.y - s.y;
  let gap = dx * dx + dy * dy;
  let force = gap_force(gap);
  let axes = axis_definitions();
  let sent_b = sentiment_block(s, t, force);
  let cons_b = constraints_block(proposer_label);
  let json_b = json_format_block();
  "${topic_block}${dialogue_block}\n${manifesto_block}\nYOUR ROLE: ${proposer_label}.\n${axes}\n${sent_b}\n${cons_b}\n${json_b}"
}

-- JSON schema for the author response (used where the provider supports it).
export pure func author_schema() -> string =
  "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"minLength\":20,\"maxLength\":400},\"glyph\":{\"type\":\"string\",\"maxLength\":400},\"manifesto\":{\"type\":\"string\",\"maxLength\":2400}},\"required\":[\"text\"],\"additionalProperties\":false}"

-- compose — issue the author LLM call.
--
-- Pattern 1: flatten the triple-nested match. The previous shape was
--   match decode { Err => ..., Ok(j) => match getString("error") { ... =>
--   match getString("text") { ... => Ok(...) }}}
-- which hangs the WASM type-checker. Now: one outer match, then
-- if/match on the error field, then one match on text. optional_string
-- helper handles glyph/manifesto without another nested match.
export func compose(
  persona_prompt: string,
  topic: string,
  recent_dialogue: string,
  proposer: Persona,
  st: CommonsState
) -> Result[AuthorReply, string] ! {AI} = {
  let sys = compose_system_prompt(persona_prompt, topic, st, proposer);
  let usr = compose_user_prompt(topic, recent_dialogue, proposer, st);
  let schema = author_schema();
  let full_prompt = "${sys}\n\n---\n\n${usr}";
  let raw = callJson(full_prompt, schema);
  match decode(raw) {
    Err(e) => Err("compose JSON parse failed: ${e}"),
    Ok(j) => {
      let provider_err = optional_string(j, "error");
      if length(provider_err) > 0
        then Err("AI provider: ${provider_err}")
        else match getString(j, "text") {
          None     => Err("compose JSON missing 'text'"),
          Some(tv) => Ok({
            text: tv,
            glyph: optional_string(j, "glyph"),
            manifesto: optional_string(j, "manifesto")
          })
        }
    }
  }
}

-- speak() with DOM + Msg effects is not implemented here — the browser
-- path uses commons_browser.speakJson which calls compose() directly.
-- DOM and Msg effects require AILANG v0.21.0+; omitted for v0.20.1 compat.
