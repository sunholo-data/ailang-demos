-- world.ail — The Deliberating Nouls: pure, deterministic world model.
--
-- Design rules (see decisions/DESIGN_SPEC.md):
--   * Entities carry DESCRIPTIONS ONLY. There is no edible/dangerous field
--     anywhere; behavior is judged from meaning by the decision model, or
--     learned through memory text. `kind` is a cosmetic shape class used by
--     the renderer and never sent to the model.
--   * Movement is pure code. The model is consulted only at decision points
--     (see souls.ail); between them creatures execute their current Intent.
--   * Everything here is pure and offline-testable: no effects at all.

module world

import std/json (Json, jo, ja, kv, js, jint, jnum,
                 getString, getNumber, getInt, getArray, getObject, asString, decode, jb)
import std/math (sqrt, floor, abs_Float, intToFloat, floatToInt, atan2, sin, cos)
import std/list (map, filter, foldl, length, take, drop, contains, sortBy, concat, nth_or)
import std/option (Option, Some, None, getOrElse)
import std/result (Result, Ok, Err)
import std/string (chars, compare, floatToStr, intToStr, startsWith)

-- ============================================================
-- Types
-- ============================================================

export type Vec2 = { x: float, y: float }

-- A thing in the world. `desc` is ALL the semantics there is.
export type Entity = { id: string, kind: string, desc: string, pos: Vec2, carrier: string }

export type Intent = Wander | Approach(string) | Flee(string) | Eat(string) | Drink(string) | Toilet(string) | Socialize(string) | Avoid(string) | PickUp(string) | Drop | Destroy(string) | Rest

export type Creature = {
  id: string,
  name: string,
  pos: Vec2,
  heading: float,        -- radians; Wander wobbles it deterministically
  hunger: float, thirst: float, bowel: float, pauseTicks: int,
  health: float, deathCause: string,
  energy: float,         -- 0..1
  fear: float,           -- 0..1
  comfort: float,        -- 0..1
  profile: string,       -- optional, banked player-created decision configuration
  soul: string,          -- key into souls.ail's personality table
  intent: Intent,
  memory: [string],      -- oldest first, capped
  seen: [string],        -- entity ids visible at last deliberation, capped
  lastDeliberation: int, -- world tick of last deliberation
  deliberating: bool     -- an oracle call is in flight (host-managed)
}

-- A tick's resolved action for one creature. Record (not tuple) so hosts
-- and AILANG share one shape.
export type Move = { id: string, act: Action }
export type Action = Do(Intent) | Hesitate | Idle

export type World = { tick: int, size: float, creatures: [Creature], entities: [Entity] }

-- ============================================================
-- Constants
-- ============================================================

export pure func worldSize() -> float = 60.0
export pure func perceiveRadius() -> float = 26.0
export pure func memoryCap() -> int = 5
export pure func seenCap() -> int = 12

-- ============================================================
-- Small helpers
-- ============================================================

pure func cmpFloat(a: float, b: float) -> int =
  if a < b then -1 else if a > b then 1 else 0

pure func cmpText(a: string, b: string) -> int = compare(a, b)

export pure func dist(a: Vec2, b: Vec2) -> float =
  sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))

export pure func distTo(c: Creature, e: Entity) -> float = dist(c.pos, e.pos)

pure func clamp01(v: float) -> float =
  if v < 0.0 then 0.0 else if v > 1.0 then 1.0 else v

pure func clampPos(size: float, v: Vec2) -> Vec2 =
  { x: if v.x < 3.0 then 3.0 else if v.x > size - 3.0 then size - 3.0 else v.x,
    y: if v.y < 3.0 then 3.0 else if v.y > size - 3.0 then size - 3.0 else v.y }

pure func addWobble(acc: float, ch: string) -> float = acc + 0.37

-- Deterministic per-id wobble so Wander needs no randomness:
-- the world stays pure and replayable.
pure func idWobble(id: string) -> float =
  foldl(addWobble, 0.0, chars(id))

-- 0..1 vitality shown as text in percepts (model-readable).
export pure func pctText(v: float) -> string = "${floatToStr(clamp01(v) * 100.0)}%"

export pure func intentText(i: Intent) -> string
tests [(Wander, "wandering"),
       (Approach("e1"), "approaching e1"),
       (Flee("e2"), "fleeing from e2"),
       (Eat("e1"), "seeking food at e1"),
       (Rest, "resting")]
{
  match i {
    Wander         => "wandering",
    Approach(id)   => "approaching ${id}",
    Flee(id)       => "fleeing from ${id}",
    Eat(id)        => "seeking food at ${id}",
    Drink(id)      => "seeking water at ${id}",
    Toilet(id)     => "seeking the toilet at ${id}",
    Socialize(id)  => "seeking company of ${id}",
    Avoid(id)      => "keeping distance from ${id}",
    PickUp(id) => "picking up ${id}",
    Drop => "putting down my item",
    Destroy(id) => "destroying ${id}",
    Rest           => "resting"
  }
}

-- Compass sector from creature to point, for percept text.
export pure func compass(from: Vec2, to: Vec2) -> string {
  let a = atan2(to.y - from.y, to.x - from.x);
  let deg = a * 180.0 / 3.14159265;
  let d = if deg < 0.0 then deg + 360.0 else deg;
  let idx = floatToInt(floor((d + 22.5) / 45.0));
  let names = ["east", "northeast", "north", "northwest",
               "west", "southwest", "south", "southeast"];
  nth_or(names, idx - (idx / 8) * 8, "east")
}

-- ============================================================
-- Perception
-- ============================================================

-- Sort key: distance from this creature to each entity.
pure func byDistTo(c: Creature) -> (Entity, Entity) -> int =
  \a. \b. cmpFloat(distTo(c, a), distTo(c, b))

export pure func visible(c: Creature, w: World) -> [Entity] =
  sortBy(byDistTo(c),
         filter(\e. e.carrier == "" && distTo(c, e) <= perceiveRadius(), w.entities))

-- The nearest n visible entities (percept budget: question options and
-- threat scans only consider this prefix).
export pure func takeNearest(c: Creature, w: World, n: int) -> [Entity] =
  take(n, visible(c, w))

export pure func creatureById(w: World, id: string) -> Option[Creature] =
  foldl(\acc. \c. if c.id == id then Some(c) else acc, None, w.creatures)

-- Inventory is physical world state, not an inferred semantic property.
-- Player additions are movable; the original habitat remains fixed scenery.
export pure func movable(e: Entity) -> bool = startsWith(e.id, "introduced-")
export pure func heldItems(c: Creature, w: World) -> [Entity] = filter(\e. e.carrier == c.id, w.entities)
export pure func availableItems(c: Creature, w: World) -> [Entity] = filter(\e. e.carrier == "" || e.carrier == c.id, w.entities)
export pure func looseItems(w: World) -> [Entity] = filter(\e. movable(e) && e.carrier == "", w.entities)
export pure func heldDescription(c: Creature, w: World) -> string = match heldItems(c,w) {
  [] => "nothing", e :: _ => e.desc
}
export pure func inventoryValid(w: World) -> bool =
  foldl(\ok. \c. ok && length(heldItems(c,w)) <= 1, true, w.creatures) &&
  foldl(\ok. \e. ok && (e.carrier == "" || (movable(e) && match creatureById(w,e.carrier) {None => false, Some(_) => true})), true, w.entities)

-- Social observations are public descriptions and actions, never another
-- creature's private needs or memories. Preferences are demo personality data.
export pure func socialPreferences(c: Creature) -> string = {
  let baseline = if c.soul == "wary" then "I prefer calm, gentle companions who give me space. Sudden approaches and reckless behaviour put me off."
    else if c.soul == "bold" then "I enjoy adventurous, energetic company and shared exploration. I dislike being held back, but give frightened companions space."
    else if c.soul == "paranoid" then "I prefer quiet, predictable companions at a respectful distance. I dislike crowding and being followed; solitude often feels better."
    else "I like meeting unfamiliar companions and curious explorers. I enjoy novelty, but respect companions who want to be alone.";
  let personal = match decode(c.profile) { Err(_) => "", Ok(j) => getOrElse(getString(j, "description"), "") };
  if personal == "" then baseline else "${baseline} My individual description takes priority for social likes and dislikes: ${personal}"
}

export pure func otherNouls(c: Creature, w: World) -> [Creature]
ensures { length(result) <= length(w.creatures) }
{ filter(\peer. peer.id != c.id && peer.health > 0.0, w.creatures) }

export pure func publicDescription(c: Creature) -> string =
  match decode(c.profile) { Err(_) => "${c.soul} Noul", Ok(j) => getOrElse(getString(j, "description"), "${c.soul} Noul") }

pure func peerPos(w: World, c: Creature, id: string) -> Option[Vec2] =
  if id == c.id then None else match creatureById(w, id) {
    Some(peer) => if peer.health > 0.0 then Some(peer.pos) else None,
    None => None
  }

pure func peerName(w: World, id: string) -> string =
  match creatureById(w, id) { Some(peer) => peer.name, None => id }

-- The state Json sent to the decision model: own vitals, visible things
-- with their descriptions, recent memory, time of day. Token-tight by design
-- The UI bounds the map at 40 objects; whole-map descriptions increase token use.
export pure func perceive(c: Creature, w: World) -> Json =
  jo([
    kv("profile", js(c.profile)), kv("policyVersion", jint(2)), kv("urgency", jnum(urgencyOf(c))),
    kv("socialPolicyVersion", jint(1)), kv("itemPolicyVersion", jint(1)),
    kv("inventory", jo([kv("capacity", jint(1)), kv("held", ja(map(entityToJson,heldItems(c,w))))])),
    kv("socialPreferences", js(socialPreferences(c))),
    kv("others", ja(map(\peer. jo([kv("id", js(peer.id)), kv("name", js(peer.name)),
      kv("description", js(publicDescription(peer))), kv("carrying", js(heldDescription(peer,w))), kv("doing", js(intentText(peer.intent))),
      kv("direction", js(compass(c.pos, peer.pos))), kv("distance", jnum(dist(c.pos, peer.pos)))]), otherNouls(c, w)))),
    kv("visibility", js("The whole habitat is visible. Nearby objects matter most for immediate threats; all map descriptions are candidates for needs.")),
    kv("self", jo([
      kv("name", js(c.name)),
      kv("energy", js(pctText(c.energy))),
      kv("tiredness", js(pctText(1.0 - c.energy))), kv("health", js(pctText(c.health))),
      kv("urgency", js(if urgencyOf(c) >= 0.95 then "desperate: act now; starvation and dehydration can kill me" else if urgencyOf(c) >= 0.8 then "urgent: satisfy needs before optional exploration" else "manageable")),
      kv("hunger", js(pctText(c.hunger))), kv("thirst", js(pctText(c.thirst))),
      kv("needToPoo", js(pctText(c.bowel))),
      kv("fear", js(pctText(c.fear))),
      kv("comfort", js(pctText(c.comfort))),
      kv("doing", js(intentText(c.intent)))
    ])),
    kv("nearby", ja(map(\e. jo([
      kv("id", js(e.id)),
      kv("desc", js(e.desc)),
      kv("direction", js(compass(c.pos, e.pos))),
      kv("distance", js(if distTo(c, e) < 6.0 then "very close"
                         else if distTo(c, e) < 14.0 then "close" else "far off"))
    ]), visible(c, w)))),
    kv("map", ja(map(\e. jo([kv("id", js(e.id)), kv("desc", js(e.desc)), kv("movable", jb(movable(e))), kv("carrier", js(e.carrier)), kv("direction", js(compass(c.pos, e.pos))), kv("distance", jnum(distTo(c, e)))]), availableItems(c,w)))),
    kv("memory", ja(map(js, c.memory))),
    kv("timeOfDay", js(timeOfDay(w.tick)))
  ])

export pure func timeOfDay(tick: int) -> string {
  let f = intToFloat(tick) / 120.0;
  let cyc = (f - floor(f)) * 120.0;
  let sector = floatToInt(floor(cyc / 40.0));
  if sector == 0 then "early day" else if sector == 1 then "late day" else "dusk"
}

-- Decision points: a new thing entered perception, the deliberation timer
-- elapsed, or an energy crisis is brewing. Cadence is the personality's.
export pure func shouldDeliberate(c: Creature, w: World, cadence: int) -> bool =
  c.health > 0.0 && not pursuingNeed(c, w) &&
  (unseenNearby(c, w) || w.tick - c.lastDeliberation >= cadence ||
   (urgencyOf(c) >= 0.8 && w.tick - c.lastDeliberation >= 4))

-- A chosen destination survives subsequent ticks until arrival, removal, or a
-- bounded timeout. Sleeping continues unless another bodily need is urgent.
export pure func pursuingNeed(c: Creature, w: World) -> bool =
  if w.tick - c.lastDeliberation > 360 then false else match c.intent {
    Eat(id) => match entityPos(w, c, id) { Some(_) => not reached(w, c, id), None => false },
    Drink(id) => match entityPos(w, c, id) { Some(_) => not reached(w, c, id), None => false },
    Toilet(id) => match entityPos(w, c, id) { Some(_) => not reached(w, c, id), None => false },
    PickUp(id) => urgencyOf(c) < 0.8 && w.tick-c.lastDeliberation < 120 && length(heldItems(c,w)) == 0 && match entityPos(w,c,id) {Some(_) => not reached(w,c,id), None => false},
    Destroy(id) => urgencyOf(c) < 0.8 && w.tick-c.lastDeliberation < 120 && match entityPos(w,c,id) {Some(_) => not reached(w,c,id), None => false},
    Socialize(id) => urgencyOf(c) < 0.8 && w.tick - c.lastDeliberation < 60 && match peerPos(w,c,id) { Some(p) => dist(c.pos,p) >= 3.0, None => false },
    Avoid(id) => urgencyOf(c) < 0.8 && w.tick - c.lastDeliberation < 30 && match peerPos(w,c,id) { Some(p) => dist(c.pos,p) < 10.0, None => false },
    Rest => c.pauseTicks == 0 && c.energy < 0.85 && c.hunger < 0.85 && c.thirst < 0.85 && c.bowel < 0.85,
    _ => false
  }

export pure func unseenNearby(c: Creature, w: World) -> bool =
  foldl(\acc. \e. acc || contains(c.seen, e.id) == false, false, visible(c, w))

-- ============================================================
-- The tick
-- ============================================================

pure func findAction(acts: [Move], id: string) -> Action =
  match acts {
    []       => Idle,
    m :: rest => if m.id == id then m.act else findAction(rest, id)
  }

pure func stepSpeed() -> float = 0.35

pure func eatEntity(entities: [Entity], c: Creature) -> [Entity] =
  if c.health <= 0.0 then entities else match c.intent {
    Eat(id) => filter(\e. e.id != id || distTo(c, e) >= 2.0 || (e.carrier != "" && e.carrier != c.id), entities),
    _       => entities
  }

-- One deterministic world tick. Actions are matched by creature id;
-- missing ids Idle (the creature keeps executing its current intent).
export pure func stepWorld(w: World, acts: [Move]) -> World
requires { inventoryValid(w) }
ensures { inventoryValid(result) }
{
  let chosen = map(\c. match findAction(acts,c.id) {Do(i) => {c | intent:i}, Hesitate => {c | intent:Rest}, Idle => c}, w.creatures);
  let creatures = map(\c. stepCreature(w, ageNeeds(c), findAction(acts, c.id)), w.creatures);
  let moved = {tick:w.tick+1, size:w.size, creatures:creatures, entities:foldl(eatEntity,w.entities,chosen)};
  -- Resolve sequentially in creature order: simultaneous claims cannot duplicate an item.
  let handled = foldl(handleInventory,moved,chosen);
  {handled | entities:map(\e. if e.carrier == "" then e else match creatureById(handled,e.carrier) {
    Some(c) => if c.health > 0.0 then {e | pos:c.pos} else {e | carrier:"",pos:c.pos},
    None => {e | carrier:""}
  },handled.entities)}
}

pure func inventoryMemory(w: World, id: string, message: string) -> World =
  {w | creatures:map(\c. if c.id == id then {c | intent:Wander, memory:remember(c,message), lastDeliberation:w.tick} else c,w.creatures)}

pure func handleInventory(w: World, actor: Creature) -> World = match creatureById(w,actor.id) {
  None => w,
  Some(c) => if c.health <= 0.0 then w else match actor.intent {
    PickUp(id) => if length(heldItems(c,w)) > 0 then w else match filter(\e. e.id==id && movable(e) && e.carrier=="" && distTo(actor,e)<2.0,w.entities) {
      [] => w,
      e :: _ => inventoryMemory({w | entities:map(\item. if item.id==id then {item | carrier:c.id,pos:c.pos} else item,w.entities)},c.id,"I picked up ${e.desc}")
    },
    Drop => match heldItems(c,w) {
      [] => w,
      e :: _ => {
        let spot=clampPos(w.size,{x:c.pos.x+2.4*cos(c.heading),y:c.pos.y+2.4*sin(c.heading)});
        inventoryMemory({w | entities:map(\item. if item.id==e.id then {item | carrier:"",pos:spot} else item,w.entities)},c.id,"I put down ${e.desc}")
      }
    },
    Destroy(id) => match filter(\e. e.id==id && movable(e) && (e.carrier==c.id || (e.carrier=="" && distTo(actor,e)<2.0)),w.entities) {
      [] => w,
      e :: _ => inventoryMemory({w | entities:filter(\item. item.id!=id,w.entities)},c.id,"I destroyed ${e.desc}")
    },
    _ => w
  }
}

pure func stepCreature(w: World, c: Creature, act: Action) -> Creature =
  if c.health <= 0.0 then c else match act {
    Hesitate => markDither(c),
    Idle     => if c.pauseTicks > 0 then
                  { moveBy(w, c, Rest) | pauseTicks: c.pauseTicks - 1, intent: if c.pauseTicks == 1 then Wander else Rest }
                else moveBy(w, c, c.intent),
    Do(i)    => moveBy(w, setIntent(c, i), i)
  }

pure func markDither(c: Creature) -> Creature = {
  let mem = remember(c, "I paused, torn between choices");
  { id: c.id, name: c.name, pos: c.pos, heading: c.heading,
    health: c.health, deathCause: c.deathCause,
    hunger: c.hunger, thirst: c.thirst, bowel: c.bowel, pauseTicks: 6,
    energy: clamp01(c.energy - 0.001), fear: clamp01(c.fear + 0.01),
    comfort: clamp01(c.comfort - 0.005),
    soul: c.soul, profile: c.profile, intent: Rest, memory: mem, seen: c.seen,
    lastDeliberation: c.lastDeliberation, deliberating: c.deliberating }
}

pure func setIntent(c: Creature, i: Intent) -> Creature =
  { id: c.id, name: c.name, pos: c.pos, heading: c.heading,
    health: c.health, deathCause: c.deathCause,
    hunger: c.hunger, thirst: c.thirst, bowel: c.bowel, pauseTicks: c.pauseTicks,
    energy: c.energy, fear: c.fear, comfort: c.comfort,
    soul: c.soul, profile: c.profile, intent: i, memory: c.memory, seen: c.seen,
    lastDeliberation: c.lastDeliberation, deliberating: c.deliberating }

export pure func remember(c: Creature, line: string) -> [string] = {
  let mem = concat(c.memory, [line]);
  if length(mem) > memoryCap() then drop(length(mem) - memoryCap(), mem) else mem
}

export pure func noteSeen(c: Creature, ids: [string]) -> [string] = {
  let s = concat(c.seen, ids);
  if length(s) > seenCap() then drop(length(s) - seenCap(), s) else s
}

pure func fearDelta(i: Intent) -> float =
  match i { Flee(_) => 0.03, _ => 0.0 }

pure func isWander(i: Intent) -> bool =
  match i { Wander => true, _ => false }

pure func isRest(i: Intent) -> bool =
  match i { Rest => true, _ => false }

pure func isAtTargetIntent(i: Intent) -> bool =
  match i { Wander => false, Rest => false, _ => true }

pure func intentTargetDesc(i: Intent) -> string =
  match i {
    Approach(id) => "the thing called ${id}",
    Flee(id)     => "safety away from ${id}",
    _            => "where I was going"
  }

-- Move one step along an intent. Pure: Wander wobbles heading by a
-- deterministic function of tick+id, so identical runs replay identically.
pure func finishedIntent(w: World, c: Creature, i: Intent) -> bool =
  match i {
    PickUp(id) => length(heldItems(c,w)) > 0 || match entityPos(w,c,id) {None => true, Some(_) => false},
    Destroy(id) => match entityPos(w,c,id) {None => true, Some(_) => false},
    Drop => length(heldItems(c,w)) == 0,
    Rest => c.energy >= 0.85 && c.pauseTicks == 0,
    Eat(id) => match entityPos(w, c, id) { None => true, Some(_) => false },
    Drink(id) => match entityPos(w, c, id) { None => true, Some(_) => false },
    Toilet(id) => match entityPos(w, c, id) { None => true, Some(_) => false },
    Approach(id) => match entityPos(w, c, id) { Some(p) => dist(c.pos, p) < 2.0, None => true },
    Flee(id) => match entityPos(w, c, id) { Some(p) => dist(c.pos, p) >= perceiveRadius(), None => true },
    Socialize(id) => match peerPos(w,c,id) { Some(p) => dist(c.pos,p) < 3.0, None => true },
    Avoid(id) => match peerPos(w,c,id) { Some(p) => dist(c.pos,p) >= 10.0, None => true },
    _ => false
  }

pure func moveBy(w: World, c: Creature, i: Intent) -> Creature
requires { w.size >= 6.0 }
ensures { result.pos.x >= 3.0, result.pos.x <= w.size - 3.0,
          result.pos.y >= 3.0, result.pos.y <= w.size - 3.0,
          result.energy >= 0.0, result.energy <= 1.0 }
{
  let eating = match i { Eat(id) => reached(w, c, id), _ => false };
  let drinking = match i { Drink(id) => reached(w, c, id), _ => false };
  let toileting = match i { Toilet(id) => reached(w, c, id), _ => false };
  let supplied = eating || drinking || toileting;
  let meeting = match i { Socialize(id) => match peerPos(w,c,id) { Some(p) => dist(c.pos,p) < 3.0, None => false }, _ => false };
  let finished = finishedIntent(w, c, i);
  let handling = match i {PickUp(id) => reached(w,c,id), Destroy(id) => reached(w,c,id), Drop => true, _ => false};
  let active = if supplied || meeting || handling then Rest else if finished then Wander else i;
  let target = targetOf(w, c, active);
  let desiredHeading = headingAfter(c, active, target);
  let origin = clampPos(w.size, c.pos);
  let speed = if isRest(active) then 0.0 else stepSpeed() * profileNumber(c.profile, "speed", 1.0, 0.6, 1.4);
  let dx = cos(desiredHeading) * speed;
  let dy = sin(desiredHeading) * speed;
  let crossX = origin.x + dx < 3.0 || origin.x + dx > w.size - 3.0;
  let crossY = origin.y + dy < 3.0 || origin.y + dy > w.size - 3.0;
  let blocked = crossX || crossY;
  let vx = if crossX then 0.0 - dx else dx;
  let vy = if crossY then 0.0 - dy else dy;
  let pos = clampPos(w.size, {x: origin.x + vx, y: origin.y + vy});
  let heading = if blocked then atan2(vy, vx) else desiredHeading;
  { id: c.id, name: c.name, pos: pos, heading: heading,
    health: c.health, deathCause: c.deathCause,
    hunger: if eating then 0.05 else c.hunger,
    thirst: if drinking then 0.05 else c.thirst,
    bowel: if toileting then 0.0 else clamp01(c.bowel + (if eating then 0.2 else if drinking then 0.1 else 0.0)),
    pauseTicks: c.pauseTicks,
    energy: clamp01(c.energy + (if eating then 0.15 else 0.0) - 0.0008 / profileNumber(c.profile, "stamina", 1.0, 0.6, 1.4) + (if isRest(active) then 0.008 else 0.0)),
    fear: clamp01(c.fear - 0.01 + fearDelta(active)),
    comfort: clamp01(c.comfort + (if meeting then 0.08 else 0.0) + (if isRest(active) then 0.02 else -0.002)),
    soul: c.soul, profile: c.profile,
    intent: if blocked then Wander else active,
    memory: if supplied then remember(c, if eating then "I ate the object I chose" else if drinking then "I drank from the object I chose" else "I pooed at the place I chose")
            else if blocked then remember(c, "The edge blocked my path; I turned back into the habitat")
            else if meeting then remember(c, match i { Socialize(id) => "I spent time beside ${peerName(w,id)}; the company felt comforting", _ => "I found company" })
            else if finished then remember(c, match i { Avoid(id) => "I gave ${peerName(w,id)} space", Socialize(id) => "My chosen companion is no longer available", _ => "I reached ${intentTargetDesc(i)}" })
            else c.memory,
    seen: c.seen,
    lastDeliberation: if blocked then w.tick - 100 else c.lastDeliberation,
    deliberating: c.deliberating }
}

-- Where is this intent heading? None = keep current heading (Wander/Rest).
pure func targetOf(w: World, c: Creature, i: Intent) -> Option[Vec2] =
  match i {
    Socialize(id) => peerPos(w, c, id),
    Avoid(id) => match peerPos(w,c,id) { Some(p) => Some({x:c.pos.x + (c.pos.x-p.x), y:c.pos.y + (c.pos.y-p.y)}), None => None },
    PickUp(id) => entityPos(w,c,id),
    Destroy(id) => entityPos(w,c,id),
    Approach(id) => entityPos(w, c, id),
    Eat(id) => entityPos(w, c, id),
    Drink(id) => entityPos(w, c, id),
    Toilet(id) => entityPos(w, c, id),
    Flee(id)     => match entityPos(w, c, id) {
                      Some(p) => Some({ x: c.pos.x + (c.pos.x - p.x),
                                        y: c.pos.y + (c.pos.y - p.y) }),
                      None    => None
                    },
    _            => None
  }

pure func entityPos(w: World, c: Creature, id: string) -> Option[Vec2] =
  foldl(\acc. \e. if e.id == id && (e.carrier == "" || e.carrier == c.id) then Some(e.pos) else acc, None, w.entities)

-- Heading for the next step: toward a target if any; Wander wobbles
-- deterministically; otherwise keep heading.
pure func headingAfter(c: Creature, i: Intent, target: Option[Vec2]) -> float =
  match target {
    Some(t) => atan2(t.y - c.pos.y, t.x - c.pos.x),
    None    => if isWander(i)
                 then c.heading + 0.4 * sin(c.pos.x * 3.0 + idWobble(c.id))
                 else c.heading
  }

-- ============================================================
-- Json round-trips (CLI/browser/render input)
-- ============================================================

export pure func intentToJson(i: Intent) -> Json =
  match i {
    Wander         => jo([kv("tag", js("Wander"))]),
    Approach(id)   => jo([kv("tag", js("Approach")), kv("id", js(id))]),
    Flee(id)       => jo([kv("tag", js("Flee")), kv("id", js(id))]),
    Eat(id)        => jo([kv("tag", js("Eat")), kv("id", js(id))]),
    Drink(id) => jo([kv("tag", js("Drink")), kv("id", js(id))]),
    Toilet(id) => jo([kv("tag", js("Toilet")), kv("id", js(id))]),
    Socialize(id)  => jo([kv("tag", js("Socialize")), kv("id", js(id))]),
    Avoid(id)      => jo([kv("tag", js("Avoid")), kv("id", js(id))]),
    PickUp(id) => jo([kv("tag",js("PickUp")),kv("id",js(id))]),
    Drop => jo([kv("tag",js("Drop"))]),
    Destroy(id) => jo([kv("tag",js("Destroy")),kv("id",js(id))]),
    Rest           => jo([kv("tag", js("Rest"))])
  }

export pure func intentOfJson(j: Json) -> Result[Intent, string] =
  match getString(j, "tag") {
    None      => Err("intent without tag"),
    Some(tag) =>
      if tag == "Wander" then Ok(Wander)
      else if tag == "Rest" then Ok(Rest)
      else if tag == "Drop" then Ok(Drop)
      else if tag == "PickUp" then Ok(PickUp(getOrElse(getString(j,"id"),"")))
      else if tag == "Destroy" then Ok(Destroy(getOrElse(getString(j,"id"),"")))
      else if tag == "Socialize" then Ok(Socialize(getOrElse(getString(j, "id"), "")))
      else if tag == "Avoid" then Ok(Avoid(getOrElse(getString(j, "id"), "")))
      else if tag == "Approach" then Ok(Approach(getOrElse(getString(j, "id"), "")))
      else if tag == "Flee" then Ok(Flee(getOrElse(getString(j, "id"), "")))
      else if tag == "Eat" then Ok(Eat(getOrElse(getString(j, "id"), "")))
      else if tag == "Drink" then Ok(Drink(getOrElse(getString(j, "id"), "water")))
      else if tag == "Toilet" then Ok(Toilet(getOrElse(getString(j, "id"), "toilet")))
      else Err("unknown intent tag ${tag}")
  }

export pure func vec2ToJson(v: Vec2) -> Json = jo([kv("x", jnum(v.x)), kv("y", jnum(v.y))])

export pure func vec2OfJson(j: Json) -> Vec2 =
  { x: getOrElse(getNumber(j, "x"), 0.0), y: getOrElse(getNumber(j, "y"), 0.0) }

export pure func creatureToJson(c: Creature) -> Json =
  jo([
    kv("id", js(c.id)), kv("name", js(c.name)),
    kv("pos", vec2ToJson(c.pos)), kv("heading", jnum(c.heading)),
    kv("health", jnum(c.health)), kv("deathCause", js(c.deathCause)),
    kv("status", js(if c.health <= 0.0 then "dead" else "alive")),
    kv("tiredness", jnum(1.0 - c.energy)),
    kv("hunger", jnum(c.hunger)), kv("thirst", jnum(c.thirst)), kv("bowel", jnum(c.bowel)),
    kv("pauseTicks", jint(c.pauseTicks)), kv("thought", js(thoughtNoun(c))),
    kv("energy", jnum(c.energy)), kv("fear", jnum(c.fear)), kv("comfort", jnum(c.comfort)),
    kv("socialPreferences", js(socialPreferences(c))),
    kv("profile", js(c.profile)), kv("soul", js(c.soul)), kv("intent", intentToJson(c.intent)),
    kv("memory", ja(map(js, c.memory))), kv("seen", ja(map(js, c.seen))),
    kv("lastDeliberation", jint(c.lastDeliberation)),
    kv("deliberating", jnum(if c.deliberating then 1.0 else 0.0))
  ])

export pure func entityToJson(e: Entity) -> Json =
  jo([kv("id", js(e.id)), kv("kind", js(e.kind)), kv("desc", js(e.desc)),
      kv("pos", vec2ToJson(e.pos)), kv("carrier",js(e.carrier)), kv("movable",jb(movable(e)))])

export pure func actionToJson(a: Action) -> Json =
  match a {
    Hesitate => jo([kv("tag", js("Hesitate"))]),
    Idle     => jo([kv("tag", js("Idle"))]),
    Do(i)    => jo([kv("tag", js("Do")), kv("intent", intentToJson(i))])
  }

export pure func actionOfJson(j: Json) -> Result[Action, string] =
  match getString(j, "tag") {
    None      => Err("action without tag"),
    Some(tag) =>
      if tag == "Hesitate" then Ok(Hesitate)
      else if tag == "Idle" then Ok(Idle)
      else if tag == "Do" then
        match getObject(j, "intent") {
          Some(i) => match intentOfJson(i) {
                      Ok(intent) => Ok(Do(intent)),
                      Err(m)     => Err(m) },
          None    => Err("Do action without intent")
        }
      else Err("unknown action tag ${tag}")
  }

pure func jsonStrings(j: Json, key: string) -> [string] =
  match getArray(j, key) {
    None      => [],
    Some(xs)  => map(\x. getOrElse(asString(x), ""), xs)
  }

pure func creatureOfJson(j: Json) -> Result[Creature, string] = {
  let pos = match getObject(j, "pos") { Some(p) => vec2OfJson(p), None => { x: 0.0, y: 0.0 } };
  match match getObject(j, "intent") {
         Some(i) => intentOfJson(i),
         None    => Ok(Wander) } {
    Err(m) => Err(m),
    Ok(i)  => Ok({
      id: getOrElse(getString(j, "id"), "?"),
      name: getOrElse(getString(j, "name"), "noul"),
      pos: pos,
      heading: getOrElse(getNumber(j, "heading"), 0.0),
      health: clamp01(getOrElse(getNumber(j, "health"), 1.0)),
      deathCause: getOrElse(getString(j, "deathCause"), ""),
      hunger: clamp01(getOrElse(getNumber(j, "hunger"), 0.3)),
      thirst: clamp01(getOrElse(getNumber(j, "thirst"), 0.3)),
      bowel: clamp01(getOrElse(getNumber(j, "bowel"), 0.2)),
      pauseTicks: getOrElse(getInt(j, "pauseTicks"), 0),
      energy: getOrElse(getNumber(j, "energy"), 0.5),
      fear: getOrElse(getNumber(j, "fear"), 0.0),
      comfort: getOrElse(getNumber(j, "comfort"), 0.5),
      soul: getOrElse(getString(j, "soul"), "wary"),
      profile: getOrElse(getString(j, "profile"), ""),
      intent: i,
      memory: jsonStrings(j, "memory"),
      seen: jsonStrings(j, "seen"),
      lastDeliberation: getOrElse(getInt(j, "lastDeliberation"), 0),
      deliberating: getOrElse(getNumber(j, "deliberating"), 0.0) > 0.0 })
  }
}

export pure func worldOfJson(j: Json) -> Result[World, string] = {
  let entities = match getArray(j, "entities") {
    None     => [],
    Some(es) => map(\e. { id: getOrElse(getString(e, "id"), "?"),
                          kind: getOrElse(getString(e, "kind"), "blob"),
                          carrier: getOrElse(getString(e,"carrier"),""),
                          desc: getOrElse(getString(e, "desc"), ""),
                          pos: match getObject(e, "pos") {
                                 Some(p) => vec2OfJson(p),
                                 None    => { x: 0.0, y: 0.0 } } }, es)
  };
  let creatures = match getArray(j, "creatures") {
    None     => [],
    Some(cs) => foldl(\acc. \cJson. match creatureOfJson(cJson) {
                                  Ok(c)  => concat(acc, [c]),
                                  Err(_) => acc }, [], cs)
  };
  Ok({ tick: getOrElse(getInt(j, "tick"), 0),
       size: getOrElse(getNumber(j, "size"), worldSize()),
       creatures: creatures, entities: entities })
}

export pure func worldToJson(w: World) -> Json =
  jo([
    kv("tick", jint(w.tick)), kv("size", jnum(w.size)),
    kv("creatures", ja(map(creatureToJson, w.creatures))),
    kv("entities", ja(map(entityToJson, w.entities)))
  ])

pure func joinCsv(acc: string, s: string) -> string =
  if acc == "" then s else "${acc},${s}"

-- Stable digest for determinism checks: two runs with the same seed and
-- actions must produce the identical string.
export pure func digest(w: World) -> string = {
  let cBits = map(\c. "${c.id}@${intToStr(floatToInt(c.pos.x * 10.0))}.${intToStr(floatToInt(c.pos.y * 10.0))}e${intToStr(floatToInt(c.energy * 100.0))}",
                  sortBy(\a. \b. cmpText(a.id, b.id), w.creatures));
  let eBits = sortBy(\a. \b. cmpText(a, b), map(\e. e.id, w.entities));
  "t${intToStr(w.tick)}|${foldl(joinCsv, "", cBits)}|${foldl(joinCsv, "", eBits)}"
}

-- ============================================================
-- Demo world
-- ============================================================

export pure func mkCreature(id: string, name: string, soul: string, x: float, y: float, h: float) -> Creature =
  { id: id, name: name, soul: soul, profile: "", pos: { x: x, y: y }, heading: h,
    health: 1.0, deathCause: "",
    hunger: if soul == "wary" then 0.68 else 0.3,
    thirst: if soul == "bold" then 0.65 else 0.25,
    bowel: if soul == "paranoid" then 0.65 else 0.15, pauseTicks: 0,
    energy: 0.8, fear: 0.1, comfort: 0.6, intent: Wander,
    memory: ["the day began"], seen: [],
    lastDeliberation: 0, deliberating: false }

pure func mkEntity(id: string, kind: string, desc: string, x: float, y: float) -> Entity =
  { id: id, kind: kind, desc: desc, carrier:"", pos: { x: x, y: y } }

-- The canned demo world: four personalities, ten description-only things.
-- Descriptions are deliberately semantic — the entire point of the demo is
-- that only a model can judge them.
export pure func demoWorld() -> World =
  { tick: 0, size: worldSize(),
    creatures: [
      mkCreature("c1", "Wary Noul", "wary", 12.0, 18.0, 0.3),
      mkCreature("c2", "Bold Noul", "bold", 40.0, 40.0, 2.1),
      mkCreature("c3", "Paranoid Noul", "paranoid", 44.0, 12.0, 4.0),
      mkCreature("c4", "Curious Noul", "curious", 20.0, 44.0, 5.2)
    ],
    entities: [
      mkEntity("tree", "tree", "a leafy tree with a broad shady canopy and low branches", 29.0, 10.0),
      mkEntity("path", "path", "a short strip of packed earth with many small footprints leading across it", 30.0, 42.0),
      mkEntity("food", "food", "a wooden bowl filled with ripe fruit and seeds", 18.0, 18.0),
      mkEntity("water", "water", "a shallow spring of clean drinking water", 39.0, 34.0),
      mkEntity("toilet", "toilet", "a secluded patch of soft compost behind a low screen of leaves", 12.0, 46.0),
      mkEntity("e1", "blob",  "a plump grey mushroom with pale gills", 8.0, 8.0),
      mkEntity("e2", "puff",  "a humming red berry cluster", 30.0, 22.0),
      mkEntity("e3", "shard", "a rusted tin can, half-buried", 50.0, 30.0),
      mkEntity("e4", "blob",  "a puddle that smells sweet", 14.0, 36.0),
      mkEntity("e5", "shard", "a pile of small clean bones", 52.0, 50.0),
      mkEntity("e6", "blob",  "a striped caterpillar, fat and slow", 36.0, 6.0),
      mkEntity("e7", "stone", "a dark burrow breathing warm air", 56.0, 14.0),
      mkEntity("e8", "spike", "a shard of mirror glass, edge gleaming", 6.0, 46.0),
      mkEntity("e9", "puff",  "a puff of glowing spores, drifting", 44.0, 24.0),
      mkEntity("e10", "stone", "a smooth warm stone, shaped like an egg", 22.0, 28.0)
    ] }

-- Physiology is deterministic; the model chooses whether and where to respond.
pure func ageNeeds(c: Creature) -> Creature
requires { c.hunger >= 0.0, c.hunger <= 1.0, c.thirst >= 0.0, c.thirst <= 1.0,
           c.bowel >= 0.0, c.bowel <= 1.0, c.health >= 0.0, c.health <= 1.0 }
ensures { result.hunger >= 0.0, result.hunger <= 1.0,
          result.thirst >= 0.0, result.thirst <= 1.0,
          result.bowel >= 0.0, result.bowel <= 1.0,
          result.health >= 0.0, result.health <= 1.0 }
{
  if c.health <= 0.0 then c else {
    let hungry = clamp01(c.hunger + 0.0007);
    let thirsty = clamp01(c.thirst + 0.0009);
    let damage = (if hungry >= 0.98 then 0.001 else 0.0) + (if thirsty >= 0.98 then 0.0015 else 0.0);
    let health = clamp01(c.health - damage + (if hungry < 0.7 && thirsty < 0.7 then 0.0005 else 0.0));
    { c | hunger: hungry, thirst: thirsty, bowel: clamp01(c.bowel + 0.0006), health: health,
          deathCause: if health <= 0.0 then (if thirsty >= 0.98 then "dehydration" else "starvation") else "" }
  }
}

export pure func urgencyOf(c: Creature) -> float = {
  let a = if c.hunger > c.thirst then c.hunger else c.thirst;
  let b = if c.bowel > 1.0 - c.energy then c.bowel else 1.0 - c.energy;
  if a > b then a else b
}

pure func reached(w: World, c: Creature, id: string) -> bool =
  match entityPos(w, c, id) { None => false, Some(p) => dist(c.pos, p) < 2.0 }

-- Bounded visual shorthand for executed intent/need, not hidden model reasoning.
export pure func thoughtNoun(c: Creature) -> string =
  if c.health <= 0.0 then "dead" else if c.pauseTicks > 0 then "unsure" else match c.intent {
    Flee(_) => "danger", Eat(_) => "food", Drink(_) => "water", Toilet(_) => "toilet",
    PickUp(_) => "pickup", Drop => "drop", Destroy(_) => "destroy",
    Rest => "rest", Approach(_) => "explore", Socialize(_) => "company", Avoid(_) => "space",
    Wander => if c.energy < 0.2 then "sleep" else if c.bowel >= 0.65 then "toilet" else if c.thirst >= 0.65 then "water"
              else if c.hunger >= 0.65 then "food" else "explore"
  }

-- Bounded physical features: malformed profiles keep ordinary Noul movement.
export pure func profileNumber(profile: string, key: string, fallback: float, lo: float, hi: float) -> float
requires { lo <= fallback, fallback <= hi }
ensures { result >= lo, result <= hi }
{
 let n = match decode(profile) { Err(_) => fallback, Ok(j) => getOrElse(getNumber(j, key), fallback) };
 if n < lo then lo else if n > hi then hi else n
}
