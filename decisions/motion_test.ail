module motion_test
import world (emptyIdentity, World, Creature, Intent, Wander, Rest, Flee, Approach, Do, Hesitate, stepWorld)
import std/io (println, exit)

pure func subject() -> Creature = {
  id: "c1", name: "Motion probe", pos: {x: 30.0, y: 30.0}, heading: 0.0,
  health: 1.0, deathCause: "",
  hunger: 0.3, thirst: 0.3, bowel: 0.2, pauseTicks: 0,
  energy: 0.5, fear: 0.2, comfort: 0.5, soul: "wary", profile: "", identity: emptyIdentity(), intent: Wander,
  memory: [], seen: [], lastDeliberation: 0, deliberating: false
}
pure func habitat(c: Creature) -> World = {
  tick: 0, size: 60.0, creatures: [c],
  entities: [{id: "threat", kind: "stone", carrier:"", desc: "a nearby stranger", pos: {x: 40.0, y: 30.0}}]
}
pure func first(w: World) -> Creature = match w.creatures { c :: _ => c, [] => subject() }
pure func rests() -> bool {
  let c = subject();
  let after = first(stepWorld(habitat(c), [{id: c.id, act: Do(Rest)}]));
  after.pos.x == c.pos.x && after.pos.y == c.pos.y && after.energy > c.energy
}
pure func bounces() -> bool {
  let c = { subject() | pos: {x: 59.0, y: 59.0}, heading: 0.7 };
  let after = first(stepWorld(habitat(c), [{id: c.id, act: Do(Wander)}]));
  after.pos.x < c.pos.x && after.pos.y < c.pos.y
}
pure func fleesBoundary() -> bool {
  let c = { subject() | pos: {x: 59.0, y: 30.0}, heading: 0.0 };
  let w1 = stepWorld(habitat(c), [{id: c.id, act: Do(Flee("threat"))}]);
  let a = first(w1);
  let b = first(stepWorld(w1, []));
  a.pos.x < c.pos.x && b.pos.x < a.pos.x
}
pure func reachesSafety() -> bool {
  let c = { subject() | pos: {x: 5.0, y: 30.0}, heading: 0.0 };
  let after = first(stepWorld(habitat(c), [{id: c.id, act: Do(Flee("threat"))}]));
  match after.intent { Wander => after.fear < c.fear, _ => false }
}
pure func hesitationPersists() -> bool {
  let c = { subject() | intent: Flee("threat") };
  let w1 = stepWorld(habitat(c), [{id: c.id, act: Hesitate}]);
  let after = first(stepWorld(w1, []));
  after.pos.x == c.pos.x && after.pos.y == c.pos.y
}
pure func targetDisappears() -> bool {
  let c = subject();
  let after = first(stepWorld(habitat(c), [{id: c.id, act: Do(Approach("missing"))}]));
  match after.intent { Wander => true, _ => false }
}

test "rest stops movement and recovers energy" { assert rests() }
test "corner collision turns both axes inward" { assert bounces() }
test "blocked fleeing leaves the wall on consecutive ticks" { assert fleesBoundary() }
test "flee finishes beyond perception distance" { assert reachesSafety() }
test "hesitation does not resume the previous flee intent" { assert hesitationPersists() }
test "missing target releases approach intent" { assert targetDisappears() }

export func main() -> () ! {IO} {
  println("rest: ${rests()}");
  println("corner: ${bounces()}");
  println("flee-boundary: ${fleesBoundary()}");
  println("safe: ${reachesSafety()}");
  println("hesitate: ${hesitationPersists()}");
  println("missing-target: ${targetDisappears()}");
  if rests() && bounces() && fleesBoundary() && reachesSafety() && hesitationPersists() && targetDisappears()
    then () else exit(1)
}
