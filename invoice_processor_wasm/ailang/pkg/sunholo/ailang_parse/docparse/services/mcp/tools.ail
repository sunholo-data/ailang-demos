    ]))
  ]))
}

pure func mcpFormatEntry(ext: string, name: string, aiRequired: bool, tables: bool, trackChanges: bool, comments: bool, images: bool) -> Json =
  jo([
    kv("extension", js(ext)),
    kv("name", js(name)),
    kv("ai_required", jb(aiRequired)),
    kv("deterministic", jb(not aiRequired)),
    kv("features", jo([
      kv("tables", jb(tables)),
      kv("track_changes", jb(trackChanges)),
      kv("comments", jb(comments)),
      kv("images", jb(images))
    ]))
  ])

pure func mcpSampleEntry(id: string, format: string, description: string, aiRequired: bool) -> Json =
  jo([
    kv("id", js(id)),
    kv("format", js(format)),
    kv("description", js(description)),
    kv("ai_required", jb(aiRequired))
  ])
