-- REPRO 2: std/list sortBy fails under named-test extraction, even with NO
-- sibling modules involved: _str_len (string length) receives a ListValue.
module repro2

import std/list (sortBy, length)

pure func cmpNum(a: int, b: int) -> int = if a < b then -1 else 1

pure func libSortWorks() -> bool = length(sortBy(cmpNum, [3, 1, 2])) == 3
pure func libSortCurried() -> bool = length(sortBy(\a. \b. if a < b then -1 else 1, [3, 1, 2])) == 3

test "stdlib sortBy with named comparator" { libSortWorks() }
test "stdlib sortBy with curried lambda" { libSortCurried() }
