module linkedin/leaderboard_main

-- Daily-snapshot entry point: rebuild leaderboard.json for every
-- scored topic. The cron path calls this once at UTC 00:00.
--
-- Topics without observable signals (compliance/budget/reliable)
-- are no-op'd inside sketchRebuildTopic.
--
-- Argv:
--   1. generatedAt — date string for the snapshot header, default "today"

import std/io (println)
import std/env (getArgs)
import std/string (intToStr)
import std/list (length as listLength, nth)
import std/option (Some, None)
import linkedin/types/sketch_types (AgentReady, Privacy, Portable)
import linkedin/services/sketch_leaderboard (sketchRebuildTopic, sketchRenderTopicsIndex)

func argOr(args: [string], i: int, fallback: string) -> string =
  match nth(args, i) {
    Some(v) => v,
    None    => fallback
  }

export func main() -> () ! {IO, Env, FS} {
  let args = getArgs();
  let generatedAt = argOr(args, 0, "today");

  println("Rebuilding leaderboards (generated ${generatedAt}) ...");
  println("");

  -- Three scored topics.
  let nAgent     = sketchRebuildTopic(AgentReady, generatedAt);
  let nPrivacy   = sketchRebuildTopic(Privacy,    generatedAt);
  let nPortable  = sketchRebuildTopic(Portable,   generatedAt);

  let total = nAgent + nPrivacy + nPortable;

  -- Top-level /linkedin/topics/ gallery — fixes the 404 + serves as
  -- the landing page back-link target.
  sketchRenderTopicsIndex();
  println("✓ /linkedin/topics/ index page regenerated");

  println("");
  println("Done — ${intToStr(total)} entries across the three scored topics.")
}
