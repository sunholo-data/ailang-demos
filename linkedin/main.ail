-- LinkedIn Marketing CLI
--
-- Publish marketing content to LinkedIn company page and read comments.
-- Comments are read-only — forwarded to AILANG Cloud for website content.
--
-- Usage:
--   ailang-linkedin list                     List all posts with status
--   ailang-linkedin post 01-vision           Publish a post
--   ailang-linkedin post --dry-run 01-vision Preview without posting
--   ailang-linkedin comments                 Fetch comments from all published posts
--   ailang-linkedin comments --json          JSON output for AILANG Cloud
--   ailang-linkedin comments 01-vision       Comments on specific post
--   ailang-linkedin status                   Auth status + summary
--   ailang-linkedin setup                    Show setup instructions
--
-- CAPABILITY BUDGETS:
--   IO @limit=200  - Console output
--   FS @limit=80   - Load posts + state
--   Net @limit=30  - Auth + API calls
--   Env            - Read env vars

module linkedin/main

-- Transitive imports (AILANG requirement: entry module must import all)
import std/io (println, print)
import std/env (getEnvOr, getArgs)
import std/fs (readFile, writeFile, fileExists, listDir)
import std/net (httpRequest)
import std/json (encode, decode, getString, getArray, getObject,
                 jo, kv, js, ja)
import std/option (Some, None, getOrElse, isSome)
import std/result (Ok, Err)
import std/string (length, substring, find, split, join, trim, contains, startsWith)
import std/list (length as listLength, map, filter, foldl, nth)

import linkedin/types/linkedin_types (
  LinkedInCreds, MarketingPost, PostResult, LinkedInComment, PostState
)
import linkedin/services/linkedin_auth (
  linkedinGetToken, linkedinGetOrgUrn, linkedinReadCreds
)
import linkedin/services/linkedin_posts (
  linkedinCreatePost, linkedinSaveState, linkedinLoadState, linkedinIsPublished
)
import linkedin/services/linkedin_comments (
  linkedinGetComments, linkedinGetAllComments, linkedinCommentsToJson,
  linkedinDerivePersona
)
import linkedin/services/linkedin_content_loader (
  linkedinLoadPost, linkedinLoadAllPosts
)

export func main() -> () ! {IO @limit=200, FS @limit=150, Net @limit=30, Env} {
  let args = getArgs();
  match args {
    [] => linkedinShowUsage(),
    cmd :: rest => linkedinDispatch(cmd, rest)
  }
}

func linkedinShowUsage() -> () ! {IO} {
  println("LinkedIn Marketing CLI — AILANG Demo");
  println("");
  println("Usage:");
  println("  ailang-linkedin list                     List all posts with status");
  println("  ailang-linkedin post <slug>              Publish a post");
  println("  ailang-linkedin post --dry-run <slug>    Preview without posting");
  println("  ailang-linkedin comments                 Fetch all comments");
  println("  ailang-linkedin comments --json          JSON output for AILANG Cloud");
  println("  ailang-linkedin comments <slug>          Comments on specific post");
  println("  ailang-linkedin status                   Auth status + summary");
  println("  ailang-linkedin setup                    Show setup instructions");
  println("");
  println("Examples:");
  println("  ailang-linkedin list");
  println("  ailang-linkedin post --dry-run 01-vision");
  println("  ailang-linkedin post 01-vision");
  println("  ailang-linkedin comments --json | ailang messages send")
}

func linkedinDispatch(cmd: string, rest: [string]) -> () ! {IO, FS, Net, Env} {
  if cmd == "list" then linkedinCmdList()
  else if cmd == "post" then linkedinCmdPost(rest)
  else if cmd == "comments" then linkedinCmdComments(rest)
  else if cmd == "status" then linkedinCmdStatus()
  else if cmd == "setup" then linkedinCmdSetup()
  else {
    println("Unknown command: ${cmd}");
    linkedinShowUsage()
  }
}

-- === list command ===

func linkedinCmdList() -> () ! {IO, FS} {
  println("=== LinkedIn Content Plan ===");
  println("");
  let posts = linkedinLoadAllPosts();
  let total = listLength(posts);
  println("Found ${total} posts with content:");
  println("");
  linkedinPrintPostList(posts)
}

func linkedinPrintPostList(posts: [MarketingPost]) -> () ! {IO, FS} =
  match posts {
    [] => {
      println("");
      println("Run: ailang-linkedin post --dry-run <slug>  to preview")
    },
    post :: rest => {
      let published = linkedinIsPublished(post.slug);
      let status = if published then "[PUBLISHED]" else "[DRAFT]    ";
      println("  ${status} ${post.slug} — ${post.title}");
      linkedinPrintPostList(rest)
    }
  }

-- === post command ===

func linkedinCmdPost(args: [string]) -> () ! {IO, FS, Net, Env} {
  match args {
    [] => println("Usage: ailang-linkedin post [--dry-run] <slug>"),
    flag :: rest => {
      if flag == "--dry-run" then linkedinDryRun(rest)
      else linkedinPublishPost(flag)
    }
  }
}

func linkedinDryRun(args: [string]) -> () ! {IO, FS} {
  match args {
    [] => println("Usage: ailang-linkedin post --dry-run <slug>"),
    slug :: _ => {
      match linkedinLoadPost(slug) {
        Ok(post) => {
          println("=== DRY RUN: ${post.slug} ===");
          println("");
          println("Title: ${post.title}");
          println("Link:  ${post.link}");
          println("");
          println("--- Post Body ---");
          println(post.body);
          println("--- End ---");
          println("");
          println("Characters: ${length(post.body)}");
          let ok = length(post.body) <= 3000;
          if ok then println("Length: OK (under 3000 char limit)")
          else println("WARNING: Post exceeds 3000 char LinkedIn limit!")
        },
        Err(e) => println("Error: ${e}")
      }
    }
  }
}

func linkedinPublishPost(slug: string) -> () ! {IO, FS, Net, Env} {
  match linkedinLoadPost(slug) {
    Ok(post) => {
      let alreadyPublished = linkedinIsPublished(slug);
      if alreadyPublished then {
        println("Post ${slug} is already published.");
        println("Use the LinkedIn web UI to edit or delete it.")
      }
      else linkedinDoPublish(post)
    },
    Err(e) => println("Error loading post: ${e}")
  }
}

func linkedinDoPublish(post: MarketingPost) -> () ! {IO, FS, Net, Env} {
  println("Publishing: ${post.slug} — ${post.title}");
  match linkedinGetToken() {
    Ok(token) => {
      match linkedinGetOrgUrn() {
        Ok(orgUrn) => {
          println("Auth: OK | Org: ${orgUrn}");
          match linkedinCreatePost(token, orgUrn, post.body) {
            Ok(result) => {
              println("Published! URN: ${result.postUrn}");
              linkedinSaveState(post.slug, result.postUrn, "now");
              println("");
              println("→ Commit and push so the hourly comments cron picks it up:");
              println("    git add linkedin/data/state.json");
              println("    git commit -m 'linkedin: publish ${post.slug}'");
              println("    git push")
            },
            Err(e) => println("Error publishing: ${e}")
          }
        },
        Err(e) => println("Error: ${e}")
      }
    },
    Err(e) => println("Auth error: ${e}")
  }
}

-- === comments command ===

func linkedinCmdComments(args: [string]) -> () ! {IO, FS, Net, Env} {
  let jsonMode = linkedinHasFlag("--json", args);
  let filteredArgs = filter(\a. a == "--json" == false, args);
  match filteredArgs {
    [] => linkedinFetchAllComments(jsonMode),
    slug :: _ => linkedinFetchPostComments(slug, jsonMode)
  }
}

func linkedinHasFlag(flag: string, args: [string]) -> bool =
  match args {
    [] => false,
    a :: rest => if a == flag then true else linkedinHasFlag(flag, rest)
  }

func linkedinFetchAllComments(jsonMode: bool) -> () ! {IO, FS, Net, Env} {
  let states = linkedinLoadState();
  if listLength(states) == 0 then {
    -- --json must always emit valid JSON, even when there are no posts.
    -- Human mode keeps the helpful hint.
    if jsonMode then println("[]")
    else println("No published posts found. Publish posts first with: ailang-linkedin post <slug>")
  }
  else {
    match linkedinGetToken() {
      Ok(token) => {
        let comments = linkedinGetAllComments(token, states);
        if jsonMode then {
          -- The website consumes the richer "feed" shape: an array of posts,
          -- each with its own metadata (slug, title, body, linkedinUrl, ...)
          -- and a nested comments[] array. This lets the page render the
          -- whole conversation without hard-coding any post.
          println(linkedinBuildFeedJson(states, comments))
        } else {
          linkedinOutputComments(comments, false)
        }
      },
      Err(e) => {
        if jsonMode then println("[]")
        else println("Auth error: ${e}")
      }
    }
  }
}

-- ── Feed JSON builder ──────────────────────────────────────────────
-- Bundles every published post (title + body + LinkedIn URL) with its
-- comments, ready for the website to render as a thread feed.
func linkedinBuildFeedJson(states: [PostState], allComments: [LinkedInComment]) -> string ! {FS} {
  let entries = map(\s. linkedinBuildPostEntry(s, allComments), states);
  encode(ja(entries))
}

func linkedinBuildPostEntry(state: PostState, allComments: [LinkedInComment]) -> Json ! {FS} {
  -- Look up the post's content. If the markdown is missing (e.g. someone
  -- deleted it but the state still references the URN), fall back to the
  -- slug as a placeholder title — the page will still render the comments.
  let loaded = linkedinLoadPost(state.slug);
  let postTitle = match loaded {
    Ok(p) => p.title,
    Err(_) => state.slug
  };
  let postBody = match loaded {
    Ok(p) => p.body,
    Err(_) => ""
  };

  -- Group: keep only comments whose parentPostUrn matches this post.
  let mineRaw = filter(\c. c.parentPostUrn == state.postUrn, allComments);
  let mine = map(\c. {
    let p = linkedinDerivePersona(c.authorName);
    jo([
      kv("text", js(c.text)),
      kv("createdAt", js(c.createdAt)),
      kv("initials", js(p.initials)),
      kv("avatarSeed", js(p.avatarSeed))
    ])
  }, mineRaw);

  jo([
    kv("slug", js(state.slug)),
    kv("urn", js(state.postUrn)),
    kv("title", js(postTitle)),
    kv("publishedAt", js(state.publishedAt)),
    kv("linkedinUrl", js("https://www.linkedin.com/feed/update/${state.postUrn}/")),
    kv("body", js(postBody)),
    kv("comments", ja(mine))
  ])
}

func linkedinFetchPostComments(slug: string, jsonMode: bool) -> () ! {IO, FS, Net, Env} {
  let states = linkedinLoadState();
  let postUrn = linkedinFindUrnForSlug(slug, states);
  if length(postUrn) == 0 then {
    if jsonMode then println("[]")
    else println("Post ${slug} is not published yet.")
  }
  else {
    match linkedinGetToken() {
      Ok(token) => {
        match linkedinGetComments(token, postUrn) {
          Ok(comments) => linkedinOutputComments(comments, jsonMode),
          Err(e) => {
            if jsonMode then println("[]")
            else println("Error: ${e}")
          }
        }
      },
      Err(e) => {
        if jsonMode then println("[]")
        else println("Auth error: ${e}")
      }
    }
  }
}

func linkedinFindUrnForSlug(slug: string, states: [PostState]) -> string =
  match states {
    [] => "",
    s :: rest => if s.slug == slug then s.postUrn else linkedinFindUrnForSlug(slug, rest)
  }

func linkedinOutputComments(comments: [LinkedInComment], jsonMode: bool) -> () ! {IO} {
  if jsonMode then println(linkedinCommentsToJson(comments))
  else {
    let count = listLength(comments);
    println("Found ${count} comments:");
    println("");
    linkedinPrintComments(comments)
  }
}

func linkedinPrintComments(comments: [LinkedInComment]) -> () ! {IO} =
  match comments {
    [] => println(""),
    c :: rest => {
      println("  [${c.authorName}] ${c.text}");
      println("  Post: ${c.parentPostUrn} | ${c.createdAt}");
      println("");
      linkedinPrintComments(rest)
    }
  }

-- === status command ===

func linkedinCmdStatus() -> () ! {IO, FS, Net, Env} {
  println("=== LinkedIn Status ===");
  println("");

  -- Check auth
  match linkedinGetToken() {
    Ok(token) => {
      println("Auth:     OK (token available)");
      match linkedinGetOrgUrn() {
        Ok(urn) => println("Org URN:  ${urn}"),
        Err(e) => println("Org URN:  ${e}")
      }
    },
    Err(e) => println("Auth:     FAILED — ${e}")
  };

  -- Check content
  let posts = linkedinLoadAllPosts();
  println("Posts:    ${listLength(posts)} with content");

  -- Check published
  let states = linkedinLoadState();
  println("Published: ${listLength(states)}");
  println("")
}

-- === setup command ===

func linkedinCmdSetup() -> () ! {IO} {
  println("=== LinkedIn Developer App Setup ===");
  println("");
  println("1. Go to https://developer.linkedin.com/");
  println("   Create an app and associate it with your company page.");
  println("");
  println("2. Under Products, request:");
  println("   - Share on LinkedIn");
  println("   - Sign In with LinkedIn using OpenID Connect");
  println("");
  println("3. Note your client_id and client_secret from Settings > Auth.");
  println("");
  println("4. Get your organization URN:");
  println("   Visit https://www.linkedin.com/company/YOUR_COMPANY/admin/");
  println("   The org ID is in the URL. URN format: urn:li:organization:12345");
  println("");
  println("5. Complete the OAuth flow (one-time, in browser):");
  println("   Open this URL in your browser (replace CLIENT_ID):");
  println("");
  println("   https://www.linkedin.com/oauth/v2/authorization?response_type=code&client_id=CLIENT_ID&redirect_uri=http://localhost:8080/callback&scope=w_organization_social%20r_organization_social%20openid&state=ailang");
  println("");
  println("6. After approving, exchange the code for tokens:");
  println("   curl -X POST https://www.linkedin.com/oauth/v2/accessToken \\");
  println("     -d 'grant_type=authorization_code' \\");
  println("     -d 'code=AUTH_CODE' \\");
  println("     -d 'client_id=CLIENT_ID' \\");
  println("     -d 'client_secret=CLIENT_SECRET' \\");
  println("     -d 'redirect_uri=http://localhost:8080/callback'");
  println("");
  println("7. Save credentials to ~/.ailang/linkedin/credentials.json:");
  println("   {");
  println("     \"access_token\": \"...\",");
  println("     \"refresh_token\": \"...\",");
  println("     \"client_id\": \"...\",");
  println("     \"client_secret\": \"...\",");
  println("     \"org_urn\": \"urn:li:organization:YOUR_ORG_ID\"");
  println("   }");
  println("");
  println("8. Test: ailang-linkedin status");
  println("");
  println("Token lifetime: ~60 days. The CLI auto-refreshes using refresh_token.")
}
