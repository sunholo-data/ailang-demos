module linkedin/tests/test_rubric

-- Rubric tests. Inline tests don't work on functions that call
-- imported stdlib (known harness bug — see CLAUDE.md), so this
-- is a runnable main() that exercises every scorer + the aggregator
-- and prints PASS / FAIL. Run with:
--
--   ailang run --entry main linkedin/tests/test_rubric.ail

import std/io (println)
import std/string (intToStr)
import std/list (length as listLength)
import linkedin/types/sketch_types (Signal, TopicScore, AgentReady, Privacy, Portable)
import linkedin/services/sketch_rubric (scoreAgentJson, scoreOpenApi, scoreMcpEndpoint, scoreApiDocsLink, scoreWebhooks, scoreRateLimitDocs, scoreStreamingEndpoint, scoreSandboxOffered, scoreAuthDocumented, scoreIdempotency, scoreAgUi, scoreX402, scoreAP2, scoreUTCP, scoreE2EE, scoreComplianceCerts, scoreDataMinimisation, scoreThirdPartyDomains, scoreDataResidencyLanguage, scoreSingleVendorLlm, scoreMultiProviderMentioned, scoreCrossRuntimeClaim, scoreByoKey, sketchScoreAllSignals, sketchComputeTopicScore, topicHasLeaderboard, topicEq)

func checkBool(name: string, got: bool, want: bool) -> int ! {IO} {
  if got == want then {
    println("  ✓ ${name}");
    1
  } else {
    let g = if got  then "true" else "false";
    let w = if want then "true" else "false";
    println("  ✗ ${name} — got ${g}, want ${w}");
    0
  }
}

func checkInt(name: string, got: int, want: int) -> int ! {IO} {
  if got == want then {
    println("  ✓ ${name}");
    1
  } else {
    println("  ✗ ${name} — got ${intToStr(got)}, want ${intToStr(want)}");
    0
  }
}

func checkRange(name: string, got: int, lo: int, hi: int) -> int ! {IO} {
  if got >= lo && got <= hi then {
    println("  ✓ ${name} (${intToStr(got)} in [${intToStr(lo)},${intToStr(hi)}])");
    1
  } else {
    println("  ✗ ${name} — got ${intToStr(got)}, expected in [${intToStr(lo)},${intToStr(hi)}]");
    0
  }
}

export func main() -> () ! {IO} {
  println("sketch rubric — tests");
  println("");

  -- agent.json
  println("scoreAgentJson:");
  let aj1 = scoreAgentJson("<link rel=\"agent\" href=\"/.well-known/agent.json\">");
  let t1 = checkBool("detects agent.json reference",  aj1.detected, true) +
           checkInt("awards 1pt when detected (moonshot weight)", aj1.points, 1);
  let aj2 = scoreAgentJson("<html>no agent here</html>");
  let t2 = checkBool("no detection on plain page",     aj2.detected, false) +
           checkInt("awards 0 when not detected",      aj2.points, 0);

  -- openapi
  println("");
  println("scoreOpenApi:");
  let op1 = scoreOpenApi("Powered by Swagger. See /openapi.json");
  let t3 = checkBool("detects openapi.json + swagger", op1.detected, true) +
           checkInt("max points when detected",        op1.points, 2);
  let op2 = scoreOpenApi("Just a landing page");
  let t4 = checkBool("no detection on plain page",     op2.detected, false);

  -- MCP endpoint
  println("");
  println("scoreMcpEndpoint:");
  let mcp1 = scoreMcpEndpoint("Model Context Protocol available at /mcp/sse");
  let t5 = checkBool("detects MCP", mcp1.detected, true) +
           checkInt("max points when detected", mcp1.points, 2);

  -- new privacy signals (E2EE, compliance certs, data minimisation)
  println("");
  println("scoreE2EE:");
  let e2e1 = scoreE2EE("We use end-to-end encryption for all messages.");
  let t6 = checkBool("detects E2EE language",          e2e1.detected, true) +
           checkInt("max points when detected",        e2e1.points, 2);
  let e2e2 = scoreE2EE("A plain marketing page.");
  let t7 = checkInt("not detected = 0 points",         e2e2.points, 0);

  println("");
  println("scoreComplianceCerts:");
  let cc1 = scoreComplianceCerts("SOC 2 Type II and GDPR-compliant.");
  let tCc = checkBool("detects compliance certs",      cc1.detected, true) +
            checkInt("max points when detected",       cc1.points, 2);

  println("");
  println("scoreDataMinimisation:");
  let dm1 = scoreDataMinimisation("We do not sell your data. Privacy-first.");
  let tDm = checkBool("detects data-min language",     dm1.detected, true) +
            checkInt("max points when detected",       dm1.points, 2);

  -- single-vendor LLM (penalty — detected = 0 points)
  println("");
  println("scoreSingleVendorLlm:");
  let sv1 = scoreSingleVendorLlm("Powered by Claude — the world's best AI");
  let t8 = checkBool("detects single-vendor lock",     sv1.detected, true) +
           checkInt("detected = 0 points (penalty)",   sv1.points, 0);
  let sv2 = scoreSingleVendorLlm("Multi-LLM platform");
  let t9 = checkInt("not detected = full points",      sv2.points, 2);

  -- data residency
  println("");
  println("scoreDataResidencyLanguage:");
  let dr1 = scoreDataResidencyLanguage("EU-hosted. Data residency guaranteed.");
  let t10 = checkBool("detects residency language",    dr1.detected, true);

  -- third-party domains
  println("");
  println("scoreThirdPartyDomains:");
  let tp1 = scoreThirdPartyDomains("<html>https://example.com</html>");
  let t11 = checkRange("low https count = max points", tp1.points, 2, 2);

  -- new agent-ready signals
  println("");
  println("scoreWebhooks:");
  let wh1 = scoreWebhooks("See our webhooks at /webhooks/orders");
  let tWh = checkBool("detects webhook reference",     wh1.detected, true) +
            checkInt("max points when detected",       wh1.points, 2);
  let wh2 = scoreWebhooks("plain landing page");
  let tWh2 = checkInt("not detected = 0 points",       wh2.points, 0);

  println("");
  println("scoreRateLimitDocs:");
  let rl1 = scoreRateLimitDocs("Our API enforces a rate limit of 100 req/min (429 on exceed)");
  let tRl = checkBool("detects rate-limit language",   rl1.detected, true) +
            checkInt("max points when detected",       rl1.points, 2);

  println("");
  println("scoreStreamingEndpoint:");
  let st1 = scoreStreamingEndpoint("Stream chunks via text/event-stream over /sse");
  let tSt = checkBool("detects SSE language",          st1.detected, true) +
            checkInt("max points when detected",       st1.points, 2);

  println("");
  println("scoreSandboxOffered:");
  let sb1 = scoreSandboxOffered("Try the API in our sandbox before going live.");
  let tSb = checkBool("detects sandbox language",      sb1.detected, true) +
            checkInt("max points when detected",       sb1.points, 2);

  println("");
  println("scoreAuthDocumented:");
  let au1 = scoreAuthDocumented("Use OAuth2 with a bearer token or an API key for client credentials.");
  let tAu = checkBool("detects auth language",         au1.detected, true) +
            checkInt("max points when detected",       au1.points, 2);

  println("");
  println("scoreIdempotency:");
  let id1 = scoreIdempotency("Send an Idempotency-Key header to retry safely.");
  let tId = checkBool("detects idempotency language",  id1.detected, true) +
            checkInt("max points when detected",       id1.points, 2);

  -- 2026 emerging protocols (1pt moonshot each)
  println("");
  println("scoreAgUi:");
  let ag1 = scoreAgUi("We stream agent events via AG-UI protocol.");
  let tAg = checkBool("detects AG-UI language",        ag1.detected, true) +
            checkInt("moonshot weight (1pt)",          ag1.points, 1);

  println("");
  println("scoreX402:");
  let x4 = scoreX402("Pay-per-call APIs gated by x402 protocol.");
  let tX4 = checkBool("detects x402 language",         x4.detected, true) +
            checkInt("moonshot weight (1pt)",          x4.points, 1);

  println("");
  println("scoreAP2:");
  let ap = scoreAP2("Sign an intent mandate to authorise the agent.");
  let tAp = checkBool("detects AP2 mandate language",  ap.detected, true) +
            checkInt("moonshot weight (1pt)",          ap.points, 1);

  println("");
  println("scoreUTCP:");
  let ut = scoreUTCP("Tools described in a UTCPManual, MCP alternative.");
  let tUt = checkBool("detects UTCP language",         ut.detected, true) +
            checkInt("moonshot weight (1pt)",          ut.points, 1);

  -- new portable signals
  println("");
  println("scoreMultiProviderMentioned:");
  let mp1 = scoreMultiProviderMentioned("We support Claude, GPT, and Gemini for inference");
  let tMp = checkBool("detects multi-provider site",   mp1.detected, true) +
            checkInt("max points when detected",       mp1.points, 2);
  let mp2 = scoreMultiProviderMentioned("Just powered by Claude");
  let tMp2 = checkBool("single provider != detected",  mp2.detected, false);

  println("");
  println("scoreCrossRuntimeClaim:");
  let cr1 = scoreCrossRuntimeClaim("Self-hosted via Docker — runs anywhere");
  let tCr = checkBool("detects cross-runtime claim",   cr1.detected, true) +
            checkInt("max points when detected",       cr1.points, 2);

  println("");
  println("scoreByoKey:");
  let bk1 = scoreByoKey("Bring your own key — model-agnostic platform");
  let tBk = checkBool("detects BYOK language",         bk1.detected, true) +
            checkInt("max points when detected",       bk1.points, 2);

  -- contract bounds (every scorer respects 0..maxPoints)
  println("");
  println("contract bounds — all scorers respect 0..maxPoints:");
  let all = sketchScoreAllSignals("Some HTML with /mcp/ and openapi.json and Claude");
  let bcheck = checkInt("scoreAllSignals returns 23 signals", listLength(all), 23);

  -- aggregator clamps to 0..10
  println("");
  println("aggregator clamping:");
  let scoreAR = sketchComputeTopicScore(all, AgentReady);
  let t12 = checkRange("AgentReady readiness in [0,10]", scoreAR.readiness, 0, 10) +
            checkBool("AgentReady has leaderboard",      scoreAR.hasLeaderboard, true) +
            checkBool("opportunity = 10 - readiness",    scoreAR.opportunity == (10 - scoreAR.readiness), true);

  -- topicHasLeaderboard
  println("");
  println("topicHasLeaderboard:");
  let t13 = checkBool("AgentReady = true", topicHasLeaderboard(AgentReady), true) +
            checkBool("Privacy    = true", topicHasLeaderboard(Privacy), true) +
            checkBool("Portable   = true", topicHasLeaderboard(Portable), true);

  -- topicEq
  println("");
  println("topicEq:");
  let t14 = checkBool("AgentReady == AgentReady", topicEq(AgentReady, AgentReady), true) +
            checkBool("AgentReady != Privacy",    topicEq(AgentReady, Privacy), false);

  let total = t1 + t2 + t3 + t4 + t5 + t6 + t7 + tCc + tDm + t8 + t9 + t10 + t11
            + tWh + tWh2 + tRl + tSt + tSb + tAu + tId
            + tAg + tX4 + tAp + tUt
            + tMp + tMp2 + tCr + tBk
            + bcheck + t12 + t13 + t14;
  let expected = 58;
  println("");
  if total == expected then
    println("OK: ${intToStr(total)}/${intToStr(expected)} assertions passed")
  else
    println("FAIL: ${intToStr(total)}/${intToStr(expected)} assertions passed")
}
