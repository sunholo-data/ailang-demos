module linkedin/services/sketch_leaderboard

-- Per-topic leaderboard aggregation.
--
-- 1. List directories under site/linkedin/topics/<topic>/
-- 2. For each, read sketch.json
-- 3. Sort descending by topicReadiness
-- 4. Assign rank 1..10 to the top 10; rank 0 (= "in the gallery,
--    unranked publicly") to everyone else — anti-shame design.
-- 5. Write site/linkedin/topics/<topic>/leaderboard.json
--
-- The cron-driven snapshot calls this once per scored topic
-- (agent-ready, privacy, portable) once per day at UTC 00:00.
-- Topics without leaderboards (compliance, budget, reliable) are
-- skipped — they have no honest signal-based ranking.

import std/io (println)
import std/fs (listDir, isDir, fileExists, readFile, writeFile, mkdirAll)
import std/string (length, intToStr, replace, join, replaceMany, substring)
import std/list (length as listLength, map, filter, sortBy, concat as listConcat)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/json (decode, getString, getInt)
import linkedin/types/sketch_types (LeaderboardEntry, Topic, Compliance, Budget, Privacy, Reliable, Portable, AgentReady, General)
import linkedin/services/sketch_rubric (topicHasLeaderboard)
import linkedin/services/sketch_template (topicSlug, topicCamelCase)

-- ─── Constants ────────────────────────────────────────────────

export func sketchTopicsDir() -> string = "site/linkedin/topics"

export func sketchTopicDir(t: Topic) -> string =
  "${sketchTopicsDir()}/${topicSlug(t)}"

export func sketchLeaderboardPath(t: Topic) -> string =
  "${sketchTopicDir(t)}/leaderboard.json"

-- Top-N to publicly rank. The rest sit in the gallery without a rank.
export func sketchPublicRankCap() -> int = 10

-- ─── Reading sketch.json files ───────────────────────────────

-- Build a LeaderboardEntry from a single sketch directory.
-- Returns None if the dir has no sketch.json or it's malformed.
func readSketchEntry(t: Topic, subdir: string) -> Option[LeaderboardEntry] ! {FS} {
  let metaPath = "${sketchTopicDir(t)}/${subdir}/sketch.json";
  if fileExists(metaPath) then {
    let raw = readFile(metaPath);
    match decode(raw) {
      Ok(j) => {
        let domain = getOrElse(getString(j, "registrableDomain"), "");
        let initials = getOrElse(getString(j, "initials"), "");
        let seed = getOrElse(getString(j, "avatarSeed"), "");
        let score = getOrElse(getInt(j, "topicReadiness"), 0);
        let updated = getOrElse(getString(j, "generatedAt"), "");
        if length(domain) > 0 then
          Some({
            rank:              0,
            registrableDomain: domain,
            initials:          initials,
            avatarSeed:        seed,
            score:             score,
            -- Relative to the topic-index page (linkedin/topics/<topic>/).
            -- This way the same path works at /, /ailang-demos/, or any prefix.
            sketchUrl:         "${subdir}/",
            updatedAt:         updated
          })
        else None
      },
      Err(_) => None
    }
  } else None
}

-- Flatten a list of Options, keeping only the Somes.
func flattenSomes(xs: [Option[LeaderboardEntry]]) -> [LeaderboardEntry] = match xs {
  []                 => [],
  [Some(v), ...rest] => listConcat([v], flattenSomes(rest)),
  [None,    ...rest] => flattenSomes(rest)
}

-- List every sketch entry for a topic (unranked, unsorted).
export func sketchListEntries(t: Topic) -> [LeaderboardEntry] ! {FS} {
  let dir = sketchTopicDir(t);
  if isDir(dir) then {
    let subdirs = listDir(dir);
    let entries = map(\sd. readSketchEntry(t, sd), subdirs);
    flattenSomes(entries)
  } else []
}

-- ─── Dedup by domain ──────────────────────────────────────────

-- An entry x is "better" than y if it should win when both share a
-- domain. Tiebreaks: newer updatedAt wins; if equal, lower avatarSeed
-- wins (stable + deterministic, so reruns don't flip-flop the table).
func entryBetter(x: LeaderboardEntry, y: LeaderboardEntry) -> bool =
  if x.updatedAt > y.updatedAt then true
  else if x.updatedAt < y.updatedAt then false
  else x.avatarSeed < y.avatarSeed

-- True if no other entry for the same domain dominates this one.
func isBestForDomain(e: LeaderboardEntry, all: [LeaderboardEntry]) -> bool = match all {
  []           => true,
  [x, ...rest] =>
    if x.registrableDomain == e.registrableDomain && entryBetter(x, e)
      then false
      else isBestForDomain(e, rest)
}

-- Keep one entry per registrableDomain — the "best" by (updatedAt, avatarSeed).
-- This is the design-doc-promised "same domain ranked once, latest wins".
func dedupByDomain(entries: [LeaderboardEntry]) -> [LeaderboardEntry] =
  filter(\e. isBestForDomain(e, entries), entries)

-- ─── Sorting + ranking ────────────────────────────────────────

-- Descending by score (higher readiness first).
func cmpEntries(a: LeaderboardEntry, b: LeaderboardEntry) -> int =
  if a.score > b.score then -1
  else if a.score < b.score then 1
  else 0

-- Assign rank 1..10 to top N entries; rank 0 to the rest.
-- Caller must have already sorted descending.
func assignRanks(sorted: [LeaderboardEntry], cap: int) -> [LeaderboardEntry] =
  assignRanksAt(sorted, 1, cap)

func assignRanksAt(xs: [LeaderboardEntry], pos: int, cap: int) -> [LeaderboardEntry] = match xs {
  []           => [],
  [e, ...rest] => listConcat([rankedAt(e, pos, cap)], assignRanksAt(rest, pos + 1, cap))
}

func rankedAt(e: LeaderboardEntry, pos: int, cap: int) -> LeaderboardEntry =
  let r = if pos <= cap then pos else 0 in
  {
    rank:              r,
    registrableDomain: e.registrableDomain,
    initials:          e.initials,
    avatarSeed:        e.avatarSeed,
    score:             e.score,
    sketchUrl:         e.sketchUrl,
    updatedAt:         e.updatedAt
  }

-- ─── JSON encoding ────────────────────────────────────────────

func escapeJsonString(s: string) -> string =
  replace(replace(s, "\\", "\\\\"), "\"", "\\\"")

func entryToJson(e: LeaderboardEntry) -> string =
  "{\"rank\":${intToStr(e.rank)},\"registrableDomain\":\"${escapeJsonString(e.registrableDomain)}\",\"initials\":\"${escapeJsonString(e.initials)}\",\"avatarSeed\":\"${escapeJsonString(e.avatarSeed)}\",\"score\":${intToStr(e.score)},\"sketchUrl\":\"${escapeJsonString(e.sketchUrl)}\",\"updatedAt\":\"${escapeJsonString(e.updatedAt)}\"}"

func entriesToJson(entries: [LeaderboardEntry], topic: Topic, generatedAt: string) -> string =
  let entriesArr = join(",", map(entryToJson, entries)) in
  "{\"topic\":\"${topicSlug(topic)}\",\"generatedAt\":\"${escapeJsonString(generatedAt)}\",\"totalSketches\":${intToStr(listLength(entries))},\"entries\":[${entriesArr}]}"

-- ─── Topic copy bank ──────────────────────────────────────────

-- One-paragraph description shown on the topic landing page.
export func topicDescription(t: Topic) -> string = match t {
  Compliance => "Make your AI defensible. AILANG carries contracts as documented limitations, OpenTelemetry spans as audit trail, and capability declarations as scope of authority — the shape any AI system that needs to pass an Article 13 review has to take, regardless of who runs it.",
  Budget     => "Stop guessing at your AI bill. AILANG puts capability budgets in the function signature (Net @limit=N), maps prompt-cache hints to whatever each provider's native primitive is, and lets you route cheap-tier models to cheap-tier tasks with replayable evidence. A retry storm that exceeds budget is a crash, not a five-figure invoice.",
  Privacy    => "Customer data labelled at the type level. AILANG marks PII at the field declaration; crossing into a public sink without an explicit Declassify boundary is a compiler error. Combined with capability-scoped network calls and three-runtime deploy (browser WASM / Cloud Run / native), sensitive data has nowhere to leak that the type checker can't see.",
  Reliable   => "Agents that can't drop the database even if they decide to. The two operations live in different effect rows; a tool granted only Net @endpoint=\"db.read\" cannot exceed that grant. Contracts proved by Z3 at compile time. Fewer ways to go wrong because the language is narrower.",
  Portable   => "Switch from Anthropic to Gemini to OpenAI to OpenRouter to Ollama with a one-character diff. std/ai maps each feature — tool calling, structured output, prompt caching, streaming reasoning — to whatever native primitive the provider supports. The eval harness scores every model against your tasks, so cheap-or-fast switches are evidence-driven.",
  AgentReady => "When agents start transacting on your behalf — and they will — make your site speak their protocols. ailang serve-api takes typed AILANG functions and exposes them as REST + MCP + A2A + OpenAPI 3.1 in one command. Your catalogue, your pricing engine, your customer-facing API: contract-verified, agent-discoverable, no glue code.",
  General    => "Every topic at a glance. Comment a URL on any AILANG LinkedIn post and we'll generate a sketch — what an AI sees on your site, where the AILANG features would land first, and the leaderboard you'd join."
}

-- A short version for HTML meta-description.
export func topicDescriptionMeta(t: Topic) -> string = match t {
  Compliance => "Sketches scoring AI defensibility — contracts, traces, capability declarations.",
  Budget     => "Sketches scoring AI spend predictability — capability budgets, prompt caching.",
  Privacy    => "Sketches scoring data sovereignty — IFC labels, capability scoping, three-runtime deploy.",
  Reliable   => "Sketches on production-grade agents — capability boundaries, contracts + Z3.",
  Portable   => "Sketches on vendor independence — std/ai multi-provider portability.",
  AgentReady => "Sketches scoring agent-readiness — A2A, OpenAPI, MCP, contract-verified tool calls.",
  General    => "AILANG topic galleries — sketches mapped to AILANG primitives."
}

-- ─── Leaderboard section rendering ────────────────────────────

func avatarSvg(seed: string) -> string =
  "<span class=\"avatar\" style=\"background: conic-gradient(from ${avatarAngleFromSeed(seed)}deg, var(--primary), var(--ai-orange), var(--primary));\"></span>"

-- Deterministic angle 0..359 from a hex seed's first byte.
func avatarAngleFromSeed(seed: string) -> string =
  if length(seed) < 2 then "0"
  else
    let hi = hexNibbleS(charAt(seed, 0)) in
    let lo = hexNibbleS(charAt(seed, 1)) in
    intToStr((((hi * 16) + lo) * 360) / 256)

func charAt(s: string, i: int) -> string = substring(s, i, i + 1)

func hexNibbleS(c: string) -> int =
  if c == "0" then 0
  else if c == "1" then 1 else if c == "2" then 2 else if c == "3" then 3
  else if c == "4" then 4 else if c == "5" then 5 else if c == "6" then 6
  else if c == "7" then 7 else if c == "8" then 8 else if c == "9" then 9
  else if c == "a" || c == "A" then 10
  else if c == "b" || c == "B" then 11
  else if c == "c" || c == "C" then 12
  else if c == "d" || c == "D" then 13
  else if c == "e" || c == "E" then 14
  else if c == "f" || c == "F" then 15
  else 0

func renderEntryRow(e: LeaderboardEntry) -> string =
  let rankStr = if e.rank == 0 then "<span class=\"rank unranked\">—</span>" else "<span class=\"rank\">#${intToStr(e.rank)}</span>" in
  join("", [
    "<div class=\"tx-row\">",
    rankStr,
    avatarSvg(e.avatarSeed),
    "<div class=\"domain\"><span class=\"initials\">", e.initials, "</span>", e.registrableDomain, "</div>",
    "<div class=\"score\">", intToStr(e.score), "/10</div>",
    "<div class=\"col-link\"><a href=\"", e.sketchUrl, "\">view sketch ↗</a></div>",
    "<div class=\"col-updated\">", e.updatedAt, "</div>",
    "</div>"
  ])

func renderLeaderboardSection(t: Topic, entries: [LeaderboardEntry], generatedAt: string) -> string =
  let rowsHtml = join("\n", map(renderEntryRow, entries)) in
  let intro = if listLength(entries) == 0 then
    "<div class=\"tx-empty\"><strong>No sketches yet for this topic.</strong>Comment a URL with <code>#ailang${topicCamelCase(t)}</code> on any AILANG LinkedIn post to be the first.</div>"
  else
    "<div class=\"tx-leaderboard\">${rowsHtml}</div>" in
  join("", [
    "<section class=\"tx-section\">",
    "<h2>Leaderboard</h2>",
    "<p class=\"updated\">refreshed daily · last update ", generatedAt, " · ", intToStr(listLength(entries)), " sketches</p>",
    intro,
    "</section>"
  ])

func renderNoLeaderboardSection(t: Topic) -> string =
  join("", [
    "<section class=\"tx-section\">",
    "<h2>Gallery</h2>",
    "<div class=\"tx-no-leaderboard\">",
    "<strong>This topic doesn't have a leaderboard.</strong> ",
    "We can't honestly score ", topicSlug(t),
    " from a single page fetch — auditability, AI spend, and agent reliability aren't visible on a marketing page. ",
    "Sketches commented under <code>#ailang", topicCamelCase(t), "</code> still get rendered with feature cards and a guarantee panel, but without a rank.",
    "</div>",
    "</section>"
  ])

-- ─── Top-level rebuild ────────────────────────────────────────

-- Rebuild the leaderboard JSON for a single topic. No-op if the
-- topic doesn't carry a leaderboard (compliance/budget/reliable).
-- Returns the number of entries that landed in the leaderboard.
export func sketchRebuildTopic(t: Topic, generatedAt: string) -> int ! {FS, IO} {
  if topicHasLeaderboard(t) then {
    let entries = sketchListEntries(t);
    let deduped = dedupByDomain(entries);
    let sorted = sortBy(cmpEntries, deduped);
    let ranked = assignRanks(sorted, sketchPublicRankCap());
    let json = entriesToJson(ranked, t, generatedAt);
    let path = sketchLeaderboardPath(t);
    mkdirAll(sketchTopicDir(t));
    writeFile(path, json);
    -- Also render the topic index page from the ranked entries.
    sketchRenderTopicPage(t, ranked, generatedAt);
    let n = listLength(ranked);
    println("✓ ${topicSlug(t)}: ranked ${intToStr(n)} entries → ${path}");
    n
  } else {
    -- No leaderboard, but still render a topic index page so the URL exists.
    sketchRenderTopicPage(t, [], generatedAt);
    println("- ${topicSlug(t)}: no leaderboard (no observable signals)");
    0
  }
}

-- Render the topic landing page at site/linkedin/topics/<topic>/index.html.
export func sketchRenderTopicPage(t: Topic, entries: [LeaderboardEntry], generatedAt: string) -> () ! {FS} {
  let template = readFile("linkedin/templates/topic_index.html");
  let section = if topicHasLeaderboard(t)
                then renderLeaderboardSection(t, entries, generatedAt)
                else renderNoLeaderboardSection(t);
  let html = replaceMany(template, [
    ("{{TOPIC_LABEL}}",              topicSlug(t)),
    ("{{TOPIC_SLUG}}",               topicSlug(t)),
    ("{{TOPIC_CAMEL}}",              topicCamelCase(t)),
    ("{{TOPIC_DESCRIPTION}}",        topicDescription(t)),
    ("{{TOPIC_DESCRIPTION_META}}",   topicDescriptionMeta(t)),
    ("{{LEADERBOARD_SECTION_HTML}}", section)
  ]);
  mkdirAll(sketchTopicDir(t));
  writeFile("${sketchTopicDir(t)}/index.html", html);
  ()
}
