  protoRow(
    "08", "X402", "x402 HTTP-native payments",
    "HTTP 402 Payment Required revival — agents pay APIs via signed crypto payment payloads. $600M+ annualised volume on Base/Solana.",
    "PAYMENT-REQUIRED · PAYMENT-SIGNATURE",
    "Body mentions <code>x402</code>, <code>x402.org</code>, or \"payment-required header\".",
    1,
    "<code>Net @endpoint</code>-scoped capability budgets bound where the payment payload can flow; <code>requires { amount &lt;= budget }</code> gates the signature; IFC labels keep the signing key tainted away from public sinks. Strong AILANG mapping; high volume on crypto rails today.",
    "https://docs.cdp.coinbase.com/x402/welcome",
    "x402 docs ↗"
  ),

  protoRow(
    "09", "AP2", "AP2 Agent Payments Protocol",
    "Google + Mastercard + 60 orgs — cryptographically signed Mandates (Intent + Cart) authorise agents to spend with price/timing/condition bounds.",
    "intent mandate · cart mandate",
    "Body mentions <code>ap2-protocol</code>, \"agent payments protocol\", \"intent mandate\", \"cart mandate\", or \"payment mandate\".",
    1,
    "Mandates <em>are</em> contracts. <code>requires { intent.price &lt;= mandate.maxPrice }</code> + <code>ensures { cart.total &lt;= intent.price }</code> is a one-to-one translation of AP2's Mandate semantics into AILANG. Z3 verifies the bounds at compile time, not at settlement.",
    "https://ap2-protocol.org/specification/",
    "AP2 spec ↗"
  ),

  protoRow(
    "10", "UTCP", "UTCP universal tool calling",
    "MCP alternative. Tools described in a JSON UTCPManual and called via their native protocols (HTTP, gRPC, CLI) — no proxy server.",
    "UTCPManual.json",
    "Body mentions <code>utcp</code>, \"universal tool calling protocol\", or <code>utcpmanual</code>.",
    1,
    "AILANG function signatures + <code>ailang serve-api</code> emit metadata equivalent to a UTCPManual — name, input/output schema, native endpoint — so consumers can discover and call directly without a proxy in between. Positioned vs MCP; adoption thinner today.",
    "https://www.utcp.io/",
    "UTCP spec ↗"
  ),

  "</div>",
  "</section>"
])

-- ─── Portable catalog (Portable topic only) ─────────────────

func renderPortablePrimitivesSection(t: Topic) -> string =
  match t {
    Portable => portableCatalogHtml(),
    _        => ""
  }

func portableCatalogHtml() -> string = join("", [
  "<section class=\"tx-section tx-catalog\">",
  "<h2>Portability is a language feature</h2>",
  "<p class=\"lede\">Two axes: which AI provider your code talks to, and which runtime it executes in. Each row is the AILANG primitive that decouples one of those — paired with the rubric signal that detects it where there is one.</p>",
  "<div class=\"tx-proto-list\">",

  protoRow(
    "01", "AI5", "std/ai multi-provider Step API",
    "One typed Step API across Anthropic, OpenAI, Gemini, OpenRouter, Ollama.",
    "std/ai → 5 providers",
    "Detected when the body names two or more of: claude, anthropic, gpt, openai, gemini, mistral, llama, ollama, openrouter — you're already vendor-multi. A separate penalty signal docks 2 pts if exactly one is named with no portability claim.",
    4,
    "Switch from Claude to GPT to Gemini to a local Ollama model with a single <code>--ai</code> flag — no SDK swap, no rewrite. Tool calling, structured output, and streaming all normalise to the same typed shape.",
    "https://ailang.sunholo.com/docs/guides/ai-effect",
    "AI effect guide ↗"
  ),

  protoRowNoRubric(
    "02", "OR", "OpenRouter routing",
    "Target ~100 frontier models behind one HTTP shape.",
    "vendor/model strings",
    "Target <code>&lt;vendor&gt;/&lt;model&gt;</code> directly — <code>anthropic/claude-sonnet-4.5</code>, <code>google/gemini-2.5-flash</code>, <code>meta-llama/llama-3.3-70b-instruct</code>. Cost routing, fallback, and rate-limit handling are uniform across the catalogue.",
    "https://ailang.sunholo.com/docs/guides/ai-routing",
    "AI routing ↗"
  ),

  protoRowNoRubric(
    "03", "PKG", "Custom AI providers as packages",
    "Adding a vendor is a config block, not a binary fork.",
    "[[ai_provider]] in ailang.toml",
    "A regional cloud, a private model gateway, or a research lab's API becomes a first-class provider with one TOML block plus a <code>.ail</code> adapter. Budget tracking, AI capability gating, and trace integration come for free.",
    "https://ailang.sunholo.com/docs/guides/custom-ai-providers",
    "Custom AI providers ↗"
  ),

  protoRow(
    "04", "WASM", "AILANG in the browser",
    "The full AILANG runtime compiles to WebAssembly. Same .ail in a browser tab, no backend.",
    "ailang.wasm",
    "Body mentions \"bring your own key\", \"BYOK\", \"BYO key\", \"model-agnostic\", \"any LLM\", or \"any model\" — markers of caller-held credentials and browser-local execution.",
    2,
    "The interpreter + stdlib ship as a ~13 MB WASM bundle. The same <code>.ail</code> module that ran on the server runs in a browser tab; only the effect handlers change. Common use: <em>BYO-key</em> — the user holds their own provider key in <code>localStorage</code>, <code>ai.step</code> calls go direct to the provider, your servers never see the credential. Other uses: offline-capable apps, embedded interactive demos, client-side data processing.",
    "https://ailang.sunholo.com/docs/guides/wasm-integration",
    "WASM integration ↗"
  ),

  protoRowNoRubric(
    "05", "GO", "Go interop",
    "Production hot paths drop into existing Go services as idiomatic Go code.",
    "ailang compile --emit-go",
    "Same source compiles to Go. ADTs become discriminator structs, exports become package-public functions, effects propagate as <code>error</code> returns. Same module, two runtimes — interpret in dev, compile for prod.",
    "https://ailang.sunholo.com/docs/guides/go-interop",
    "Go interop ↗"
  ),

  protoRow(
    "06", "EFH", "Effect handlers as runtime adapters",
    "The mechanism behind WASM + Go + native: business logic stays neutral, handlers do the env-specific work.",
    "interpreted | WASM | Go-compiled",
    "Body mentions \"self-hosted\", \"on-prem\", \"deploy anywhere\", \"kubernetes\", \"docker\", \"wasm\", or \"webassembly\".",
    2,
    "Net, FS, Stream, AI, IO are abstract effects. Each runtime supplies its own handler set: the CLI uses host stdlib; WASM uses the browser's <code>fetch</code>, <code>WebSocket</code>, and <code>localStorage</code>; Cloud Run uses container env. Business logic compiles unchanged; deployment becomes a handler swap, not a fork.",
    "https://ailang.sunholo.com/docs/guides/parameterised-effects",
    "Parameterised effects ↗"
  ),

  "</div>",
  "</section>"
])

-- ─── Top-level rebuild ────────────────────────────────────────

-- Rebuild the leaderboard JSON for a single topic. No-op if the
-- topic doesn't carry a leaderboard (compliance/budget/reliable).
-- Returns the number of entries that landed in the leaderboard.
export func sketchRebuildTopic(t: Topic, generatedAt: string) -> int ! {FS, IO} {
  if topicHasLeaderboard(t) then {
    let entries = sketchListEntries(t);
    let deduped = dedupByDomain(entries);
    let sorted = sortBy(cmpEntries, deduped);
    let ranked = assignRanks(sorted, sketchPublicRankCap());
    let json = entriesToJson(ranked, t, generatedAt);
    let path = sketchLeaderboardPath(t);
    mkdirAll(sketchTopicDir(t));
    writeFile(path, json);
    -- Also render the topic index page from the ranked entries.
    sketchRenderTopicPage(t, ranked, generatedAt);
    let n = listLength(ranked);
    println("✓ ${topicSlug(t)}: ranked ${intToStr(n)} entries → ${path}");
    n
  } else {
    -- No leaderboard, but still render a topic index page so the URL exists.
    sketchRenderTopicPage(t, [], generatedAt);
    println("- ${topicSlug(t)}: no leaderboard (no observable signals)");
    0
  }
}

-- ─── Inline rubric section (per topic) ──────────────────────

func renderSignalCard(s: Signal) -> string = join("", [
  "<div class=\"tx-signal\">",
  "<div class=\"name\">", s.name, "</div>",
  "<div class=\"points\"><span class=\"num\">", intToStr(s.maxPoints), "</span> pts</div>",
  "<div class=\"how\">", s.description, "</div>",
  "<div class=\"maps\"><strong>maps to</strong>", s.ailangFeature, "</div>",
  "</div>"
])

-- Returns the signals scored under a given topic, filtered from the
-- canonical registry. Each topic owns exactly the signals tagged to it.
func signalsForTopic(t: Topic) -> [Signal] =
  filter(\s. topicEq(s.topic, t), sketchAllSignalDefs())

func renderRubricSection(t: Topic) -> string {
  if topicHasLeaderboard(t) then {
    let signals = signalsForTopic(t);
    let signalCards = join("\n", map(renderSignalCard, signals));
    join("", [
      "<section class=\"tx-rubric\">",
      "<h2>What we measure</h2>",
      "<p class=\"lede\">Every score on this page is computed by <strong>contract-verified AILANG code</strong>. The signals below — and only these signals — feed the rank. Each one maps to an AILANG primitive a reader could adopt. No llms.txt, no robots.txt, no JSON-LD: AILANG doesn't have a position on those.</p>",
      signalCards,
      "</section>"
    ])
  } else {
    join("", [
      "<section class=\"tx-rubric\">",
      "<h2>What we measure</h2>",
      "<div class=\"no-rubric\">",
      "<strong>This topic has no scored signals.</strong> ",
      "We can't honestly measure ", topicHumanName(t),
      " from a single page fetch — it's about runtime behaviour, audit trails, and cost surfaces that aren't visible on a marketing page. ",
      "Sketches under <code>#ailang", topicCamelCase(t), "</code> still get rendered with the AILANG feature cards relevant to the topic; they just don't compete on a leaderboard.",
      "</div>",
      "</section>"
    ])
  }
}

-- ─── Topics-index page (the all-topics gallery) ──────────────

-- Hashtag chip for a topic card.
func topicHashtag(t: Topic) -> string = "#ailang${topicCamelCase(t)}"

-- Short hyphenated label for the card header.
func topicHumanName(t: Topic) -> string = match t {
  Privacy    => "privacy",
  Portable   => "portability",
  AgentReady => "agent-ready"
}

-- Render the topic landing page at site/linkedin/topics/<topic>/index.html.
export func sketchRenderTopicPage(t: Topic, entries: [LeaderboardEntry], generatedAt: string) -> () ! {FS} {
  let template = readFile("linkedin/templates/topic_index.html");
  let section = if topicHasLeaderboard(t)
                then renderLeaderboardSection(t, entries, generatedAt)
                else renderNoLeaderboardSection(t);
  let mechanics = match t {
    Privacy    => renderPrivacyMechanicsSection(t),
    AgentReady => renderAgentReadyProtocolsSection(t),
    Portable   => renderPortablePrimitivesSection(t)
  };
  -- Active-nav class for the cross-topic pill that matches `t`.
  let activeAR = match t { AgentReady => "is-active", _ => "" };
  let activePR = match t { Privacy    => "is-active", _ => "" };
  let activePO = match t { Portable   => "is-active", _ => "" };
  let html = replaceMany(template, [
    ("{{TOPIC_LABEL}}",              topicSlug(t)),
    ("{{TOPIC_SLUG}}",               topicSlug(t)),
    ("{{TOPIC_CAMEL}}",              topicCamelCase(t)),
    ("{{TOPIC_DESCRIPTION}}",        topicDescription(t)),
    ("{{TOPIC_DESCRIPTION_META}}",   topicDescriptionMeta(t)),
    ("{{LEADERBOARD_SECTION_HTML}}", section),
    ("{{MECHANICS_SECTION_HTML}}",   mechanics),
    ("{{NAV_AR_ACTIVE}}",            activeAR),
    ("{{NAV_PR_ACTIVE}}",            activePR),
    ("{{NAV_PO_ACTIVE}}",            activePO)
  ]);
  mkdirAll(sketchTopicDir(t));
  writeFile("${sketchTopicDir(t)}/index.html", html);
  ()
}
