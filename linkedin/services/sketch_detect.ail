module linkedin/services/sketch_detect

-- Walk comments.json, extract URL + #ailang-<topic> hashtag pairs,
-- emit SketchRequest entries.
--
-- Idempotent at the queue layer: the caller dedups against existing
-- queue + history files by (avatarSeed, url, topic).

import std/string (length, substring, toLower, find)
import std/list (foldl, concat as listConcat)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/json (asArray, asObject, getString, Json)
import linkedin/types/sketch_types (SketchRequest, Topic, Privacy, Portable, AgentReady)

-- ─── URL extraction ──────────────────────────────────────────

-- Return the first http(s) URL in `text`, or "" if none found.
-- A URL ends at the first whitespace or one of < > " ' .
export func sketchExtractUrl(text: string) -> string =
  let lower    = toLower(text) in
  let idxHttps = find(lower, "https://") in
  let idxHttp  = find(lower, "http://") in
  let startIdx = if idxHttps >= 0 then idxHttps
                 else if idxHttp >= 0 then idxHttp
                 else -1 in
  if startIdx < 0 then ""
  else substring(text, startIdx, findUrlEnd(text, startIdx))

func findUrlEnd(s: string, pos: int) -> int =
  if pos >= length(s) then pos
  else
    let c = substring(s, pos, pos + 1) in
    if c == " " || c == "\t" || c == "\n" || c == "\r" ||
       c == "<" || c == ">" || c == "\"" || c == "'" then pos
    else findUrlEnd(s, pos + 1)

-- ─── Hashtag extraction ──────────────────────────────────────

-- Return the topic slug from the first "#ailang*" hashtag in text,
-- or "" if none found.
--
-- Two formats supported:
--   #ailangAgentReady  (camelCase — canonical for LinkedIn, which
--                       breaks hashtags at hyphens)
--   #ailang-agent-ready (legacy kebab-case — kept working so older
--                        comments still resolve)
--
-- Both yield the same lowercase-kebab slug "agent-ready" downstream.
export func sketchExtractTopicHashtag(text: string) -> string =
  -- Search for the prefix case-sensitively against the original text
  -- so we can distinguish between camelCase and kebab forms.
  let idx = findPrefix(text, "#ailang") in
  if idx < 0 then ""
  else
    let cursor = idx + 7 in  -- length("#ailang") = 7
    if cursor >= length(text) then ""
    else
      let c = substring(text, cursor, cursor + 1) in
      if c == "-" then
        -- Legacy kebab: #ailang-<slug>
        let slugStart = cursor + 1 in
        let lower = toLower(text) in
        substring(lower, slugStart, findSlugEnd(lower, slugStart))
      else if isUpperChar(c) then
        -- camelCase: #ailangXxx — convert to kebab-case.
        let camelEnd = findCamelEnd(text, cursor) in
        let camel = substring(text, cursor, camelEnd) in
        camelToKebab(camel)
      else ""

-- Case-insensitive prefix search (#ailang / #AILANG / #Ailang all match).
func findPrefix(hay: string, needle: string) -> int =
  let h = toLower(hay) in
  let n = toLower(needle) in
  find(h, n)

func findSlugEnd(s: string, pos: int) -> int =
  if pos >= length(s) then pos
  else
    let c = substring(s, pos, pos + 1) in
    if isSlugChar(c) then findSlugEnd(s, pos + 1) else pos

func isSlugChar(c: string) -> bool =
  (c >= "a" && c <= "z") || c == "-" || (c >= "0" && c <= "9")

-- Walk forward through alphanumeric characters (both cases).
func findCamelEnd(s: string, pos: int) -> int =
  if pos >= length(s) then pos
  else
    let c = substring(s, pos, pos + 1) in
    if isAlpha(c) || (c >= "0" && c <= "9") then findCamelEnd(s, pos + 1) else pos

func isAlpha(c: string) -> bool =
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")

func isUpperChar(c: string) -> bool = c >= "A" && c <= "Z"

-- Convert camelCase to lowercase-hyphen-separated.
-- "AgentReady" -> "agent-ready"; "MCP" -> "m-c-p" (degenerate but valid).
func camelToKebab(s: string) -> string = toLower(camelToKebabAt(s, 0))

func camelToKebabAt(s: string, pos: int) -> string =
  if pos >= length(s) then ""
  else
    let c = substring(s, pos, pos + 1) in
    let rest = camelToKebabAt(s, pos + 1) in
    if pos > 0 && isUpperChar(c) then "-${c}${rest}"
    else "${c}${rest}"

-- ─── Topic slug parsing ──────────────────────────────────────

-- V1 topics: agent-ready, privacy, portable. Anything else
-- (including legacy hashtags like #ailangCompliance from before
-- the V1 cull, OR unspecified) routes to AgentReady — the most
-- action-oriented sketch.
export func parseTopicSlug(s: string) -> Topic =
  if      s == "privacy"     then Privacy
  else if s == "portable"    then Portable
  else                            AgentReady

-- ─── Comment → request ───────────────────────────────────────

-- Pull a SketchRequest from a Json comment node, if it contains
-- both a URL and a recognised topic hashtag.
export func sketchCommentToRequest(c: Json, requestedAt: string) -> Option[SketchRequest] {
  let text     = getOrElse(getString(c, "text"),       "");
  let initials = getOrElse(getString(c, "initials"),   "AI");
  let seed     = getOrElse(getString(c, "avatarSeed"), "e73c17");
  let url      = sketchExtractUrl(text);
  let topic    = sketchExtractTopicHashtag(text);
  if length(url) > 0 && length(topic) > 0 then
    Some({
      url:         url,
      topic:       parseTopicSlug(topic),
      initials:    initials,
      avatarSeed:  seed,
      requestedAt: requestedAt
    })
  else None
}

-- ─── Walking the comments.json shape ─────────────────────────

-- Look up a key in a [{key, value}] association list (the shape
-- std/json.asObject returns).
func lookupField(pairs: [{key: string, value: Json}], key: string) -> Option[Json] = match pairs {
  []             => None,
  [kv, ...rest]  => if kv.key == key then Some(kv.value) else lookupField(rest, key)
}

-- Recursively walk one comment node + its replies.
func walkComment(c: Json, requestedAt: string) -> [SketchRequest] {
  let self = sketchCommentToRequest(c, requestedAt);
  let replies = walkReplies(c, requestedAt);
  match self {
    Some(req) => listConcat([req], replies),
    None      => replies
  }
}

-- Pull the `replies` field of a comment node (if any) and recurse.
func walkReplies(c: Json, requestedAt: string) -> [SketchRequest] = match asObject(c) {
  Some(pairs) => match lookupField(pairs, "replies") {
    Some(repliesJson) => match asArray(repliesJson) {
      Some(rs) => foldl(\acc r. listConcat(acc, walkComment(r, requestedAt)), [], rs),
      None     => []
    },
    None => []
  },
  None => []
}

-- Walk one post node, returning all SketchRequests from its
-- top-level comments + nested replies.
func walkPost(post: Json, requestedAt: string) -> [SketchRequest] = match asObject(post) {
  Some(pairs) => match lookupField(pairs, "comments") {
    Some(commentsJson) => match asArray(commentsJson) {
      Some(cs) => foldl(\acc c. listConcat(acc, walkComment(c, requestedAt)), [], cs),
      None     => []
    },
    None => []
  },
  None => []
}

-- Top-level entry: walk the whole comments.json feed.
export func sketchDetectFromFeed(feedJson: Json, requestedAt: string) -> [SketchRequest] = match asArray(feedJson) {
  Some(posts) => foldl(\acc p. listConcat(acc, walkPost(p, requestedAt)), [], posts),
  None        => []
}
