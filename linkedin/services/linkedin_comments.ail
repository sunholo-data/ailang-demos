module linkedin/services/linkedin_comments

import std/net (httpRequest)
import std/json (encode, decode, getString, getArray, getObject, getInt, jo, kv, js, ja)
import std/string (length, trim, split, join, intToStr)
import std/option (Some, None, getOrElse, isSome)
import std/result (Ok, Err)
import std/list (length as listLength, map, foldl)
import linkedin/types/linkedin_types (LinkedInComment, PostState)

-- LinkedIn Comments API (read-only)
-- Fetch comments on published posts for AILANG Cloud ingestion
--
-- CAPABILITY BUDGETS:
--   linkedinGetComments:    Net @limit=1 per post
--   linkedinGetAllComments: Net @limit=20 (up to 20 posts)

-- LinkedIn API headers
func linkedinCommentHeaders(token: string) -> [{name: string, value: string}] = [
  { name: "Authorization", value: "Bearer ${token}" },
  { name: "X-Restli-Protocol-Version", value: "2.0.0" },
  { name: "LinkedIn-Version", value: "202604" }
]

-- URL-encode the post URN for the API path
func linkedinEncodeUrn(urn: string) -> string {
  -- LinkedIn requires URL-encoded URN in path
  -- urn:li:share:123 -> urn%3Ali%3Ashare%3A123
  linkedinReplaceColons(urn)
}

func linkedinReplaceColons(s: string) -> string {
  -- Simple colon replacement for URN encoding
  -- AILANG doesn't have replace(), so we rebuild char by char via split
  let parts = split(s, ":");
  join("%3A", parts)
}

-- Fetch comments for a single post
export func linkedinGetComments(token: string, postUrn: string) -> Result[[LinkedInComment], string] ! {Net @limit=1} {
  let encodedUrn = linkedinEncodeUrn(postUrn);
  let url = "https://api.linkedin.com/rest/socialActions/${encodedUrn}/comments";
  match httpRequest("GET", url, linkedinCommentHeaders(token), "") {
    Ok(response) => {
      if response.ok then linkedinParseCommentsResponse(response.body, postUrn)
      else Err("Comments API error (status ${response.status}): ${response.body}")
    },
    Err(_) => Err("Network error fetching comments for ${postUrn}")
  }
}

func linkedinParseCommentsResponse(body: string, postUrn: string) -> Result[[LinkedInComment], string] {
  match decode(body) {
    Ok(json) => {
      match getArray(json, "elements") {
        Some(elements) => Ok(linkedinParseCommentList(elements, postUrn)),
        None => Ok([])
      }
    },
    Err(e) => Err("Failed to parse comments: ${e}")
  }
}

func linkedinParseCommentList(elements: [Json], postUrn: string) -> [LinkedInComment] =
  match elements {
    [] => [],
    elem :: rest => {
      let comment = linkedinParseOneComment(elem, postUrn);
      comment :: linkedinParseCommentList(rest, postUrn)
    }
  }

func linkedinParseOneComment(elem: Json, postUrn: string) -> LinkedInComment {
  -- LinkedIn comments come back with this shape:
  --   { commentUrn: "urn:li:comment:(urn:li:share:...,...)",
  --     actor:      "urn:li:person:xxx",
  --     message:    { text: "the comment text", attributes: [...] },
  --     created:    { actor: "...", time: 1746000000000 },
  --     id:         "12345",
  --     ... }
  let urn = getOrElse(getString(elem, "commentUrn"), "");
  let text = match getObject(elem, "message") {
    Some(msg) => getOrElse(getString(msg, "text"), ""),
    None => ""
  };
  let created = match getObject(elem, "created") {
    Some(c) => match getInt(c, "time") {
      Some(t) => intToStr(t),
      None => ""
    },
    None => ""
  };
  -- Without r_member_profile we can't expand the actor URN to a name, so
  -- we just keep the URN. The website can present it as "Member X" or
  -- link to the LinkedIn profile.
  let authorName = getOrElse(getString(elem, "actor"), "unknown");
  let comment: LinkedInComment = {
    commentUrn: urn,
    authorName: authorName,
    text: text,
    createdAt: created,
    parentPostUrn: postUrn
  };
  comment
}

-- Fetch comments for all published posts
export func linkedinGetAllComments(token: string, states: [PostState]) -> [LinkedInComment] ! {Net @limit=20} {
  linkedinFetchCommentsLoop(token, states)
}

func linkedinFetchCommentsLoop(token: string, states: [PostState]) -> [LinkedInComment] ! {Net} =
  match states {
    [] => [],
    st :: rest => {
      let comments = match linkedinGetComments(token, st.postUrn) {
        Ok(cs) => cs,
        Err(_) => []
      };
      let others = linkedinFetchCommentsLoop(token, rest);
      linkedinConcatComments(comments, others)
    }
  }

func linkedinConcatComments(a: [LinkedInComment], b: [LinkedInComment]) -> [LinkedInComment] =
  match a {
    [] => b,
    x :: rest => x :: linkedinConcatComments(rest, b)
  }

-- Format comments as JSON for public ingestion.
--
-- GDPR: the published JSON is served at a public URL (the demos site),
-- so we deliberately strip everything that identifies the commenter:
--   - actor URN (was leaked as `authorName`)
--   - commentUrn (composite URN includes activity URN; could be resolved)
--
-- We keep:
--   - text       — the comment content; the user wrote this publicly on
--                  LinkedIn, but we still surface it without their name
--   - createdAt  — timestamp (epoch ms as string)
--   - parentPostUrn — our own post's URN, useful for grouping; this is
--                     the org's content, not the commenter's
export func linkedinCommentsToJson(comments: [LinkedInComment]) -> string {
  let entries = map(\c. jo([
    kv("text", js(c.text)),
    kv("createdAt", js(c.createdAt)),
    kv("parentPostUrn", js(c.parentPostUrn))
  ]), comments);
  encode(ja(entries))
}
