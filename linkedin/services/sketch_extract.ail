module linkedin/services/sketch_extract

-- Sketch content-extraction pipeline.
--
-- Strategy: docparse-first, AI-fallback.
--
-- 1. Fetch the URL once (Net @limit=1).
-- 2. Write the body to a temp file with .html extension.
-- 3. Invoke `docparse` via std/process — produces structured JSON + markdown.
--    The markdown output is "LLM-ready" plain text per docparse's own docs.
-- 4. If docparse exits cleanly and produces blocks: use the markdown.
-- 5. Otherwise: fall back to the raw HTML body (truncated).
-- 6. Send the chosen text to callJson with a fixed schema to extract
--    narrative, audience, primary jobs-to-be-done, and key entities.
-- 7. Return ExtractedContent recording which path ran.
--
-- This is V1: fixed temp paths (no parallel sketches yet), trimmed input
-- to ~8KB, content-classification via Gemini's structured-output mode.

import std/io (println)
import std/fs (writeFile, readFile, fileExists)
import std/string (length, substring, intToStr)
import std/list (length as listLength, map, foldl, concat as listConcat)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/process (exec)
import std/net (httpRequest, HttpResponse, NetError)
import std/ai (callJson)
import std/json (decode, getString, getStringArrayOrEmpty, getInt, asArray, asString, get, getOr, jn, ja, Json)
import linkedin/types/sketch_types (ExtractedContent, DocparseImage, DocparseLink)
import std/string (startsWith, split)

-- ─── Constants ────────────────────────────────────────────────

func tmpHtmlPath() -> string = "/tmp/ailang-sketch-input.html"
func tmpOutDir()  -> string = "/tmp/ailang-sketch-out"
func tmpMdPath()  -> string = "/tmp/ailang-sketch-out/ailang-sketch-input.html.md"
func tmpJsonPath() -> string = "/tmp/ailang-sketch-out/ailang-sketch-input.html.json"
func maxClassifyChars()       -> int = 8000
func maxTopHeadings()         -> int = 6
func maxExtractedMarkdown()   -> int = 12000  -- ~12KB cap on embedded extract

-- ─── Helpers ──────────────────────────────────────────────────

-- Truncate a string to at most `n` characters.
-- Two-sided contract: caller can't ask for negative truncation,
-- and we promise the result fits the bound.
func sketchTruncate(s: string, n: int) -> string
  requires { n >= 0 }
  ensures  { length(result) <= n }
{
  if length(s) <= n then s else substring(s, 0, n)
}

-- Build the classification schema (JSON Schema as a string).
func classifySchema() -> string =
  "{\"type\":\"object\",\"properties\":{\"domain\":{\"type\":\"string\"},\"audience\":{\"type\":\"string\"},\"jobs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"entities\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"narrative\":{\"type\":\"string\"}},\"required\":[\"domain\",\"audience\",\"jobs\",\"entities\",\"narrative\"]}"

-- Build the classification prompt for a given input text.
func classifyPrompt(text: string) -> string =
  "You are summarising a public website for a one-page \"AILANG sketch\". Read the following content and extract structured fields. Be dry, descriptive, not promotional. Reply with compact JSON (no whitespace) matching the schema.\n\nFields:\n  domain    — one of: ecommerce, content, saas, marketing, dev-tool, other\n  audience  — one sentence on who the site is for\n  jobs      — 2 to 4 primary jobs-to-be-done\n  entities  — 3 to 6 key domain terms or entities\n  narrative — one short paragraph (max 60 words) summarising the site\n\nContent:\n${text}"

-- ─── Fetch ────────────────────────────────────────────────────

-- Fetch a URL once. Returns the body string or "" on failure, where
-- failure includes any non-2xx status. Without this check, sites'
-- 404/410 pages are often large enough to pass the polite-refuse
-- threshold downstream — we'd end up scoring the marketing 404 page
-- instead of refusing to score (e.g. pleo.io shipped a 5KB 404 with
-- enough text to compile a "sketch" of nothing).
-- The Net @limit=1 budget is the executor's; this just makes the one call.
export func sketchFetch(url: string) -> string ! {Net, IO} {
  match httpRequest("GET", url, [], "") {
    Ok(resp)  => if resp.ok then resp.body else {
      println("  ✗ ${url} returned HTTP ${intToStr(resp.status)} — refusing to score the error page");
      ""
    },
    Err(_)    => ""
  }
}

-- ─── docparse stats (structural info from the JSON output) ──

-- A subset of docparse's per-document summary plus sampled content
-- from each block type. Populated only when docparse succeeded.
-- topHeadings + imageDescriptions + listItems are capped lists used
-- as chips on the rendered page to show what AILANG Parse saw.
export type DocparseStats = {
  headings:    int,
  tables:      int,
  images:      int,
  lists:       int,
  links:       int,
  -- section.kind counts (header/nav/main/article/section/footer/figure)
  sectionHeader:  int,
  sectionNav:     int,
  sectionMain:    int,
  sectionArticle: int,
  sectionSection: int,
  sectionFooter:  int,
  sectionFigure:  int,
  -- text blocks with style == "code"
  codeBlocks: int,
  topHeadings: [string],
  imageInfos:  [DocparseImage],
  linkInfos:   [DocparseLink],
  listItems:   [string]
}

func emptyStats() -> DocparseStats =
  { headings: 0, tables: 0, images: 0, lists: 0, links: 0,
    sectionHeader: 0, sectionNav: 0, sectionMain: 0, sectionArticle: 0,
    sectionSection: 0, sectionFooter: 0, sectionFigure: 0,
    codeBlocks: 0,
    topHeadings: [], imageInfos: [], linkInfos: [], listItems: [] }

-- Read /tmp/<...>.html.json (docparse's structured output) and
-- pull (headings, tables, images, topHeadings, listItems).
-- pageUrl is needed to resolve relative image src URLs.
export func sketchReadDocparseStats(pageUrl: string) -> DocparseStats ! {FS} {
  if fileExists(tmpJsonPath()) then
    match decode(readFile(tmpJsonPath())) {
      Ok(j)  => statsFromJson(j, pageUrl),
      Err(_) => emptyStats()
    }
  else emptyStats()
}

func statsFromJson(top: Json, pageUrl: string) -> DocparseStats = {
  let doc    = getOr(top, "document", jn());
  let blocks = getOr(doc, "blocks",   ja([]));
  -- Walk the whole tree — docparse's top-level summary only counts
  -- direct children, missing anything wrapped in section containers.
  let arr = match asArray(blocks) { Some(a) => a, None => [] };
  let allH = allHeadingsRec(arr);
  let allImgs = allImagesRec(arr, pageUrl);
  let allLinks = dedupLinks(allLinksRec(arr, pageUrl));
  let allListItems = allListItemsRec(arr);
  {
    headings:       listLength(allH),
    tables:         countBlocksByTypeRec(arr, "table"),
    images:         listLength(allImgs),
    lists:          countBlocksByTypeRec(arr, "list"),
    links:          listLength(allLinks),
    sectionHeader:  countSectionKindRec(arr, "header"),
    sectionNav:     countSectionKindRec(arr, "nav"),
    sectionMain:    countSectionKindRec(arr, "main"),
    sectionArticle: countSectionKindRec(arr, "article"),
    sectionSection: countSectionKindRec(arr, "section"),
    sectionFooter:  countSectionKindRec(arr, "footer"),
    sectionFigure:  countSectionKindRec(arr, "figure"),
    codeBlocks:     countCodeBlocksRec(arr),
    topHeadings:    takeN(allH, maxTopHeadings()),
    imageInfos:     takeImages(allImgs, maxTopHeadings()),
    linkInfos:      takeLinks(allLinks, 12),
    listItems:      takeN(allListItems, 12)
  }
}

-- Recursively count `section` blocks whose `kind` field matches the
-- target. Sections nest, so we walk the tree.
-- Counters are non-negative by construction.
func countSectionKindRec(blocks: [Json], targetKind: string) -> int
  ensures { result >= 0 }
{
  foldl(\acc b. acc + sectionKindInBlock(b, targetKind), 0, blocks)
}

func sectionKindInBlock(b: Json, targetKind: string) -> int = {
  let t = getOrElse(getString(b, "type"), "");
  let selfCount = if t == "section" && getOrElse(getString(b, "kind"), "") == targetKind then 1 else 0;
  let childCount = if t == "section" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => countSectionKindRec(children, targetKind),
      None           => 0
    }
  else 0;
  selfCount + childCount
}

-- Recursively count text blocks whose style is "code".
func countCodeBlocksRec(blocks: [Json]) -> int
  ensures { result >= 0 }
{
  foldl(\acc b. acc + codeBlocksInBlock(b), 0, blocks)
}

func codeBlocksInBlock(b: Json) -> int = {
  let t = getOrElse(getString(b, "type"), "");
  let selfCount = if t == "text" && getOrElse(getString(b, "style"), "") == "code" then 1 else 0;
  let childCount = if t == "section" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => countCodeBlocksRec(children),
      None           => 0
    }
  else 0;
  selfCount + childCount
}

-- Recursively collect heading text from a block tree.
func allHeadingsRec(blocks: [Json]) -> [string] =
  foldl(\acc b. listConcat(acc, headingsInBlock(b)), [], blocks)

func headingsInBlock(b: Json) -> [string] = {
  let t = getOrElse(getString(b, "type"), "");
  if t == "heading" then [getOrElse(getString(b, "text"), "")]
  else if t == "section" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => allHeadingsRec(children),
      None           => []
    }
  else []
}

-- Recursively count blocks of a given type (walks into `section` containers).
func countBlocksByTypeRec(blocks: [Json], targetType: string) -> int =
  foldl(\acc b. acc + countTypeInBlock(b, targetType), 0, blocks)

func countTypeInBlock(b: Json, targetType: string) -> int = {
  let t = getOrElse(getString(b, "type"), "");
  let selfCount = if t == targetType then 1 else 0;
  let childCount = if t == "section" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => countBlocksByTypeRec(children, targetType),
      None           => 0
    }
  else 0;
  selfCount + childCount
}

func takeN(xs: [string], n: int) -> [string] = match xs {
  []           => [],
  [x, ...rest] => if n <= 0 then [] else listConcat([x], takeN(rest, n - 1))
}

-- Recursively collect images (description + resolved src URL) from a
-- block tree. AILANG Parse v0.14.1+ exposes the src URL; we resolve
-- it against pageUrl so the sketch can embed it as a thumbnail.
func allImagesRec(blocks: [Json], pageUrl: string) -> [DocparseImage] =
  foldl(\acc b. listConcat(acc, imageInfoOfBlock(b, pageUrl)), [], blocks)

func imageInfoOfBlock(b: Json, pageUrl: string) -> [DocparseImage] = {
  let t = getOrElse(getString(b, "type"), "");
  if t == "image" then {
    let desc = getOrElse(getString(b, "description"), "");
    let rawSrc = getOrElse(getString(b, "src"), "");
    if length(rawSrc) == 0 then []
    else [{ description: desc, src: resolveUrl(pageUrl, rawSrc) }]
  } else if t == "section" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => allImagesRec(children, pageUrl),
      None           => []
    }
  else []
}

func takeImages(xs: [DocparseImage], n: int) -> [DocparseImage] = match xs {
  []           => [],
  [x, ...rest] => if n <= 0 then [] else listConcat([x], takeImages(rest, n - 1))
}

func takeLinks(xs: [DocparseLink], n: int) -> [DocparseLink] = match xs {
  []           => [],
  [x, ...rest] => if n <= 0 then [] else listConcat([x], takeLinks(rest, n - 1))
}

-- Recursively collect anchor links. v0.15.0+ exposes link blocks
-- with text + href + title. We resolve href against the page URL
-- and skip fragment-only / javascript: / empty hrefs.
func allLinksRec(blocks: [Json], pageUrl: string) -> [DocparseLink] =
  foldl(\acc b. listConcat(acc, linkInfoOfBlock(b, pageUrl)), [], blocks)

func linkInfoOfBlock(b: Json, pageUrl: string) -> [DocparseLink] = {
  let t = getOrElse(getString(b, "type"), "");
  if t == "link" then {
    let text = getOrElse(getString(b, "text"), "");
    let href = getOrElse(getString(b, "href"), "");
    let title = getOrElse(getString(b, "title"), "");
    -- Skip fragments, scripts, empty hrefs, mailto/tel — keep only navigable URLs.
    if length(href) == 0 || startsWith(href, "#") || startsWith(href, "javascript:") || startsWith(href, "mailto:") || startsWith(href, "tel:") then []
    else if length(text) == 0 then []
    else [{ text: text, href: resolveUrl(pageUrl, href), title: title }]
  } else if t == "section" || t == "list" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => allLinksRec(children, pageUrl),
      None           => []
    }
  else []
}

-- Dedup links by href (keeps first occurrence — typically the most
-- semantically meaningful link text).
func dedupLinks(xs: [DocparseLink]) -> [DocparseLink] = match xs {
  []           => [],
  [x, ...rest] => if linksHaveHref(rest, x.href)
                    then dedupLinks(rest)
                    else listConcat([x], dedupLinks(rest))
}

func linksHaveHref(xs: [DocparseLink], target: string) -> bool = match xs {
  []           => false,
  [x, ...rest] => if x.href == target then true else linksHaveHref(rest, target)
}

-- ─── URL resolution ──────────────────────────────────────────

-- Resolve a possibly-relative src against the page URL.
-- Handles: absolute, scheme-relative (//), data URIs, root-relative,
-- and same-dir relative URLs.
export func resolveUrl(pageUrl: string, src: string) -> string =
  if startsWith(src, "http://") || startsWith(src, "https://") then src
  else if startsWith(src, "//") then "https:${src}"
  else if startsWith(src, "data:") then src
  else if startsWith(src, "/") then "${urlOrigin(pageUrl)}${src}"
  else "${urlBasePath(pageUrl)}${src}"

-- Returns "https://www.sunholo.com" from any URL on that host.
func urlOrigin(url: string) -> string = match split(url, "/") {
  [scheme, _, host, ...rest] => "${scheme}//${host}",
  _                          => url
}

-- Returns origin + path up to and including the last "/".
-- "https://example.com/a/b/page.html" → "https://example.com/a/b/"
-- "https://example.com"               → "https://example.com/"
func urlBasePath(url: string) -> string =
  let idx = lastSlashIndex(url) in
  if idx < 0 || idx < 8 then "${url}/"  -- 8 == length of "https://"
  else substring(url, 0, idx + 1)

-- Walk from the end of the string finding the last "/".
func lastSlashIndex(s: string) -> int = scanForLastSlash(s, length(s) - 1)

func scanForLastSlash(s: string, pos: int) -> int =
  if pos < 0 then -1
  else if substring(s, pos, pos + 1) == "/" then pos
  else scanForLastSlash(s, pos - 1)

-- Recursively collect list items. Drops duplicates so the chips
-- don't repeat the same nav item shown in multiple lists.
func allListItemsRec(blocks: [Json]) -> [string] =
  dedupStrings(foldl(\acc b. listConcat(acc, listItemsOfBlock(b)), [], blocks))

func listItemsOfBlock(b: Json) -> [string] = {
  let t = getOrElse(getString(b, "type"), "");
  if t == "list" then
    getStringArrayOrEmpty(b, "items")
  else if t == "section" then
    match asArray(getOr(b, "blocks", ja([]))) {
      Some(children) => allListItemsRec(children),
      None           => []
    }
  else []
}

func dedupStrings(xs: [string]) -> [string] = match xs {
  []           => [],
  [x, ...rest] => if containsString(rest, x)
                    then dedupStrings(rest)
                    else listConcat([x], dedupStrings(rest))
}

func containsString(xs: [string], target: string) -> bool = match xs {
  []           => false,
  [x, ...rest] => if x == target then true else containsString(rest, target)
}

-- ─── docparse path ────────────────────────────────────────────

-- Try to extract via docparse. Returns Some(markdown) on success
-- with non-trivial output, None otherwise (caller falls back to AI).
export func sketchTryDocparse(html: string) -> Option[string] ! {FS, Process, IO} {
  -- 1. Write the fetched HTML to a known temp file.
  writeFile(tmpHtmlPath(), html);

  -- 2. Invoke docparse with --output-dir so we control where the
  -- markdown lands. docparse writes `<file>.html.md` alongside `.json`.
  match exec("docparse", [tmpHtmlPath(), "--output-dir", tmpOutDir()]) {
    Ok(out) => {
      if out.exitCode == 0 then {
        if fileExists(tmpMdPath()) then {
          let md = readFile(tmpMdPath());
          if length(md) > 100 then Some(md) else None
        } else None
      } else {
        println("docparse exited ${intToStr(out.exitCode)} — falling back to AI extraction");
        None
      }
    },
    Err(_) => {
      println("docparse not invocable — falling back to AI extraction");
      None
    }
  }
}

-- ─── AI classify ──────────────────────────────────────────────

-- Given a text input, call the classifier and parse the result
-- into an ExtractedContent. Caller passes the raw fetched body
-- so it can be threaded into the result (the rubric needs it).
export func sketchClassify(
  url: string,
  text: string,
  rawBody: string,
  extractionPath: string,
  blockCount: int,
  stats: DocparseStats,
  markdown: string
) -> ExtractedContent ! {AI} {
  let prompt = classifyPrompt(sketchTruncate(text, maxClassifyChars()));
  let raw = callJson(prompt, classifySchema());
  match decode(raw) {
    Ok(json) => {
      let domain    = getOrElse(getString(json, "domain"),    "other");
      let audience  = getOrElse(getString(json, "audience"),  "");
      let narrative = getOrElse(getString(json, "narrative"), "");
      let jobs      = getStringArrayOrEmpty(json, "jobs");
      let entities  = getStringArrayOrEmpty(json, "entities");
      {
        url:                 url,
        domain:              domain,
        audience:            audience,
        jobs:                jobs,
        entities:            entities,
        narrative:           narrative,
        extractionPath:      extractionPath,
        blockCount:          blockCount,
        rawBody:             rawBody,
        headingCount:        stats.headings,
        tableCount:          stats.tables,
        imageCount:          stats.images,
        listCount:           stats.lists,
        linkCount:           stats.links,
        sectionHeaderCount:  stats.sectionHeader,
        sectionNavCount:     stats.sectionNav,
        sectionMainCount:    stats.sectionMain,
        sectionArticleCount: stats.sectionArticle,
        sectionSectionCount: stats.sectionSection,
        sectionFooterCount:  stats.sectionFooter,
        sectionFigureCount:  stats.sectionFigure,
        codeBlockCount:      stats.codeBlocks,
        topHeadings:         stats.topHeadings,
        images:              stats.imageInfos,
        links:               stats.linkInfos,
        listItems:           stats.listItems,
        extractedMarkdown:   markdown
      }
    },
    Err(_) => {
      url:                 url,
      domain:              "other",
      audience:            "",
      jobs:                [],
      entities:            [],
      narrative:           "(extraction failed — JSON parse error)",
      extractionPath:      "polite-refuse",
      blockCount:          0,
      rawBody:             rawBody,
      headingCount:        0,
      tableCount:          0,
      imageCount:          0,
      listCount:           0,
      linkCount:           0,
      sectionHeaderCount:  0,
      sectionNavCount:     0,
      sectionMainCount:    0,
      sectionArticleCount: 0,
      sectionSectionCount: 0,
      sectionFooterCount:  0,
      sectionFigureCount:  0,
      codeBlockCount:      0,
      topHeadings:         [],
      images:              [],
      links:               [],
      listItems:           [],
      extractedMarkdown:   ""
    }
  }
}

-- ─── Top-level extract ────────────────────────────────────────

-- The full pipeline: fetch → docparse-or-fallback → classify.
-- Returns ExtractedContent recording which path ran.
export func sketchExtract(url: string) -> ExtractedContent ! {Net, FS, AI, Process, IO} {
  let html = sketchFetch(url);
  if length(html) < 200 then {
    -- Empty or tiny body — polite refuse, no AI call.
    {
      url:                 url,
      domain:              "other",
      audience:            "",
      jobs:                [],
      entities:            [],
      narrative:           "(could not fetch usable content from this URL — try describing your use case in one line on LinkedIn instead)",
      extractionPath:      "polite-refuse",
      blockCount:          0,
      rawBody:             html,
      headingCount:        0,
      tableCount:          0,
      imageCount:          0,
      listCount:           0,
      linkCount:           0,
      sectionHeaderCount:  0,
      sectionNavCount:     0,
      sectionMainCount:    0,
      sectionArticleCount: 0,
      sectionSectionCount: 0,
      sectionFooterCount:  0,
      sectionFigureCount:  0,
      codeBlockCount:      0,
      topHeadings:         [],
      images:              [],
      links:               [],
      listItems:           [],
      extractedMarkdown:   ""
    }
  } else {
    -- Try docparse, fall back to raw HTML.
    match sketchTryDocparse(html) {
      Some(md) => sketchClassify(url, md, html, "docparse", 1, sketchReadDocparseStats(url), sketchTruncate(md, maxExtractedMarkdown())),
      None     => sketchClassify(url, html, html, "ai-fallback", 0, emptyStats(), "")
    }
  }
}
