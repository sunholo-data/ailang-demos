module linkedin/services/linkedin_posts

import std/net (httpRequest)
import std/fs (readFile, writeFile, fileExists)
import std/json (encode, decode, getString, getArray, jo, kv, js, ja, asArray)
import std/option (Some, None, getOrElse, isSome)
import std/result (Ok, Err)
import std/string (length, trim, replace, charCode, charAt)
import std/list (length as listLength, map, filter, foldl)
import linkedin/types/linkedin_types (PostResult, PostState)

-- LinkedIn Posts API
-- Create posts on company page via REST API
--
-- CAPABILITY BUDGETS:
--   linkedinCreatePost: Net @limit=1
--   linkedinSaveState:  FS @limit=5
--   linkedinLoadState:  FS @limit=5

-- LinkedIn API version header
func linkedinApiVersion() -> string = "202604"

-- Build standard LinkedIn API headers
func linkedinHeaders(token: string) -> [{name: string, value: string}] = [
  { name: "Authorization", value: "Bearer ${token}" },
  { name: "Content-Type", value: "application/json" },
  { name: "X-Restli-Protocol-Version", value: "2.0.0" },
  { name: "LinkedIn-Version", value: linkedinApiVersion() }
]

-- LinkedIn's commentary field uses "Little Text Format". These characters
-- are syntactic (mentions, hashtags, entities) and must be backslash-escaped
-- to appear as literal text. Order matters: `\` must be replaced first to
-- avoid double-escaping our own backslashes.
func linkedinEscapeLittleText(s: string) -> string {
  let s1 = replace(s, "\\", "\\\\");
  let s2 = replace(s1, "(", "\\(");
  let s3 = replace(s2, ")", "\\)");
  let s4 = replace(s3, "[", "\\[");
  let s5 = replace(s4, "]", "\\]");
  let s6 = replace(s5, "{", "\\{");
  let s7 = replace(s6, "}", "\\}");
  let s8 = replace(s7, "<", "\\<");
  let s9 = replace(s8, ">", "\\>");
  let s10 = replace(s9, "@", "\\@");
  let s11 = replace(s10, "|", "\\|");
  let s12 = replace(s11, "*", "\\*");
  let s13 = replace(s12, "_", "\\_");
  let s14 = replace(s13, "~", "\\~");
  -- Hashtags (#) are intentionally NOT escaped here so the author can
  -- include real hashtags in the post body; LinkedIn renders #foo as a tag.
  s14
}

-- Create a post on the company page
export func linkedinCreatePost(token: string, orgUrn: string, text: string) -> Result[PostResult, string] ! {Net @limit=1}
requires { length(text) > 0 && length(text) <= 3000 }
{
  let url = "https://api.linkedin.com/rest/posts";
  let escaped = linkedinEscapeLittleText(text);
  let body = encode(jo([
    kv("author", js(orgUrn)),
    kv("commentary", js(escaped)),
    kv("visibility", js("PUBLIC")),
    kv("distribution", jo([
      kv("feedDistribution", js("MAIN_FEED"))
    ])),
    kv("lifecycleState", js("PUBLISHED"))
  ]));
  match httpRequest("POST", url, linkedinHeaders(token), body) {
    Ok(response) => {
      if response.ok then linkedinParsePostResponse(response.headers, response.body)
      else Err("LinkedIn API error (status ${response.status}): ${response.body}")
    },
    Err(_) => Err("Network error creating LinkedIn post")
  }
}

func linkedinParsePostResponse(headers: [{name: string, value: string}], body: string) -> Result[PostResult, string] {
  -- LinkedIn POST /rest/posts returns 201 with the URN in the `x-restli-id`
  -- response header. The body is empty on success.
  let headerUrn = linkedinFindHeader(headers, "x-restli-id");
  let postUrn = if length(headerUrn) > 0 then headerUrn
                else if length(trim(body)) > 0 then linkedinExtractUrn(body)
                else "pending";
  let result: PostResult = {
    postUrn: postUrn,
    slug: "",
    publishedAt: ""
  };
  Ok(result)
}

-- Case-insensitive header lookup (HTTP header names aren't case-sensitive
-- and LinkedIn has sent `X-RestLi-Id` and `x-restli-id` historically).
func linkedinFindHeader(headers: [{name: string, value: string}], target: string) -> string =
  match headers {
    [] => "",
    h :: rest => if linkedinHeaderMatches(h.name, target) then h.value
                 else linkedinFindHeader(rest, target)
  }

func linkedinHeaderMatches(a: string, b: string) -> bool {
  -- Cheap case-insensitive compare without importing toLower in every callsite.
  -- We're only comparing short, ASCII header names.
  let la = length(a);
  let lb = length(b);
  if la != lb then false
  else asciiEqualsIgnoreCase(a, b, 0, la)
}

func asciiEqualsIgnoreCase(a: string, b: string, i: int, n: int) -> bool =
  if i >= n then true
  else {
    let ca = lowerByteAt(a, i);
    let cb = lowerByteAt(b, i);
    if ca == cb then asciiEqualsIgnoreCase(a, b, i + 1, n)
    else false
  }

func lowerByteAt(s: string, i: int) -> int {
  let c = charCode(charAt(s, i));
  if c >= 65 && c <= 90 then c + 32 else c
}

func linkedinExtractUrn(body: string) -> string {
  match decode(body) {
    Ok(json) => getOrElse(getString(json, "id"), "unknown"),
    Err(_) => "created"
  }
}

-- State file path (relative to repo root)
func linkedinStatePath() -> string = "linkedin/data/state.json"

-- Save a published post to state. Bumped from 5 to 20: writeFile + a few
-- internal AILANG FS ops easily exceeded the previous limit, leaving the
-- state file empty after a successful publish.
export func linkedinSaveState(slug: string, postUrn: string, publishedAt: string) -> () ! {FS @limit=20} {
  let existing = linkedinLoadState();
  let entry: PostState = { slug: slug, postUrn: postUrn, publishedAt: publishedAt };
  let updated = entry :: existing;
  let json = linkedinEncodeStateList(updated);
  writeFile(linkedinStatePath(), json)
}

func linkedinEncodeStateList(states: [PostState]) -> string {
  let entries = map(\s. jo([
    kv("slug", js(s.slug)),
    kv("postUrn", js(s.postUrn)),
    kv("publishedAt", js(s.publishedAt))
  ]), states);
  encode(ja(entries))
}

-- Load published post state
export func linkedinLoadState() -> [PostState] ! {FS @limit=5} {
  let path = linkedinStatePath();
  let found = fileExists(path);
  if found then linkedinParseStateFile(path) else []
}

func linkedinParseStateFile(path: string) -> [PostState] ! {FS} {
  let content = readFile(path);
  match decode(content) {
    Ok(json) => linkedinExtractStates(json),
    Err(_) => []
  }
}

-- Convert a top-level JSON array of {slug, postUrn, publishedAt} objects
-- into a list of PostState records. Drops malformed entries silently.
func linkedinExtractStates(json: Json) -> [PostState] {
  match asArray(json) {
    Some(elems) => map(\e. linkedinStateOfJson(e), elems),
    None => []
  }
}

func linkedinStateOfJson(j: Json) -> PostState {
  let entry: PostState = {
    slug: getOrElse(getString(j, "slug"), ""),
    postUrn: getOrElse(getString(j, "postUrn"), ""),
    publishedAt: getOrElse(getString(j, "publishedAt"), "")
  };
  entry
}

-- Check if a slug has been published
export func linkedinIsPublished(slug: string) -> bool ! {FS @limit=5} {
  let states = linkedinLoadState();
  linkedinSlugInStates(slug, states)
}

func linkedinSlugInStates(slug: string, states: [PostState]) -> bool =
  match states {
    [] => false,
    s :: rest => if s.slug == slug then true else linkedinSlugInStates(slug, rest)
  }
