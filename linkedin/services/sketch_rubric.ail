  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigApiDocsLink();
  let bl = toLower(body);
  let detected = contains(bl, "api documentation") || contains(bl, "/api/docs") || contains(bl, "developers.") || contains(bl, "/docs/api") || contains(bl, "api reference");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
