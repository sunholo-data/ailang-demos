export func scoreComplianceCerts(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigComplianceCerts();
  let bl = toLower(body);
  -- Looking for a NAMED certification. Spaces matter — "soc2" alone is
  -- ambiguous, but "soc 2"/"soc-2"/"iso 27001"/"gdpr"/"hipaa"/"ccpa"
  -- are unambiguous tokens.
  let detected = contains(bl, "soc 2") || contains(bl, "soc2") || contains(bl, "soc-2") || contains(bl, "iso 27001") || contains(bl, "iso-27001") || contains(bl, "gdpr") || contains(bl, "hipaa") || contains(bl, "ccpa") || contains(bl, "iso 27018");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreDataMinimisation(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigDataMinimisation();
  let bl = toLower(body);
  let detected = contains(bl, "we do not sell") || contains(bl, "we don't sell") || contains(bl, "no third-party") || contains(bl, "no third party") || contains(bl, "privacy-first") || contains(bl, "privacy first") || contains(bl, "data minimization") || contains(bl, "data minimisation") || contains(bl, "purpose limitation") || contains(bl, "no data sharing");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreThirdPartyDomains(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigThirdPartyDomains();
  let bl = toLower(body);
  -- V1 heuristic: count https:// occurrences as a proxy for external
  -- resource count. Crude but defensible. Refined to proper URL
  -- parsing + cross-origin counting in V2.
  let count = countOccurrences(bl, "https://");
  let points = if count <= 10 then 2
               else if count <= 20 then 1
               else 0;
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        points,
    maxPoints:     def.maxPoints,
    detected:      points > 0,
    ailangFeature: def.ailangFeature
  }
}

export func scoreDataResidencyLanguage(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigDataResidencyLanguage();
  let bl = toLower(body);
  let detected = contains(bl, "data residency") || contains(bl, "on-premises") || contains(bl, "on-prem") || contains(bl, "sovereign cloud") || contains(bl, "eu-hosted") || contains(bl, "data sovereignty") || contains(bl, "self-hosted");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreSingleVendorLlm(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigSingleVendorLlm();
  let bl = toLower(body);
  -- Broadened far beyond "powered by X" — real lock-in language varies:
  -- "claude-powered", "running on anthropic", "uses gpt-4", "based on
  -- gemini". Penalty fires when one vendor is mentioned in vendor-locked
  -- phrasing.
  let detected = contains(bl, "powered by claude") || contains(bl, "powered by gpt") || contains(bl, "powered by gemini") || contains(bl, "built on claude") || contains(bl, "built on gpt") || contains(bl, "built on gemini") || contains(bl, "claude-powered") || contains(bl, "gpt-powered") || contains(bl, "gemini-powered") || contains(bl, "running on anthropic") || contains(bl, "running on openai") || contains(bl, "running on google ai") || contains(bl, "based on claude") || contains(bl, "based on gpt") || contains(bl, "based on gemini") || contains(bl, "uses claude") || contains(bl, "uses gpt") || contains(bl, "uses gemini");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    -- Detected = 0 points (vendor-locked). Not detected = full
    -- points (no single-vendor claim visible).
    points:        if detected then 0 else def.maxPoints,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

-- Count how many of a fixed provider-name list appear in the body.
-- Used by scoreMultiProviderMentioned to detect vendor-multi sites.
func boolToInt(b: bool) -> int = if b then 1 else 0

func countProviders(bl: string) -> int =
  boolToInt(contains(bl, "claude"))    +
  boolToInt(contains(bl, "anthropic")) +
  boolToInt(contains(bl, "gpt"))       +
  boolToInt(contains(bl, "openai"))    +
  boolToInt(contains(bl, "gemini"))    +
  boolToInt(contains(bl, "mistral"))   +
  boolToInt(contains(bl, "llama"))     +
  boolToInt(contains(bl, "ollama"))    +
  boolToInt(contains(bl, "openrouter"))

export func scoreMultiProviderMentioned(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigMultiProviderMentioned();
  let bl = toLower(body);
  -- Naming two distinct providers (e.g. Claude + Gemini, or Llama +
  -- OpenAI) is a strong portability signal. "anthropic" and "claude"
  -- are co-counted; this is intentionally lenient — two co-counted
  -- mentions still beat one provider being mentioned in isolation.
  let count = countProviders(bl);
  let detected = count >= 2;
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

