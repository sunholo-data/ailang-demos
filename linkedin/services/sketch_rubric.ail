}

export func scoreAuthDocumented(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigAuthDocumented();
  let bl = toLower(body);
  -- "api key" is broad; "oauth2"/"oauth 2"/"jwt"/"bearer"/"access token"
  -- are specific. Detecting any one is enough — caller has documented
  -- *how* an agent should authenticate.
  let detected = contains(bl, "oauth 2") || contains(bl, "oauth2") || contains(bl, " jwt ") || contains(bl, "bearer token") || contains(bl, "access token") || contains(bl, "api key") || contains(bl, "client credentials");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

