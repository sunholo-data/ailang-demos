export func scoreWebhooks(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigWebhooks();
  let bl = toLower(body);
  -- Sites variously call the same primitive a webhook, a callback,
  -- a notification, or an event subscription. Detect any of them —
  -- "notification" is left lenient (with a leading space-or-quote)
  -- to avoid matching things like "iOS push notifications".
  let detected = contains(bl, "webhook") || contains(bl, "/webhooks") || contains(bl, "callback url") || contains(bl, "callback_url") || contains(bl, " callback") || contains(bl, "event subscription") || contains(bl, "event notification") || contains(bl, "notifications api");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreRateLimitDocs(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigRateLimitDocs();
  let bl = toLower(body);
  -- "rate limit" / "rate-limit" / "x-ratelimit" header / "429" status / "throttl" prefix.
  let detected = contains(bl, "rate limit") || contains(bl, "rate-limit") || contains(bl, "x-ratelimit") || contains(bl, "429") || contains(bl, "throttl");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreStreamingEndpoint(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigStreamingEndpoint();
  let bl = toLower(body);
  -- Broadened: many sites describe streaming agents reach for without
  -- using the literal "SSE" / "EventSource" terms. WebSocket APIs,
  -- "real-time" APIs, and "stream" verbs are all valid agent surfaces.
  let detected = contains(bl, "server-sent events") || contains(bl, "text/event-stream") || contains(bl, "/sse") || contains(bl, "eventsource") || contains(bl, "streaming endpoint") || contains(bl, "real-time api") || contains(bl, "realtime api") || contains(bl, "websocket api") || contains(bl, "stream api") || contains(bl, "streaming api");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreSandboxOffered(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigSandboxOffered();
  let bl = toLower(body);
  let detected = contains(bl, "sandbox") || contains(bl, "test mode") || contains(bl, "test environment") || contains(bl, "testing environment");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
