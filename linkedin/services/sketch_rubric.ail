export func scoreRateLimitDocs(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigRateLimitDocs();
  let bl = toLower(body);
  -- "rate limit" / "rate-limit" / "x-ratelimit" header / "429" status / "throttl" prefix.
  let detected = contains(bl, "rate limit") || contains(bl, "rate-limit") || contains(bl, "x-ratelimit") || contains(bl, "429") || contains(bl, "throttl");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreStreamingEndpoint(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigStreamingEndpoint();
  let bl = toLower(body);
  let detected = contains(bl, "server-sent events") || contains(bl, "text/event-stream") || contains(bl, "/sse") || contains(bl, "eventsource") || contains(bl, "streaming endpoint");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreLlmProviderMentioned(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigLlmProviderMentioned();
  let bl = toLower(body);
  let detected = contains(bl, "claude") || contains(bl, "gpt-") || contains(bl, "openai") || contains(bl, "anthropic") || contains(bl, "gemini") || contains(bl, "powered by ai");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    -- Note: this is an INFORMATIONAL signal — detecting LLM use
    -- doesn't dock the privacy score, it surfaces opportunity.
    -- Detected = 1 point (signal present); not detected = 2 points
    -- (no known data flow to an LLM provider visible from this page).
    points:        if detected then 1 else def.maxPoints,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreThirdPartyDomains(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigThirdPartyDomains();
  let bl = toLower(body);
  -- V1 heuristic: count https:// occurrences as a proxy for external
  -- resource count. Crude but defensible. Refined to proper URL
  -- parsing + cross-origin counting in V2.
  let count = countOccurrences(bl, "https://");
  let points = if count <= 10 then 2
               else if count <= 20 then 1
               else 0;
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        points,
    maxPoints:     def.maxPoints,
    detected:      points > 0,
    ailangFeature: def.ailangFeature
  }
}

export func scoreDataResidencyLanguage(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigDataResidencyLanguage();
  let bl = toLower(body);
  let detected = contains(bl, "data residency") || contains(bl, "on-premises") || contains(bl, "on-prem") || contains(bl, "sovereign cloud") || contains(bl, "eu-hosted") || contains(bl, "data sovereignty") || contains(bl, "self-hosted");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreSingleVendorLlm(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigSingleVendorLlm();
  let bl = toLower(body);
  -- "powered by Claude" / "built on GPT-4" / "uses Gemini" — one
  -- vendor named, no portability claims = low portability score.
  let detected = contains(bl, "powered by claude") || contains(bl, "powered by gpt") || contains(bl, "powered by gemini") || contains(bl, "built on claude") || contains(bl, "built on gpt") || contains(bl, "built on gemini");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    -- Detected = 0 points (vendor-locked). Not detected = full
    -- points (no single-vendor claim visible).
    points:        if detected then 0 else def.maxPoints,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

-- ─── Aggregators ──────────────────────────────────────────────

-- Run every scorer against the body, return all 11 Signal records.
export func sketchScoreAllSignals(body: string) -> [Signal] = [
  scoreAgentJson(body),
  scoreOpenApi(body),
  scoreMcpEndpoint(body),
  scoreApiDocsLink(body),
  scoreWebhooks(body),
  scoreRateLimitDocs(body),
  scoreStreamingEndpoint(body),
  scoreLlmProviderMentioned(body),
  scoreThirdPartyDomains(body),
  scoreDataResidencyLanguage(body),
  scoreSingleVendorLlm(body)
]

-- Compute a 0-10 readiness score for a topic from its signals.
-- (V1: all three current topics have signals — function still defined
--  generically so a future no-signal topic just returns readiness=0.)
export func sketchComputeTopicScore(signals: [Signal], t: Topic) -> TopicScore
  ensures { result.readiness >= 0, result.readiness <= 10 }
{
  let topicSignals = filter(\s. topicEq(s.topic, t), signals);
  let totalPoints = foldl(\acc s. acc + s.points, 0, topicSignals);
  let totalMax = foldl(\acc s. acc + s.maxPoints, 0, topicSignals);
  -- Integer division: readiness scales 0..10 linearly with totalPoints/totalMax.
  let readinessRaw = if totalMax == 0 then 0 else (totalPoints * 10) / totalMax;
  let readiness = if readinessRaw < 0 then 0
                  else if readinessRaw > 10 then 10
                  else readinessRaw;
  {
    topic:          t,
    readiness:      readiness,
    opportunity:    10 - readiness,
    signals:        topicSignals,
    hasLeaderboard: topicHasLeaderboard(t)
  }
}

-- Produce a TopicScore for every topic from a list of signals.
export func sketchComputeAllTopicScores(signals: [Signal]) -> [TopicScore] = [
  sketchComputeTopicScore(signals, AgentReady),
  sketchComputeTopicScore(signals, Privacy),
  sketchComputeTopicScore(signals, Portable)
]
