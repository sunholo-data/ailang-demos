{
  let def = sigMcpEndpoint();
  let bl = toLower(body);
  let detected = contains(bl, "/mcp/") || contains(bl, "/mcp/sse") || contains(bl, "mcp-server") || contains(bl, "model context protocol");
  {
    name:          def.name,
