  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigCrossRuntimeClaim();
  let bl = toLower(body);
  let detected = contains(bl, "self-hosted") || contains(bl, "self host") || contains(bl, "on-prem") || contains(bl, "on premises") || contains(bl, "wasm") || contains(bl, "webassembly") || contains(bl, "deploy anywhere") || contains(bl, "kubernetes") || contains(bl, "docker");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreByoKey(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigByoKey();
  let bl = toLower(body);
  -- Broadened: real BYO-key copy varies a lot — "your own API key",
  -- "use any provider", "your own model", "caller-provided credentials".
  let detected = contains(bl, "bring your own key") || contains(bl, "bring-your-own") || contains(bl, "byok") || contains(bl, "byo key") || contains(bl, "model-agnostic") || contains(bl, "model agnostic") || contains(bl, "any llm") || contains(bl, "any model") || contains(bl, "your own api key") || contains(bl, "your api key") || contains(bl, "use any provider") || contains(bl, "your own model") || contains(bl, "caller-provided") || contains(bl, "caller provided");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

-- ─── Aggregators ──────────────────────────────────────────────

-- Run every scorer against the body, return all 19 Signal records.
export func sketchScoreAllSignals(body: string) -> [Signal] = [
  scoreAgentJson(body),
  scoreOpenApi(body),
  scoreMcpEndpoint(body),
  scoreApiDocsLink(body),
  scoreWebhooks(body),
  scoreRateLimitDocs(body),
  scoreStreamingEndpoint(body),
  scoreSandboxOffered(body),
  scoreAuthDocumented(body),
  scoreIdempotency(body),
  scoreE2EE(body),
  scoreComplianceCerts(body),
  scoreDataMinimisation(body),
  scoreThirdPartyDomains(body),
  scoreDataResidencyLanguage(body),
  scoreSingleVendorLlm(body),
  scoreMultiProviderMentioned(body),
  scoreCrossRuntimeClaim(body),
  scoreByoKey(body)
]

-- Compute a 0-10 readiness score for a topic from its signals.
-- (V1: all three current topics have signals — function still defined
--  generically so a future no-signal topic just returns readiness=0.)
export func sketchComputeTopicScore(signals: [Signal], t: Topic) -> TopicScore
  ensures { result.readiness >= 0, result.readiness <= 10 }
{
  let topicSignals = filter(\s. topicEq(s.topic, t), signals);
  let totalPoints = foldl(\acc s. acc + s.points, 0, topicSignals);
  let totalMax = foldl(\acc s. acc + s.maxPoints, 0, topicSignals);
  -- Integer division: readiness scales 0..10 linearly with totalPoints/totalMax.
  let readinessRaw = if totalMax == 0 then 0 else (totalPoints * 10) / totalMax;
  let readiness = if readinessRaw < 0 then 0
                  else if readinessRaw > 10 then 10
                  else readinessRaw;
  {
    topic:          t,
    readiness:      readiness,
    opportunity:    10 - readiness,
    signals:        topicSignals,
    hasLeaderboard: topicHasLeaderboard(t)
  }
}

-- Produce a TopicScore for every topic from a list of signals.
export func sketchComputeAllTopicScores(signals: [Signal]) -> [TopicScore] = [
  sketchComputeTopicScore(signals, AgentReady),
  sketchComputeTopicScore(signals, Privacy),
  sketchComputeTopicScore(signals, Portable)
]
