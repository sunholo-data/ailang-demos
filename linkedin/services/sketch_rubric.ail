  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigIdempotency();
  let bl = toLower(body);
  let detected = contains(bl, "idempotency") || contains(bl, "idempotent") || contains(bl, "idempotency-key") || contains(bl, "idempotency key");
