  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigE2EE();
  let bl = toLower(body);
  let detected = contains(bl, "end-to-end encryption") || contains(bl, "end to end encryption") || contains(bl, "e2ee") || contains(bl, "zero-knowledge") || contains(bl, "zero knowledge") || contains(bl, "client-side encryption") || contains(bl, "client side encryption") || contains(bl, "sealed envelope");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
