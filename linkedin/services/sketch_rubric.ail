module linkedin/services/sketch_rubric

-- The sketch rubric — pure scoring functions for each signal,
-- plus topic-score aggregators.
--
-- Hard rule (per design doc §6.5): every signal here maps to an
-- AILANG primitive a reader could adopt. V1 detection is body-text-
-- based only — bounded by the Net @limit=1 budget of sketchSite,
-- so we can't probe additional endpoints. AI-classified signals
-- (data residency language, single-vendor LLM language) are
-- approximated by keyword detection in V1; refined to callJson in V2.
--
-- Three topics carry observable signals and feed leaderboards:
-- AgentReady, Privacy, Portable. (Compliance/Budget/Reliable were
-- dropped in V1 — see sketches.md §4.)

import std/string (contains, toLower, split)
import std/list (length as listLength, foldl, filter)
import linkedin/types/sketch_types (Signal, TopicScore, Topic, Privacy, Portable, AgentReady)
import linkedin/services/sketch_rubric_signals (sigAgentJson, sigOpenApi, sigMcpEndpoint, sigApiDocsLink, sigWebhooks, sigRateLimitDocs, sigStreamingEndpoint, sigLlmProviderMentioned, sigThirdPartyDomains, sigDataResidencyLanguage, sigSingleVendorLlm)

-- ─── Helpers ──────────────────────────────────────────────────

-- Topic equality via nested pattern match — AILANG ADT
-- constructors don't auto-derive == for tag-only variants.
export func topicEq(a: Topic, b: Topic) -> bool = match a {
  Privacy    => match b { Privacy    => true, _ => false },
  Portable   => match b { Portable   => true, _ => false },
  AgentReady => match b { AgentReady => true, _ => false }
}

-- All three current topics carry leaderboards. Kept as a function
-- (rather than removed) so future no-leaderboard topics can be
-- reintroduced without rewriting downstream callers.
export func topicHasLeaderboard(t: Topic) -> bool = true

-- Count occurrences of a substring in a string.
func countOccurrences(hay: string, needle: string) -> int =
  listLength(split(hay, needle)) - 1

-- ─── Per-signal scorers (pure, no effects) ────────────────────

export func scoreAgentJson(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigAgentJson();
  let bl = toLower(body);
  let detected = contains(bl, "/.well-known/agent.json") || contains(bl, "agent.json\"") || contains(bl, "agent.json'");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

export func scoreOpenApi(body: string) -> Signal
  ensures { result.points >= 0, result.points <= result.maxPoints }
{
  let def = sigOpenApi();
  let bl = toLower(body);
  let detected = contains(bl, "openapi.json") || contains(bl, "openapi.yaml") || contains(bl, "swagger") || contains(bl, "redoc");
  {
    name:          def.name,
    description:   def.description,
    topic:         def.topic,
    points:        if detected then def.maxPoints else 0,
    maxPoints:     def.maxPoints,
    detected:      detected,
    ailangFeature: def.ailangFeature
  }
}

