module linkedin/services/sketch_template

-- Renderer for the sketch HTML page.
--
-- Strategy: read linkedin/templates/sketch.html as a string, build
-- each repeated section as a sub-string in AILANG, then do one
-- replaceMany over the template with every {{PLACEHOLDER}} -> value
-- substitution. No mini template-engine needed.
--
-- Effects: ! {FS} — reads the template file. Pure otherwise.

import std/fs (readFile)
import std/string (replaceMany, intToStr, join)
import std/list (map, concat as listConcat, length as listLength)
import linkedin/types/sketch_types (Sketch, Signal, TopicScore, FeatureCard, ExtractedContent, Topic, Privacy, Portable, AgentReady)
import linkedin/services/sketch_rubric (topicEq, topicHasLeaderboard)

-- ─── Topic ↔ string helpers ───────────────────────────────────

export func topicSlug(t: Topic) -> string = match t {
  Privacy    => "privacy",
  Portable   => "portable",
  AgentReady => "agent-ready"
}

-- camelCase form for the LinkedIn hashtag, which breaks at hyphens.
-- Always paired with the literal "ailang" prefix to form "#ailangXxx".
export func topicCamelCase(t: Topic) -> string = match t {
  Privacy    => "Privacy",
  Portable   => "Portable",
  AgentReady => "AgentReady"
}

-- ─── Per-section renderers (pure string-building) ─────────────

func renderChipHtml(text: string) -> string =
  "<span class=\"sk-chip\">${text}</span>"

func renderChipsHtml(chips: [string]) -> string =
  join(" ", map(renderChipHtml, chips))

func renderCardHtml(c: FeatureCard) -> string = join("", [
  "<article class=\"sk-card\">",
  "<h3>", c.feature, "</h3>",
  "<p class=\"rationale\">", c.rationale, "</p>",
  "<pre>", c.code, "</pre>",
  "</article>"
])

func renderCardsHtml(cards: [FeatureCard]) -> string =
  join("\n", map(renderCardHtml, cards))

func sigResultMark(s: Signal) -> string =
  if s.detected then "✓" else if s.points > 0 then "○" else "✗"

func sigResultClass(s: Signal) -> string =
  if s.detected then "ok" else if s.points > 0 then "ok" else "no"

func renderSignalRow(s: Signal) -> string = join("", [
  "<tr>",
  "<td>", s.name, "</td>",
  "<td>", topicSlug(s.topic), "</td>",
  "<td class=\"sig-", sigResultClass(s), "\">", sigResultMark(s), "</td>",
  "<td>", intToStr(s.points), "/", intToStr(s.maxPoints), "</td>",
  "<td>", s.ailangFeature, "</td>",
  "</tr>"
])

func renderSignalsHtml(signals: [Signal]) -> string =
  join("\n", map(renderSignalRow, signals))

-- "Why this score" list — at-a-glance summary of the top-topic signals.
func renderWhyLi(s: Signal) -> string =
  "<li class=\"${sigResultClass(s)}\">${s.description}</li>"

func renderWhyHtml(signals: [Signal]) -> string =
  join("\n", map(renderWhyLi, signals))

-- §2 extraction stats — surfaces docparse output below the chips.
-- Shows totals + a small list of top headings if extracted.
func renderHeadingPill(h: string) -> string =
  "<span class=\"sk-chip\" title=\"extracted heading\">${h}</span>"

func renderExtractStats(e: ExtractedContent) -> string = {
  let pathLabel = if e.extractionPath == "docparse" then "via docparse"
                  else if e.extractionPath == "ai-fallback" then "via AI extraction"
                  else "polite refuse";
  let pathClass = if e.extractionPath == "docparse" then "path path-docparse" else "path";
  let headingsHtml = if listLength(e.topHeadings) == 0 then ""
                     else "<div style=\"margin-top:18px;\"><p class=\"sk-section-label\" style=\"margin-bottom:10px;\">structure found</p><div class=\"sk-chips\">${join(" ", map(renderHeadingPill, e.topHeadings))}</div></div>";
  let statsLine = join("", [
    "<div class=\"sk-extract-stats\">",
    "<span class=\"stat\"><span class=\"num\">", intToStr(e.headingCount), "</span> headings</span>",
    "<span class=\"stat\"><span class=\"num\">", intToStr(e.tableCount), "</span> tables</span>",
    "<span class=\"stat\"><span class=\"num\">", intToStr(e.imageCount), "</span> images</span>",
    "<span class=\"", pathClass, "\">", pathLabel, "</span>",
    "</div>"
  ]);
  "${headingsHtml}${statsLine}"
}

-- ─── Radar polygon ────────────────────────────────────────────

-- Three-axis (triangular) radar. Vertices positioned at:
--   agent-ready (top):           (0, -100)
--   privacy     (bottom-right):  (86.6, 50)
--   portable    (bottom-left):  (-86.6, 50)
--
-- For each topic's readiness (0-10), the point sits at readiness/10
-- along the axis. Integer arithmetic only: r = readiness * 10.

func axisXForTopic(t: Topic, r: int) -> int = match t {
  AgentReady => 0,
  Privacy    => (r * 866) / 100,
  Portable   => -(r * 866) / 100
}

func axisYForTopic(t: Topic, r: int) -> int = match t {
  AgentReady => -(r * 10),
  Privacy    => r * 5,
  Portable   => r * 5
}

func scoreForTopic(scores: [TopicScore], t: Topic) -> int = match scores {
  []            => 0,
  [s, ...rest]  => if topicEq(s.topic, t) then s.readiness else scoreForTopic(rest, t)
}

func radarPointFor(scores: [TopicScore], t: Topic) -> string =
  let r = scoreForTopic(scores, t)
  in "${intToStr(axisXForTopic(t, r))},${intToStr(axisYForTopic(t, r))}"

func renderRadarPoints(scores: [TopicScore]) -> string = join(" ", [
  radarPointFor(scores, AgentReady),
  radarPointFor(scores, Privacy),
  radarPointFor(scores, Portable)
])

-- ─── Topic label ──────────────────────────────────────────────

export func topicLabel(t: Topic) -> string = topicSlug(t)

-- ─── Topic-conditional content blocks ─────────────────────────

-- For each conditional section, two flavours: scored (leaderboard
-- topics) and qualitative (compliance/budget/reliable — these can't
-- honestly be measured from a single page fetch).

-- §1 — headline + radar caption
export func renderScoreHeadline(t: Topic, score: int) -> string =
  if topicHasLeaderboard(t) then join("", [
    "<h2>You scored <span class=\"sk-readiness-num\">", intToStr(score), "/10</span> on ", topicLabel(t), ".</h2>",
    "<p>The radar shows AILANG-readiness across six commercial concerns. High means you're already strong in that area; low means AILANG could meaningfully help.</p>"
  ]) else join("", [
    "<h2>", topicLabel(t), " isn't scored from a single page fetch.</h2>",
    "<p>Audit trails, AI spend control, and runtime agent reliability aren't visible on a marketing page. The cards below show where AILANG would help — chosen on what we see, not graded.</p>"
  ])

-- §1 — "Why this score" callout. Empty for non-leaderboard topics.
export func renderWhyBlock(t: Topic, whySignalsHtml: string, score: int) -> string =
  if topicHasLeaderboard(t) then join("", [
    "<div class=\"sk-why\">",
    "<strong>Why ", topicLabel(t), " scored ", intToStr(score), "/10</strong>",
    "<ul>", whySignalsHtml, "</ul>",
    "<p style=\"margin: 10px 0 0;\"><a href=\"#sk-breakdown\">Full breakdown ↓</a> · <a href=\"https://github.com/sunholo-data/ailang-demos/blob/main/linkedin/design/scoring-rubric.md\">View rubric ↗</a></p>",
    "</div>"
  ]) else ""

-- §3 — pretext sentence above the AILANG-feature cards.
export func renderScorePretext(t: Topic, score: int) -> string =
  if topicHasLeaderboard(t) then join("", [
    "<p class=\"sk-score-pretext\">You scored <strong>", intToStr(score), "/10</strong> on ", topicLabel(t),
    ". AILANG opportunity is therefore <strong>", intToStr(10 - score), "/10</strong>. Here's where it would land first.</p>"
  ]) else join("", [
    "<p class=\"sk-score-pretext\">", topicLabel(t), " isn't scored from a single page fetch — see §1 for why. The cards below are the AILANG features that would help your kind of business.</p>"
  ])

-- ─── Rank block (optional) ────────────────────────────────────

func renderRankBlock(t: Topic, rank: int) -> string =
  if topicHasLeaderboard(t) then join("", [
    "<div class=\"sk-rank-callout\">",
    "<span>Your rank on the ", topicLabel(t), " leaderboard:</span>",
    "<span class=\"rank-num\">#", intToStr(rank), "</span>",
    -- Relative to the sketch page (linkedin/topics/<topic>/<slug>/).
    -- The topic page is one level up.
    "<a href=\"../\">view leaderboard ↗</a>",
    "</div>"
  ]) else ""

-- ─── Top-level renderer ───────────────────────────────────────

-- Render a Sketch into a complete HTML page string.
-- The `rank` arg is the commenter's current position on the topic's
-- leaderboard (0 if unranked or no leaderboard for this topic).
-- The `avatarAngle` is a hash-derived integer in 0..360 for the
-- conic-gradient avatar — caller computes it from avatarSeed.
export func sketchRenderHtml(
  sketch: Sketch,
  rank: int,
  avatarAngle: int,
  templatePath: string
) -> string ! {FS} {
  let template = readFile(templatePath);
  let scores = sketch.scores;
  let topic = sketch.topic;
  let extracted = sketch.extracted;

  let topicReadiness  = scoreForTopic(scores, topic);
  let topicOpp        = 10 - topicReadiness;
  let chipsHtml       = renderChipsHtml(extracted.entities);
  let cardsHtml       = renderCardsHtml(sketch.featureCards);
  let signalsHtml     = renderSignalsHtml(signalsFromScores(scores));
  let whySignalsHtml  = renderWhyHtml(whySignalsForTopic(scores, topic));
  let radarPoints     = renderRadarPoints(scores);
  let rankBlockHtml   = renderRankBlock(topic, rank);

  let ogSummary = if topicHasLeaderboard(topic)
                  then "AI-readiness ${intToStr(topicReadiness)}/10"
                  else "qualitative AILANG fit (this topic isn't scored from a single page fetch)";
  replaceMany(template, [
    ("{{DOMAIN}}",              sketch.registrableDomain),
    ("{{TOPIC_LABEL}}",         topicLabel(topic)),
    ("{{TOPIC_SLUG}}",          topicSlug(topic)),
    ("{{INITIALS}}",            sketch.initials),
    ("{{AVATAR_ANGLE}}",        intToStr(avatarAngle)),
    ("{{GENERATED_AT}}",        sketch.generatedAt),
    ("{{RADAR_POINTS}}",        radarPoints),
    ("{{RANK_BLOCK_HTML}}",     rankBlockHtml),
    ("{{SCORE_HEADLINE_HTML}}", renderScoreHeadline(topic, topicReadiness)),
    ("{{WHY_BLOCK_HTML}}",      renderWhyBlock(topic, whySignalsHtml, topicReadiness)),
    ("{{SCORE_PRETEXT_HTML}}",  renderScorePretext(topic, topicReadiness)),
    ("{{NARRATIVE_HEADLINE}}",  extracted.audience),
    ("{{NARRATIVE_BODY}}",      extracted.narrative),
    ("{{CHIPS_HTML}}",          chipsHtml),
    ("{{EXTRACT_STATS_HTML}}",  renderExtractStats(extracted)),
    ("{{CARDS_HTML}}",          cardsHtml),
    ("{{SIGNALS_HTML}}",        signalsHtml),
    ("{{OG_SUMMARY}}",          ogSummary)
  ])
}

-- ─── Helpers for collecting signals ───────────────────────────

-- Flatten all signals across all topic scores (for the full breakdown).
func signalsFromScores(scores: [TopicScore]) -> [Signal] = match scores {
  []            => [],
  [s, ...rest]  => listConcat(s.signals, signalsFromScores(rest))
}

-- Signals for the "why this score" callout — just the asked-for topic.
func whySignalsForTopic(scores: [TopicScore], t: Topic) -> [Signal] = match scores {
  []            => [],
  [s, ...rest]  => if topicEq(s.topic, t) then s.signals else whySignalsForTopic(rest, t)
}
