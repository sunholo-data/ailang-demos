module linkedin/services/sketch_dispatch

-- Dispatch sketches from the queue, respecting a daily budget.
--
-- For each queued request, run sketchSite in-process. Each call's
-- effect signature is ! {Net @limit=1, AI @limit=5, FS @limit=4,
-- Process, Declassify}, multiplied by `maxPerRun` requests this run.
--
-- Successfully-processed entries are removed from the queue. Unsent
-- entries (because the daily budget was reached) remain for the next
-- cron tick.
--
-- For V1 the budget is the only gate; the monthly per-domain limit
-- is documented in linkedin/design/sketches.md §6.6 and will land
-- in V2 when sketch_history.json is wired in.

import std/io (println)
import std/fs (readFile, writeFile, fileExists, mkdirAll)
import std/string (length, intToStr, replace)
import std/list (length as listLength, foldl, concat as listConcat)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/json (decode, getString, getInt)
import linkedin/types/sketch_types (SketchRequest, Topic)
import linkedin/services/sketch (sketchSite, sketchRegistrableDomain)
import linkedin/services/sketch_template (topicSlug)
import linkedin/services/sketch_queue (sketchQueueRead, sketchQueueWrite)
import linkedin/services/sketch_history (HistoryEntry, sketchHistoryRead, sketchHistoryWrite, sketchHistoryAppend, sketchHistoryHasDomainTopicSince, sketchHistoryCountForSeedOnDay)

-- ─── Budget state ────────────────────────────────────────────

export type SketchBudget = {
  date:     string,
  count:    int,
  dailyMax: int
}

func budgetPath() -> string = "linkedin/data/sketch_budget.json"

-- Global daily cap across all commenters. Hard ceiling on AI spend.
func defaultDailyMax() -> int = 50

-- Per-commenter daily cap. Encourages comments while preventing one
-- person dominating the queue.
export func perCommenterDailyMax() -> int = 20

func escapeJsonString(s: string) -> string =
  replace(replace(s, "\\", "\\\\"), "\"", "\\\"")

func budgetToJson(b: SketchBudget) -> string =
  "{\"date\":\"${escapeJsonString(b.date)}\",\"count\":${intToStr(b.count)},\"dailyMax\":${intToStr(b.dailyMax)}}"

-- Read the budget file. If missing or for a different day, reset.
export func sketchBudgetRead(today: string) -> SketchBudget ! {FS} {
  if fileExists(budgetPath()) then
    match decode(readFile(budgetPath())) {
      Ok(j) => {
        let savedDate = getOrElse(getString(j, "date"), "");
        let savedCount = getOrElse(getInt(j, "count"), 0);
        let savedMax = getOrElse(getInt(j, "dailyMax"), defaultDailyMax());
        if savedDate == today then
          { date: today, count: savedCount, dailyMax: savedMax }
        else
          { date: today, count: 0, dailyMax: savedMax }
      },
      Err(_) => { date: today, count: 0, dailyMax: defaultDailyMax() }
    }
  else { date: today, count: 0, dailyMax: defaultDailyMax() }
}

export func sketchBudgetWrite(b: SketchBudget) -> () ! {FS} {
  mkdirAll("linkedin/data");
  writeFile(budgetPath(), budgetToJson(b))
}

-- ─── Dispatch one request ────────────────────────────────────

-- Per-call outcome — used by processN to decide whether to keep
-- the entry in the queue or drop it, and what message to surface.
type OneOutcome = {
  ok: bool,           -- did we run the executor?
  history: HistoryEntry  -- only meaningful when ok=true
}

-- Try to dispatch a single queue entry, consulting history.
-- Returns ok=false if either limit was hit; the caller logs the reason.
func dispatchOne(
  r: SketchRequest,
  today: string,
  cutoff: string,
  templatePath: string,
  history: [HistoryEntry]
) -> OneOutcome ! {IO, Net, FS, AI, Process} {
  let domain = sketchRegistrableDomain(r.url);
  let topic  = topicSlug(r.topic);
  let entry: HistoryEntry = { avatarSeed: r.avatarSeed, domain: domain, topic: topic, dispatchedAt: today };
  let skippedOutcome: OneOutcome = { ok: false, history: entry };
  let okOutcome:      OneOutcome = { ok: true,  history: entry };
  if sketchHistoryHasDomainTopicSince(history, domain, topic, cutoff) then {
    println("  ✗ skip ${domain} #${topic} — already sketched in the last 30 days");
    skippedOutcome
  } else {
    let count = sketchHistoryCountForSeedOnDay(history, r.avatarSeed, today);
    if count >= perCommenterDailyMax() then {
      println("  ✗ skip ${r.initials} (${r.avatarSeed}) — daily quota met (${intToStr(count)}/${intToStr(perCommenterDailyMax())}). Get in touch (mark@aitanalabs.com) if you'd like a higher allowance.");
      skippedOutcome
    } else {
      println("→ dispatch ${r.url} #${topic} (${r.initials})  [today ${intToStr(count + 1)}/${intToStr(perCommenterDailyMax())} for ${r.avatarSeed}]");
      let _ = sketchSite(r.url, r.topic, r.initials, r.avatarSeed, today, 0, templatePath);
      okOutcome
    }
  }
}

-- ─── Top-level dispatch ──────────────────────────────────────

-- Process the queue, dispatching up to `dailyMax - count` requests.
-- Returns the number of dispatches actually performed.
-- cutoff is the inclusive lower bound on the 30-day window
-- (e.g. for today=2026-05-13 the cutoff is "2026-04-13").
export func sketchDispatch(today: string, cutoff: string, templatePath: string) -> int ! {IO, Net, FS, AI, Process} {
  let queue   = sketchQueueRead("linkedin/data/sketch_queue.json");
  let budget  = sketchBudgetRead(today);
  let history = sketchHistoryRead();
  let allowed = budget.dailyMax - budget.count;
  if listLength(queue) == 0 then {
    println("dispatch: queue empty");
    0
  } else if allowed <= 0 then {
    println("dispatch: global daily budget exhausted (${intToStr(budget.count)}/${intToStr(budget.dailyMax)})");
    0
  } else {
    println("dispatch: ${intToStr(listLength(queue))} queued, global budget ${intToStr(allowed)} remaining, monthly cutoff ${cutoff}");
    let result = processN(queue, allowed, today, cutoff, templatePath, history, []);
    sketchQueueWrite("linkedin/data/sketch_queue.json", result.leftover);
    sketchBudgetWrite({ date: today, count: budget.count + result.consumed, dailyMax: budget.dailyMax });
    sketchHistoryWrite(result.history);
    println("dispatch: ${intToStr(result.consumed)} done, ${intToStr(listLength(result.leftover))} still queued (skipped entries are removed)");
    result.consumed
  }
}

-- Recursive helper outcome: consumed count, queue tail to persist,
-- and updated history (with appends from each successful dispatch).
type DispatchOutcome = {
  consumed: int,
  leftover: [SketchRequest],
  history:  [HistoryEntry]
}

-- Drain up to `allowed` entries from the queue, threading the
-- history through each iteration so quota checks see appends made
-- by earlier iterations in the same run.
func processN(
  queue: [SketchRequest],
  allowed: int,
  today: string,
  cutoff: string,
  templatePath: string,
  history: [HistoryEntry],
  acc: [SketchRequest]
) -> DispatchOutcome ! {IO, Net, FS, AI, Process} {
  if allowed <= 0 then
    { consumed: 0, leftover: listConcat(acc, queue), history: history }
  else match queue {
    []           => { consumed: 0, leftover: acc, history: history },
    [r, ...rest] => {
      let outcome = dispatchOne(r, today, cutoff, templatePath, history);
      if outcome.ok then {
        let newHistory = sketchHistoryAppend(history, outcome.history);
        let tail = processN(rest, allowed - 1, today, cutoff, templatePath, newHistory, acc);
        { consumed: 1 + tail.consumed, leftover: tail.leftover, history: tail.history }
      } else {
        -- Skipped (history or quota). Drop from queue silently; the
        -- log line printed by dispatchOne already says why.
        processN(rest, allowed, today, cutoff, templatePath, history, acc)
      }
    }
  }
}
