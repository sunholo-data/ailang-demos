module linkedin/services/sketch_features

-- Topic-keyed feature bank for the sketch deep-dive section.
--
-- Each topic returns a list of candidate FeatureCards. The
-- executor picks 3 for the rendered sketch; domain-specific
-- tailoring (ecommerce vs SaaS vs content vs etc) refines which
-- concrete code example appears in each card. For V1 the
-- examples are domain-agnostic; domain templating comes later.
--
-- Rule (per design doc §6.5): every card must demonstrate a
-- real AILANG primitive a reader could adopt — no aspirational
-- features, no judgement calls about things AILANG doesn't cover.

import linkedin/types/sketch_types (FeatureCard, Topic, Compliance, Budget, Privacy, Reliable, Portable, AgentReady, General)

-- Card constructor helper
func mkCard(feature: string, rationale: string, code: string) -> FeatureCard = {
  feature: feature,
  rationale: rationale,
  code: code
}

-- Compliance & audit — contracts, traces, capability declarations, IFC labels.
export func sketchComplianceCards() -> [FeatureCard] = [
  mkCard(
    "Contracts as documented limitations",
    "Article 13 of the EU AI Act requires documented limitations. AILANG contracts are those limitations, enforced at compile time and verified by Z3.",
    "func decideLoan(applicant: Applicant) -> Decision\n  requires { applicant.age >= 18, applicant.income > 0 }\n  ensures  { result.score >= 0, result.score <= 100 }"
  ),
  mkCard(
    "OpenTelemetry traces as audit trail",
    "Every effectful call emits an OTLP span. Action-layer audit replaces \"the model said it didn't do X\" with a span tree you can subpoena.",
    "-- One env var enables traces to Cloud Trace / Honeycomb / Grafana\n--   OTEL_EXPORTER_OTLP_ENDPOINT=https://...\n-- Every Net, FS, AI call appears in the trace, automatically."
  ),
  mkCard(
    "Capability declarations as scope of authority",
    "The CLI flag --caps grants scope. The function signature declares what's allowed. Anything outside the intersection is a refusal, not a request.",
    "ailang run --caps Net,FS --caps-budget Net=10 \\\n  decide_loan.ail \\\n  -- function with ! {Net @limit=10, FS} runs;\n  -- a function trying to also use DB is rejected."
  ),
  mkCard(
    "IFC labels as data-category documentation",
    "Mark inputs as string<pii>. The compiler tracks where labelled data flows. Crossing into a public context requires an explicit Declassify effect.",
    "func summariseApplicant(a: Applicant) -> string\n  ! {AI, Declassify}\n  -- the Declassify effect is visible on every caller up the chain"
  )
]

-- AI spend you can predict — capability budgets, prompt caching, cheap routing, arbitrage.
export func sketchBudgetCards() -> [FeatureCard] = [
  mkCard(
    "Capability budgets in the type",
    "A budget is part of the function signature. The runtime counts. A retry storm that goes over budget is a crash, not a silent five-figure invoice.",
    "func answerQuery(q: string) -> string\n  ! {AI @limit=3, Net @limit=2}\n  -- three AI calls, two network calls. Anything more is a runtime refusal."
  ),
  mkCard(
    "Cross-provider prompt caching",
    "One cacheHint marker maps to whichever caching primitive each provider exposes. The cost meter drops by the provider's native discount. The code doesn't change when you switch.",
    "let system = cacheHint(longInstructions);\n-- Anthropic emits cache_control;\n-- Google promotes to CachedContent;\n-- OpenAI applies its implicit-threshold path."
  ),
  mkCard(
    "Eval-driven cheap-model routing",
    "Run your tasks against every provider; the eval harness shows which model gives you the best AILANG-correctness for the budget. Cheap models for cheap tasks, by evidence.",
    "ailang eval --task classify-intent \\\n  --models gemini-2.5-flash,gpt-5.1-nano,claude-haiku-4-5 \\\n  --budget 0.01\n-- Picks the lowest-cost model that scored >=95%."
  )
]

-- Privacy & data sovereignty — IFC labels, capability scoping, WASM-local, three-runtime.
export func sketchPrivacyCards() -> [FeatureCard] = [
  mkCard(
    "Information-flow labels on customer data",
    "Mark fields containing PII at the type level. The compiler refuses to let a labelled value reach a public sink without an explicit Declassify boundary. Privacy by type, not by code review.",
    "type Customer = {\n  email:    string<pii>,\n  postcode: string<pii>,\n  signupDate: string\n}\n-- assigning customer.email to a log line is a type error."
  ),
  mkCard(
    "Capability scoping",
    "A function declares the network endpoints, file paths, and AI providers it touches. Anything outside the declaration is rejected by the runtime. \"This part of the system can talk to Stripe; it cannot talk to anyone else\" is enforced.",
    "func chargeCard(c: Card) -> Result[Receipt, Error]\n  ! {Net @endpoint=\"api.stripe.com\", AI @limit=0}"
  ),
  mkCard(
    "Three-runtime deploy",
    "The same module runs in the browser via WASM, on Cloud Run, and as a native binary. Sensitive workflows can stay in the user's tab — no server ever sees the data.",
    "-- Browser: load AILANG WASM, run the module in the user's tab.\n-- Cloud Run: same .ail file packaged as a container.\n-- Native CLI: same .ail file, ailang run."
  )
]

-- Production-grade agents — capability boundaries, contracts + Z3, fewer-ways-wrong, eval.
export func sketchReliableCards() -> [FeatureCard] = [
  mkCard(
    "Capability boundaries that contain the agent",
    "An agent that can read the database cannot, with the same grant, drop it. The two operations live in different effect rows. A misbehaving agent cannot escape what its signature declared.",
    "func searchOrders(q: string) -> [Order]\n  ! {Net @endpoint=\"db.read\"}\n  -- a DROP TABLE call has the wrong effect signature."
  ),
  mkCard(
    "Contracts proven by Z3",
    "Every requires/ensures clause is verified by Z3 at compile time. Bounds, invariants, refusal conditions — not advisory comments, mathematical proofs.",
    "func discount(price: float, percent: float) -> float\n  requires { percent >= 0.0, percent <= 100.0 }\n  ensures  { result >= 0.0, result <= price }"
  ),
  mkCard(
    "Fewer ways to go wrong",
    "No loops, only pattern matching. No global state. One way to handle errors (Result). The probability distribution an LLM samples from is narrower because the language is narrower. Same prompt, same code.",
    "match parseInput(s) {\n  Ok(value)  => process(value),\n  Err(reason) => logRefusal(reason)\n}\n-- there is no \"forgot to handle the error\" path."
  )
]

-- Vendor independence — std/ai multi-provider, OpenRouter, structured output, caching.
export func sketchPortableCards() -> [FeatureCard] = [
  mkCard(
    "One std/ai, five LLM vendors",
    "The same call() function runs against Anthropic, Google, OpenAI, OpenRouter, or local Ollama. Switch providers with a one-character diff, not a refactor.",
    "let answer = call(\n  prompt = userQuery,\n  model  = \"claude-haiku-4-5\"\n  -- model = \"gemini-2.5-flash\" — also works\n  -- model = \"gpt-5.1-nano\"     — also works\n);"
  ),
  mkCard(
    "Structured output, portable across providers",
    "callJson(prompt, schema) maps to each provider's native structured-output primitive — responseSchema for Gemini, response_format for OpenAI, forced-tool for Anthropic. Your schema, their plumbing.",
    "let result = callJson(prompt, intentSchema);\n-- same AILANG code, four different provider paths underneath."
  ),
  mkCard(
    "OpenRouter routing with replayable resolution",
    "Reach SOTA open-source models through OpenRouter; the resolved model ID is logged so the eval is replayable months later, even if the upstream router has moved on.",
    "call(prompt, model = \"openrouter/meta-llama/llama-4-405b\");\n-- the eval harness pins the exact resolved model ID."
  )
]

-- Agent-ready website — serve-api MCP/A2A/OpenAPI, contract-verified tools, feedback.
export func sketchAgentReadyCards() -> [FeatureCard] = [
  mkCard(
    "REST + MCP + A2A + OpenAPI in one command",
    "ailang serve-api takes your typed AILANG functions and exposes them as REST endpoints, MCP tools, A2A skills, and OpenAPI 3.1 docs simultaneously. One module, four agent surfaces.",
    "ailang serve-api --port 8092 --mcp-http \\\n  pricing.ail catalogue.ail\n-- POST /api/pricing/quote, MCP at /mcp/,\n-- A2A at /.well-known/agent.json, OpenAPI at /api/_meta/redoc."
  ),
  mkCard(
    "Contract-verified tool calls",
    "Every tool an agent can call has a contract. Bounds, refusal paths, type signatures — proven before the agent ever sees it. The agent cannot exceed the tool's declared authority.",
    "func placeOrder(item: SKU, qty: int) -> Receipt\n  requires { qty > 0, qty <= 10 }\n  ensures  { result.total > 0.0 }\n-- the MCP server exposes this with its contract intact."
  ),
  mkCard(
    "An MCP server for your own docs and tools",
    "Generate an MCP server from your typed AILANG functions; the docs MCP exposes a submit_feedback tool so agents can flag issues back to the maintainer. The language and its consumers stay on the same wire.",
    "-- The AILANG docs MCP server lets Claude / Cursor / any\n-- MCP client query the language directly:\n--   stdlib_search \"URL encoding\"\n--   submit_feedback \"...\""
  )
]

-- Top-level dispatch — used by the executor to pick cards.
export func sketchCardsForTopic(t: Topic) -> [FeatureCard] = match t {
  Compliance  => sketchComplianceCards(),
  Budget      => sketchBudgetCards(),
  Privacy     => sketchPrivacyCards(),
  Reliable    => sketchReliableCards(),
  Portable    => sketchPortableCards(),
  AgentReady  => sketchAgentReadyCards(),
  General     => sketchAgentReadyCards()
}
