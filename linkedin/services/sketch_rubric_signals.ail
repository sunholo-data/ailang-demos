module linkedin/services/sketch_rubric_signals

-- Static signal registry for the sketch rubric.
--
-- Each function returns a "template" Signal record describing what
-- the signal measures, which topic it scores, its max-point
-- contribution, and the AILANG primitive it maps to. The detection
-- logic itself lives in sketch_rubric.ail, which uses these
-- templates and fills in `detected` + `points` from the fetched
-- page content.
--
-- Hard rule (per design doc §6.5): every signal here must map to
-- an AILANG primitive a reader could adopt. Generic AI-readiness
-- markers (llms.txt, robots.txt, JSON-LD, etc.) are not measured.

import linkedin/types/sketch_types (Signal, AgentReady, Privacy, Portable)

-- ─── agent-ready signals ───────────────────────────────────────

export func sigAgentJson() -> Signal = {
  name:          "agent.json referenced",
  description:   "Page references /.well-known/agent.json — the A2A agent card discovery endpoint.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "ailang serve-api generates A2A agent cards automatically"
}

export func sigOpenApi() -> Signal = {
  name:          "openapi.json referenced",
  description:   "Page references /openapi.json, /openapi.yaml, or an OpenAPI schema URL.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "ailang serve-api generates OpenAPI 3.1 from Hindley-Milner type signatures"
}

export func sigMcpEndpoint() -> Signal = {
  name:          "MCP endpoint referenced",
  description:   "Page references an MCP endpoint such as /mcp/ or /mcp/sse.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "ailang serve-api --mcp-http exposes typed functions as MCP tools"
}

export func sigApiDocsLink() -> Signal = {
  name:          "Public API docs linked",
  description:   "Page links to public API documentation, Swagger UI, or ReDoc.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "ailang serve-api hosts Swagger + ReDoc at /api/_meta/ by default"
}

export func sigWebhooks() -> Signal = {
  name:          "Webhooks documented",
  description:   "Page mentions webhooks, callback URLs, or event subscriptions — the most agent-callable backend pattern.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "ailang serve-api handles webhooks as typed handler functions with effect-tracked side effects"
}

export func sigRateLimitDocs() -> Signal = {
  name:          "Rate limits documented",
  description:   "Page documents rate limits, throttling, or 429 handling — agents need to know how to back off.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "Capability budgets — Net @limit=N is the symmetric server-side primitive for what agents see as rate limits"
}

export func sigStreamingEndpoint() -> Signal = {
  name:          "Streaming / SSE endpoint",
  description:   "Page references Server-Sent Events, text/event-stream, or a streaming endpoint — agents that read incrementally land here.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "std/stream — ssePost and Stream effect handle event-source endpoints with typed event types"
}

export func sigSandboxOffered() -> Signal = {
  name:          "Sandbox / test environment offered",
  description:   "Page mentions a sandbox, test mode, or test environment — lets agents practise against fake state before touching production.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "ailang --ai-stub plus mock effect handlers — deterministic, capability-scoped fakes for any effect, including Net and AI"
}

export func sigAuthDocumented() -> Signal = {
  name:          "Authentication documented",
  description:   "Page documents OAuth, JWT, bearer tokens, API keys, or access tokens — agents can't call the API without knowing how to authenticate.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "std/jwt for verification, IFC labels (string<api-key> / string<token>) to keep credentials out of public sinks at the type level"
}

export func sigIdempotency() -> Signal = {
  name:          "Idempotency keys documented",
  description:   "Page mentions idempotency, idempotency-key, or idempotent requests — agents need this to retry safely.",
  topic:         AgentReady,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "Pure functions are idempotent by construction; requires/ensures contracts express idempotence as a static guarantee"
}

-- ─── privacy signals ───────────────────────────────────────────

export func sigLlmProviderMentioned() -> Signal = {
  name:          "Named LLM provider mentioned",
  description:   "Page copy or scripts mention Claude / GPT / Gemini / Anthropic / OpenAI — indicates data flowing to a third-party LLM service.",
  topic:         Privacy,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "std/ai + IFC labels — track and declassify customer data crossing the provider boundary"
}

export func sigThirdPartyDomains() -> Signal = {
  name:          "Third-party domains restrained",
  description:   "Fewer than 5 distinct external script/image domains — indicates fewer third-party data flows.",
  topic:         Privacy,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "Capability scoping — each Net call declares its endpoint in the effect row"
}

export func sigDataResidencyLanguage() -> Signal = {
  name:          "Data residency / on-prem language",
  description:   "Page mentions EU hosting, data residency, on-premises deployment, or sovereign cloud.",
  topic:         Privacy,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "Three-runtime deploy — same module runs in WASM (browser), Cloud Run, and native CLI"
}

-- ─── portable signals ──────────────────────────────────────────

export func sigSingleVendorLlm() -> Signal = {
  name:          "Single-vendor LLM language",
  description:   "Page copy that names one specific LLM provider (e.g. \"powered by Claude\") without portability claims.",
  topic:         Portable,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "std/ai multi-provider — switch from Anthropic to Gemini to OpenAI without rewriting"
}

export func sigMultiProviderMentioned() -> Signal = {
  name:          "Multiple AI providers cited",
  description:   "Body mentions two or more named AI providers (Claude, GPT, Gemini, Mistral, Llama, etc.) — already vendor-multi.",
  topic:         Portable,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "std/ai — one Step API across Anthropic, OpenAI, Gemini, OpenRouter, Ollama, and custom-package providers"
}

export func sigCrossRuntimeClaim() -> Signal = {
  name:          "Cross-runtime / deployment portability",
  description:   "Body mentions self-hosted, on-prem, WASM, Docker, Kubernetes, or \"deploy anywhere\" — runtime portability claimed.",
  topic:         Portable,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "Effect handlers as runtime adapters — same .ail runs as WASM in the browser, a Cloud Run container, and a native CLI; only the handlers change"
}

export func sigByoKey() -> Signal = {
  name:          "BYO key / model-agnostic",
  description:   "Body mentions \"bring your own key\", \"BYOK\", \"any LLM\", or \"model-agnostic\" — caller controls the model.",
  topic:         Portable,
  points:        0,
  maxPoints:     2,
  detected:      false,
  ailangFeature: "AILANG WASM — the full interpreter ships as a browser bundle, so caller-held keys (BYOK), offline apps, and embedded demos all work client-side"
}

-- ─── registry — all V1 signals in one list ─────────────────────

export func sketchAllSignalDefs() -> [Signal] = [
  sigAgentJson(),
  sigOpenApi(),
  sigMcpEndpoint(),
  sigApiDocsLink(),
  sigWebhooks(),
  sigRateLimitDocs(),
  sigStreamingEndpoint(),
  sigSandboxOffered(),
  sigAuthDocumented(),
  sigIdempotency(),
  sigLlmProviderMentioned(),
  sigThirdPartyDomains(),
  sigDataResidencyLanguage(),
  sigSingleVendorLlm(),
  sigMultiProviderMentioned(),
  sigCrossRuntimeClaim(),
  sigByoKey()
]
