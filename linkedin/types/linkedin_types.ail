module linkedin/types/linkedin_types

-- Demo-only types. The wire-level types (LinkedInCreds, PostResult,
-- LinkedInComment) now live in the sunholo/linkedin registry package
-- alongside the modules that produce them. What stays here:
--
--   - MarketingPost — loaded from `marketing/<slug>/post.md` on disk. The
--     content-loader's concern, demo-specific.
--   - PostState     — the row shape of `linkedin/data/state.json`. The demo
--     persists this; the package consumes [string] URNs and doesn't care
--     about the slug/publishedAt fields.

export type MarketingPost = {
  slug: string,
  title: string,
  body: string,
  link: string,
  hashtags: string,
  -- Optional image attachment. `image` is a repo-relative path; empty
  -- string means "text-only post". `imageAlt` is required by LinkedIn
  -- for accessibility when an image is attached.
  image: string,
  imageAlt: string
}

export type PostState = {
  slug: string,
  postUrn: string,
  publishedAt: string
}
