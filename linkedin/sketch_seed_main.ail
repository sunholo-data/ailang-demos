module linkedin/sketch_seed_main

-- CLI entry: seed the leaderboards with a hand-curated list of
-- (url, topic) pairs. Bypasses the queue/dispatcher entirely — no
-- LinkedIn API calls, no per-commenter quota, no 30-day history
-- check. Calls sketchSite directly for each entry, then rebuilds
-- the three leaderboards.
--
-- All seeded entries carry a single shared identity ("AI" /
-- avatar seed "e73c17", the AILANG coral) so seeded sketches are
-- visually distinguishable from real reader submissions.
--
-- Argv:
--   1. today — date string for the snapshot header, default "today"

import std/io (println)
import std/env (getArgs)
import std/string (intToStr)
import std/list (length as listLength, nth, concat as listConcat)
import std/string (stringToInt)
import std/option (Some, None)
import linkedin/types/sketch_types (Topic, AgentReady, Privacy, Portable)
import linkedin/services/sketch (sketchSite)
import linkedin/services/sketch_leaderboard (sketchRebuildTopic)

func argOr(args: [string], i: int, fallback: string) -> string =
  match nth(args, i) {
    Some(v) => v,
    None    => fallback
  }

func templatePath() -> string = "linkedin/templates/sketch.html"
func seedInitials() -> string = "AI"
func seedAvatarSeed() -> string = "e73c17"

-- ─── Seed list ────────────────────────────────────────────────
-- 30 European/Nordic commercial targets, deeper-than-homepage paths.

type SeedEntry = { url: string, topic: Topic }

func seeds() -> [SeedEntry] = [
  -- agent-ready: developer portals, API docs
  { url: "https://docs.adyen.com/development-resources/api-credentials/",       topic: AgentReady },
  { url: "https://developer.spotify.com/documentation/web-api",                  topic: AgentReady },
  -- pleo.io has no public developer portal — /en/developers, /en/security,
  -- /en/trust-center all 404. Best public-facing agent-relevant page is
  -- the integrations list. (Previously seeded against 404 pages —
  -- sketchFetch now refuses non-2xx so that mistake is unrepeatable.)
  { url: "https://www.pleo.io/en/integrations",                                   topic: AgentReady },
  { url: "https://docs.mollie.com/reference/v2/payments-api/create-payment",     topic: AgentReady },
  { url: "https://docs.klarna.com/api/",                                         topic: AgentReady },
  { url: "https://doc.bunq.com/",                                                topic: AgentReady },
  { url: "https://developer.gocardless.com/api-reference",                       topic: AgentReady },
  { url: "https://developers.mews.com/",                                         topic: AgentReady },
  -- documentation-data.trustpilot.com refused our curl probe (000) and
  -- the new skip-on-no-content policy drops it cleanly if AILANG also
  -- can't reach it. developers.trustpilot.com is their canonical
  -- developer portal entry (200).
  { url: "https://developers.trustpilot.com/",                                   topic: AgentReady },
  { url: "https://developers.tradeshift.com/docs/quickstart",                    topic: AgentReady },
  -- privacy: trust/security pages, data-residency language
  -- proton.me/business/data-privacy 404s; /legal/privacy is the real
  -- public privacy policy page (200).
  { url: "https://proton.me/legal/privacy",                                      topic: Privacy },
  { url: "https://tuta.com/security",                                            topic: Privacy },
  { url: "https://nextcloud.com/security/",                                      topic: Privacy },
  { url: "https://mistral.ai/terms",                                             topic: Privacy },
  { url: "https://mailfence.com/en/about",                                       topic: Privacy },
  -- siteimprove.com/glossary/data-privacy/ 404s; /privacy/ is their
  -- actual public privacy-policy page (200).
  { url: "https://www.siteimprove.com/privacy/",                                 topic: Privacy },
  -- pleo.io privacy/security pages 404; using the legal landing page
  -- which is their consolidated privacy/terms entry point.
  { url: "https://www.pleo.io/en/legal",                                          topic: Privacy },
  { url: "https://weaviate.io/security",                                         topic: Privacy },
  -- posit.co/about/security/ 404s; /about/ is the canonical company
  -- page covering values/governance (200).
  { url: "https://posit.co/about/",                                              topic: Privacy },
  { url: "https://handbook.gitlab.com/handbook/security/",                       topic: Privacy },
  -- portable: multi-runtime, self-host, multi-provider
  { url: "https://developer.hashicorp.com/terraform/intro",                      topic: Portable },
  { url: "https://supabase.com/docs/guides/self-hosting",                        topic: Portable },
  { url: "https://docs.n8n.io/hosting/",                                         topic: Portable },
  { url: "https://www.langchain.com/langchain",                                  topic: Portable },
  { url: "https://weaviate.io/developers/weaviate",                              topic: Portable },
  { url: "https://mistral.ai/technology",                                        topic: Portable },
  { url: "https://huggingface.co/docs/inference-providers/en/index",             topic: Portable },
  { url: "https://about.gitlab.com/install/",                                    topic: Portable },
  { url: "https://posit.co/products/open-source/rstudio/",                       topic: Portable },
  { url: "https://docs.nextcloud.com/server/latest/admin_manual/installation/",  topic: Portable },
  -- agent-ready protocol exemplars — these implement the very signals
  -- the rubric measures, so they should pin near the top of the board
  -- and serve as "what a 10/10 looks like" anchors.
  { url: "https://docs.cdp.coinbase.com/x402/welcome",                            topic: AgentReady },
  { url: "https://ap2-protocol.org/",                                             topic: AgentReady },
  { url: "https://docs.ag-ui.com/introduction",                                   topic: AgentReady },
  { url: "https://www.utcp.io/",                                                  topic: AgentReady },
  { url: "https://developers.cloudflare.com/agents/agentic-payments/",            topic: AgentReady },
  { url: "https://blog.cloudflare.com/x402/",                                     topic: AgentReady }
]

-- ─── Run a single seed ───────────────────────────────────────

func runSeed(s: SeedEntry, today: string) -> () ! {IO, Net, FS, AI, Process} {
  let _ = sketchSite(
    s.url,
    s.topic,
    seedInitials(),
    seedAvatarSeed(),
    today,
    0,
    templatePath()
  );
  ()
}

func runAll(xs: [SeedEntry], today: string, pos: int, total: int) -> () ! {IO, Net, FS, AI, Process} {
  match xs {
    []           => (),
    [s, ...rest] => {
      println("");
      println("──────── seed ${intToStr(pos)}/${intToStr(total)} ────────");
      runSeed(s, today);
      runAll(rest, today, pos + 1, total)
    }
  }
}

-- Take a slice [start, end) from a list. Memory-safe batching: each
-- ailang run process can handle a small batch, exit, and free RAM.
func sliceList(xs: [SeedEntry], start: int, end: int) -> [SeedEntry] =
  takeUntil(dropN(xs, start), end - start)

func dropN(xs: [SeedEntry], n: int) -> [SeedEntry] =
  if n <= 0 then xs
  else match xs {
    []           => [],
    [_, ...rest] => dropN(rest, n - 1)
  }

func takeUntil(xs: [SeedEntry], n: int) -> [SeedEntry] =
  if n <= 0 then []
  else match xs {
    []           => [],
    [x, ...rest] => listConcat([x], takeUntil(rest, n - 1))
  }

export func main() -> () ! {IO, Env, Net, FS, AI, Process} {
  let args = getArgs();
  let today = argOr(args, 0, "today");
  let allSeeds = seeds();
  let totalAll = listLength(allSeeds);
  -- Optional argv[1]=start, argv[2]=end for memory-safe batching.
  -- Default: run all 30.
  let startStr = argOr(args, 1, "0");
  let endStr   = argOr(args, 2, intToStr(totalAll));
  let start = match stringToInt(startStr) { Some(n) => n, None => 0 };
  let end   = match stringToInt(endStr)   { Some(n) => n, None => totalAll };
  let list = sliceList(allSeeds, start, end);
  let total = listLength(list);
  println("Seeding ${intToStr(total)} sketches (slice [${intToStr(start)},${intToStr(end)}) of ${intToStr(totalAll)}, generated ${today}) ...");
  runAll(list, today, 1, total);

  println("");
  println("──────── leaderboard rebuild ────────");
  let nAgent    = sketchRebuildTopic(AgentReady, today);
  let nPrivacy  = sketchRebuildTopic(Privacy,    today);
  let nPortable = sketchRebuildTopic(Portable,   today);
  let totalRanked = nAgent + nPrivacy + nPortable;

  println("");
  println("Done — ${intToStr(total)} sketches in this slice, ${intToStr(totalRanked)} total leaderboard entries.")
}
