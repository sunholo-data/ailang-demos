#!/usr/bin/env bash
# ambient — AILANG ambient assistant (always-listening, proactive mode)
#
# Usage:
#   ambient "Hey AILANG, what time is it?"     # interactive: type follow-ups
#   ambient "Summarize our conversation"       # resumes previous session
#   ambient --voice Charon "What happened?"    # interactive with voice choice
#   ambient --no-interactive "Quick query"     # single-prompt mode
#   ambient --new "Start fresh"                # new session (interactive)
#   ambient --session work "Project update"    # named session
#   ambient --list                             # list sessions
#   ambient --thinking 2048 "Hard problem"     # with thinking budget
#   ambient --mic "Start listening"            # with microphone capture (needs sox)
#   ambient --screen "What do you see?"       # with screen capture (needs ffmpeg)
#   ambient --video "Can you see me?"         # with webcam (needs ffmpeg)
#   ambient --fps 2 --screen "Watch this"     # custom frame rate (default 1 FPS)
#   ambient                                    # uses default prompt
#
# All ambient features are pre-enabled by default:
#   - Interactive mode (type follow-up messages, type 'exit' to quit)
#   - Proactive audio (model decides when to respond)
#   - Tool calling (speak tools + summarizeContext, searchNotes, remindLater)
#   - Session resumption (remembers context across invocations)
#   - Context window compression (for long sessions)
#   - Input/output transcription
#
# Sessions: scoped like ailang message inboxes
#   Default:  project-based (git repo name or cwd basename)
#   --session NAME:  named session
#   --session global:  global session
#   Storage: ~/.ailang/ambient/sessions/<scope>/
#
# Install: ln -s $(pwd)/streaming/ambient_assistant/ambient ~/.local/bin/ambient

set -euo pipefail

# Parse flags
VOICE="${GEMINI_VOICE:-Charon}"
NEW_SESSION=false
SESSION_NAME=""
LIST_SESSIONS=false
THINKING_BUDGET=""
ENABLE_THOUGHTS=false
ENABLE_NO_INTERRUPT=false
ENABLE_AFFECTIVE=false
ENABLE_INTERACTIVE=true
ENABLE_MIC=false
ENABLE_VIDEO=""
VIDEO_FPS=""
PROMPT_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --voice|-v)
      VOICE="$2"
      shift 2
      ;;
    --new)
      NEW_SESSION=true
      shift
      ;;
    --session|-s)
      SESSION_NAME="$2"
      shift 2
      ;;
    --list)
      LIST_SESSIONS=true
      shift
      ;;
    --affective|-a)
      ENABLE_AFFECTIVE=true
      shift
      ;;
    --thinking)
      THINKING_BUDGET="$2"
      shift 2
      ;;
    --thoughts)
      ENABLE_THOUGHTS=true
      shift
      ;;
    --no-interrupt)
      ENABLE_NO_INTERRUPT=true
      shift
      ;;
    --no-interactive)
      ENABLE_INTERACTIVE=false
      shift
      ;;
    --mic|-m)
      ENABLE_MIC=true
      shift
      ;;
    --screen)
      ENABLE_VIDEO="screen"
      shift
      ;;
    --video)
      ENABLE_VIDEO="webcam"
      shift
      ;;
    --fps)
      VIDEO_FPS="$2"
      shift 2
      ;;
    *)
      PROMPT_ARGS+=("$1")
      shift
      ;;
  esac
done

# Resolve symlinks to find the real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# --- Session scope resolution ---
SESSIONS_ROOT="$HOME/.ailang/ambient/sessions"

if [ -n "$SESSION_NAME" ]; then
  SESSION_SCOPE="$SESSION_NAME"
else
  if git rev-parse --show-toplevel &>/dev/null; then
    SESSION_SCOPE="$(basename "$(git rev-parse --show-toplevel)")"
  else
    SESSION_SCOPE="$(basename "$(pwd)")"
  fi
fi

SESSION_DIR="$SESSIONS_ROOT/$SESSION_SCOPE"

# --- List sessions ---
if $LIST_SESSIONS; then
  echo "Ambient Sessions (~/.ailang/ambient/sessions/):"
  echo ""
  if [ -d "$SESSIONS_ROOT" ]; then
    for dir in "$SESSIONS_ROOT"/*/; do
      [ -d "$dir" ] || continue
      name="$(basename "$dir")"
      handle_age=""
      if [ -f "$dir/session.handle" ]; then
        if stat -f %m "$dir/session.handle" &>/dev/null; then
          age_secs=$(( $(date +%s) - $(stat -f %m "$dir/session.handle") ))
          if [ "$age_secs" -lt 60 ]; then
            handle_age="${age_secs}s ago"
          elif [ "$age_secs" -lt 3600 ]; then
            handle_age="$(( age_secs / 60 ))m ago"
          else
            handle_age="$(( age_secs / 3600 ))h ago"
          fi
        fi
      fi
      transcript_lines=0
      if [ -f "$dir/transcript.jsonl" ]; then
        transcript_lines=$(wc -l < "$dir/transcript.jsonl" | tr -d ' ')
      fi
      reminders=0
      if [ -f "$dir/reminders.txt" ]; then
        reminders=$(wc -l < "$dir/reminders.txt" | tr -d ' ')
      fi
      marker="  "
      [ "$name" = "$SESSION_SCOPE" ] && marker="▸ "
      echo "${marker}${name}"
      [ -n "$handle_age" ] && echo "    handle: $handle_age"
      [ "$transcript_lines" -gt 0 ] && echo "    turns: $transcript_lines"
      [ "$reminders" -gt 0 ] && echo "    reminders: $reminders"
    done
  else
    echo "  (no sessions yet)"
  fi
  echo ""
  echo "Active: $SESSION_SCOPE"
  exit 0
fi

# Create session directory
mkdir -p "$SESSION_DIR"

# Force ADC
export GOOGLE_API_KEY=""
export GEMINI_VOICE="$VOICE"
export GEMINI_SESSION_DIR="$SESSION_DIR"

# Ambient defaults: proactive + tools + interactive always ON
export GEMINI_PROACTIVE=1
export GEMINI_TOOLS=1
if $ENABLE_INTERACTIVE; then
  export GEMINI_INTERACTIVE=1
else
  export GEMINI_INTERACTIVE=0
fi

# Session resumption
if $NEW_SESSION; then
  rm -f "$SESSION_DIR/session.handle"
  export GEMINI_NEW_SESSION=1
fi

# Optional features
if $ENABLE_AFFECTIVE; then
  export GEMINI_AFFECTIVE=1
fi
if [ -n "$THINKING_BUDGET" ]; then
  export GEMINI_THINKING="$THINKING_BUDGET"
fi
if $ENABLE_THOUGHTS; then
  export GEMINI_THOUGHTS=1
fi
if $ENABLE_NO_INTERRUPT; then
  export GEMINI_NO_INTERRUPT=1
fi
if $ENABLE_MIC; then
  export GEMINI_MIC=1
fi
if [ -n "$ENABLE_VIDEO" ]; then
  export GEMINI_VIDEO="$ENABLE_VIDEO"
  export GEMINI_VIDEO_FPS="${VIDEO_FPS:-1}"
fi

# Run from repo root
cd "$REPO_ROOT"

RUN_CMD=(ailang run --entry main --caps IO,FS,Stream,Net,Env,Process
  streaming/ambient_assistant/main.ail "${PROMPT_ARGS[@]}")

# First attempt — may fail if session.handle is stale
if "${RUN_CMD[@]}"; then
  exit 0
fi

# Stale session — retry fresh
if [ -f "$SESSION_DIR/session.handle" ]; then
  echo ""
  echo "[ambient] Session expired — starting fresh session for '$SESSION_SCOPE'"
  rm -f "$SESSION_DIR/session.handle"
  export GEMINI_NEW_SESSION=1
  exec "${RUN_CMD[@]}"
fi

# Genuine failure
exit 1
