  println("=== Ambient Browser AILANG Tests ===");
  println("");
  testDefaults();
  println("");
  testInstruction();
  println("");
  testAiStudioUrl();
  println("");
  testSetupStructure();
  println("");
  testSetupWithThinking();
  println("");
  testBuildTextMessage();
  println("");
  testBuildAudioChunk();
  println("");
  testBuildToolResponse();
  println("");
  testParseMessage();
  println("");
  testVoiceCatalog();
  println("");
  testToolDeclarations();
  println("");
  testFutureGoogleSearch();
  println("");
  testFutureAffectiveDialog();
  println("");
  println("=== Tests Complete ===")
}
