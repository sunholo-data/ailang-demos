-- Extended tool declarations for the ambient assistant.
--
-- Re-exports all speak_tools (currentTime, calculate, readFile, listFiles, runCommand)
-- and adds ambient-specific tools:
--   summarizeContext — reads transcript JSONL, returns conversation summary
--   searchNotes     — searches user notes directory for keyword matches
--   remindLater     — writes timestamped reminder to session reminders file
--   cacheResult     — cache a key-value pair with TTL for proactive pre-fetching
--   getCachedResult — retrieve a cached value by key (checks expiry)
--   prefetch        — run a command and cache its output (combines runCommand + cache)
--
-- All tools are contract-verified with path safety.

module streaming/ambient_assistant/services/ambient_tools

import std/string (length, startsWith, split, join, find, substring, stringToInt, trim)
import std/list (length as listLength, map, filter, concat, nth, foldl, forEachE)
import std/result (Ok, Err)
import std/option (Some, None, getOrElse)
import std/json (decode, encode, getString, getObject, getInt,
                 jo, kv, js, ja, Json)
import std/fs (readFile, fileExists, appendFile, writeFile)
import std/process (exec, NotFound, Timeout, NotAllowed)
import std/bytes (toString)
import std/env (getEnvOr)
import streaming/gemini_live/services/speak_tools (getSpeakToolDeclarations, dispatchTool,
  isPathSafe, containsTraversal)

-- ============================================================
-- Tool Declarations (speak_tools + ambient extras)
-- ============================================================

export func getAmbientToolDeclarations() -> [{name: string, description: string, parameters: Json}] {
  let baseTools = getSpeakToolDeclarations();
  let ambientTools = [
    { name: "summarizeContext",
      description: "Summarize the recent conversation from the session transcript. Returns the last N turns of conversation (default 20).",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("maxTurns", jo([kv("type", js("number")), kv("description", js("Maximum number of turns to include (default 20)"))]))
        ])),
        kv("required", ja([]))
      ]) },

    { name: "searchNotes",
      description: "Search the user's notes directory for files containing a keyword. Returns matching filenames and snippets.",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("keyword", jo([kv("type", js("string")), kv("description", js("Keyword to search for"))]))
        ])),
        kv("required", ja([js("keyword")]))
      ]) },

    { name: "remindLater",
      description: "Save a reminder for later. The reminder is timestamped and saved to the session's reminders file.",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("reminder", jo([kv("type", js("string")), kv("description", js("The reminder text to save"))]))
        ])),
        kv("required", ja([js("reminder")]))
      ]) },

    { name: "cacheResult",
      description: "Cache a key-value pair for later retrieval. Use this to store pre-fetched data that the user might ask about soon. Call this after proactively gathering information.",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("key", jo([kv("type", js("string")), kv("description", js("Cache key (e.g. 'gh_issues', 'git_status')"))])),
          kv("value", jo([kv("type", js("string")), kv("description", js("The data to cache"))])),
          kv("ttlSeconds", jo([kv("type", js("number")), kv("description", js("Time to live in seconds (default 300 = 5 minutes)"))]))
        ])),
        kv("required", ja([js("key"), js("value")]))
      ]) },

    { name: "getCachedResult",
      description: "Retrieve a previously cached value by key. Returns the cached data or 'not found' if expired or missing.",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("key", jo([kv("type", js("string")), kv("description", js("Cache key to look up"))]))
        ])),
        kv("required", ja([js("key")]))
      ]) },

    { name: "prefetch",
      description: "Run a command and cache its output under a key. Combines runCommand + cacheResult in one step. Use this to silently pre-fetch data when you hear cues suggesting the user will need it soon. Example: prefetch(key='gh_issues', command='gh', subcommand='issue list')",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("key", jo([kv("type", js("string")), kv("description", js("Cache key for the result"))])),
          kv("command", jo([kv("type", js("string")), kv("description", js("Command to run (git, gh, ailang, ls, etc.)"))])),
          kv("subcommand", jo([kv("type", js("string")), kv("description", js("Subcommand (e.g. 'issue list', 'status')"))])),
          kv("args", jo([kv("type", js("string")), kv("description", js("Additional arguments (optional)"))]))
        ])),
        kv("required", ja([js("key"), js("command"), js("subcommand")]))
      ]) },

    { name: "takeScreenshot",
      description: "Take a screenshot of the user's screen or webcam right now. Returns a single frame. Use this when the user asks 'what's on my screen?' or 'can you see this?' instead of continuous video streaming. The screenshot is sent as a visual frame to analyze.",
      parameters: jo([
        kv("type", js("object")),
        kv("properties", jo([
          kv("source", jo([kv("type", js("string")), kv("description", js("'screen' for screen capture or 'webcam' for camera (default: screen)"))]))
        ])),
        kv("required", ja([]))
      ]) }
  ];
  concat(baseTools, ambientTools)
}

-- ============================================================
-- Dispatch (delegates to speak_tools for base tools)
-- ============================================================

export func dispatchAmbientTool(name: string, argsJson: string, allowedPath: string, sessionDir: string) -> Result[string, string] ! {FS, Process, Env} {
  match name {
    "summarizeContext" => handleSummarizeContext(argsJson, sessionDir),
    "searchNotes" => handleSearchNotes(argsJson, allowedPath),
    "remindLater" => handleRemindLater(argsJson, sessionDir),
    "cacheResult" => handleCacheResult(argsJson, sessionDir),
    "getCachedResult" => handleGetCachedResult(argsJson, sessionDir),
    "prefetch" => handlePrefetch(argsJson, sessionDir, allowedPath),
    "takeScreenshot" => handleTakeScreenshot(argsJson, sessionDir),
    _ => dispatchTool(name, argsJson, allowedPath)
  }
}

-- ============================================================
-- Tool: Summarize Context
-- ============================================================
-- Reads the transcript JSONL and returns recent conversation turns.

func handleSummarizeContext(argsJson: string, sessionDir: string) -> Result[string, string] ! {FS} {
  let transcriptPath = sessionDir ++ "/transcript.jsonl";
  if not fileExists(transcriptPath) then
    Ok("No conversation history yet.")
  else {
    let content = readFile(transcriptPath);
    let lines = filter(\l. length(l) > 0, split(content, "\n"));
    let totalLines = listLength(lines);
    let maxTurns = match decode(argsJson) {
      Ok(json) => match getString(json, "maxTurns") {
        Some(_) => 20,
        None => 20
      },
      Err(_) => 20
    };
    -- Take the last maxTurns lines
    let startIdx = if totalLines > maxTurns then totalLines - maxTurns else 0;
    let recentLines = takeFrom(startIdx, 0, lines);
    let summary = join("\n", recentLines);
    Ok("Recent conversation (" ++ show(listLength(recentLines)) ++ " of " ++ show(totalLines) ++ " entries):\n" ++ summary)
  }
}

-- Take lines from startIdx to end of list
pure func takeFrom(startIdx: int, currentIdx: int, lines: [string]) -> [string] =
  match lines {
    [] => [],
    x :: rest => if currentIdx >= startIdx then
      x :: takeFrom(startIdx, currentIdx + 1, rest)
    else takeFrom(startIdx, currentIdx + 1, rest)
  }

-- ============================================================
-- Tool: Search Notes
-- ============================================================
-- Searches a notes directory (default ~/Notes or configurable) for keyword matches.

func handleSearchNotes(argsJson: string, allowedPath: string) -> Result[string, string] ! {FS, Process} {
  match decode(argsJson) {
    Ok(json) => {
      let keyword = getOrElse(getString(json, "keyword"), "");
      if length(keyword) == 0 then Err("keyword is required")
      else {
        -- Search in common notes locations using grep
        let notesDir = getEnvOr("AILANG_NOTES_DIR", allowedPath);
        if not isPathSafe(notesDir, allowedPath) then
          Err("Notes directory must be within allowed path: " ++ allowedPath)
        else {
          match exec("grep", ["-rl", "--include=*.md", "--include=*.txt", "--include=*.org", keyword, notesDir]) {
            Ok(out) => {
              let result = toString(out.stdout);
              if length(result) == 0 then Ok("No notes found matching '" ++ keyword ++ "'")
              else Ok("Files matching '" ++ keyword ++ "':\n" ++ result)
            },
            Err(NotFound(_)) => Err("grep command not found"),
            Err(_) => Ok("No notes found matching '" ++ keyword ++ "'")
          }
        }
      }
    },
    Err(e) => Err("Invalid args: " ++ e)
  }
}

-- ============================================================
-- Tool: Remind Later
-- ============================================================
-- Saves a timestamped reminder to the session's reminders file.

func handleRemindLater(argsJson: string, sessionDir: string) -> Result[string, string] ! {FS, Process} {
  match decode(argsJson) {
    Ok(json) => {
      let reminder = getOrElse(getString(json, "reminder"), "");
      if length(reminder) == 0 then Err("reminder text is required")
      else {
        let remindersPath = sessionDir ++ "/reminders.txt";
        -- Get current timestamp
        let timestamp = match exec("date", ["+%Y-%m-%d %H:%M:%S"]) {
          Ok(out) => toString(out.stdout),
          Err(_) => "(unknown time)"
        };
        let entry = "[" ++ timestamp ++ "] " ++ reminder ++ "\n";
        appendFile(remindersPath, entry);
        Ok("Reminder saved: " ++ reminder)
      }
    },
    Err(e) => Err("Invalid args: " ++ e)
  }
}

-- ============================================================
-- Tool: Cache Result
-- ============================================================
-- Stores a key-value pair in $sessionDir/cache/<key>.json with TTL.
-- Used by the model to proactively cache pre-fetched data.

func handleCacheResult(argsJson: string, sessionDir: string) -> Result[string, string] ! {FS, Process} {
  match decode(argsJson) {
    Ok(json) => {
      let key = getOrElse(getString(json, "key"), "");
      let value = getOrElse(getString(json, "value"), "");
      if length(key) == 0 then Err("key is required")
      else if length(value) == 0 then Err("value is required")
      else {
        let ttl = match getInt(json, "ttlSeconds") { Some(n) => n, None => 300 };
        writeCacheEntry(sessionDir, key, value, ttl)
      }
    },
    Err(e) => Err("Invalid args: " ++ e)
  }
}

-- ============================================================
-- Tool: Get Cached Result
-- ============================================================
-- Retrieves a cached value by key. Checks expiry.

func handleGetCachedResult(argsJson: string, sessionDir: string) -> Result[string, string] ! {FS, Process} {
  match decode(argsJson) {
    Ok(json) => {
      let key = getOrElse(getString(json, "key"), "");
      if length(key) == 0 then Err("key is required")
      else readCacheEntry(sessionDir, key)
    },
    Err(e) => Err("Invalid args: " ++ e)
  }
}

-- ============================================================
-- Tool: Prefetch
-- ============================================================
-- Runs a command via dispatchTool (runCommand) and caches the output.
-- Combines runCommand + cacheResult in one step for proactive PA.

func handlePrefetch(argsJson: string, sessionDir: string, allowedPath: string) -> Result[string, string] ! {FS, Process} {
  match decode(argsJson) {
    Ok(json) => {
      let key = getOrElse(getString(json, "key"), "");
      let command = getOrElse(getString(json, "command"), "");
      let subcommand = getOrElse(getString(json, "subcommand"), "");
      let args = getOrElse(getString(json, "args"), "");
      if length(key) == 0 then Err("key is required")
      else if length(command) == 0 then Err("command is required")
      else {
        -- Build runCommand args JSON and dispatch
        let cmdArgs = encode(jo([
          kv("command", js(command)),
          kv("subcommand", js(subcommand)),
          kv("args", js(args))
        ]));
        match dispatchTool("runCommand", cmdArgs, allowedPath) {
          Ok(result) => {
            -- Cache the result (5 minute TTL)
            match writeCacheEntry(sessionDir, key, result, 300) {
              Ok(_) => Ok("Prefetched and cached as '" ++ key ++ "': " ++ result),
              Err(e) => Ok("Prefetched but cache write failed: " ++ e ++ "\nResult: " ++ result)
            }
          },
          Err(e) => Err("Prefetch command failed: " ++ e)
        }
      }
    },
    Err(e) => Err("Invalid args: " ++ e)
  }
}

-- ============================================================
-- Cache Helpers
-- ============================================================

func getUnixTimestamp() -> int ! {Process} =
  match exec("date", ["+%s"]) {
    Ok(out) => match stringToInt(trim(toString(out.stdout))) {
      Some(n) => n,
      None => 0
    },
    Err(_) => 0
  }

func writeCacheEntry(sessionDir: string, key: string, value: string, ttlSeconds: int) -> Result[string, string] ! {FS, Process} {
  let cacheDir = sessionDir ++ "/cache";
  -- Ensure cache directory exists
  exec("mkdir", ["-p", cacheDir]);
  let cachePath = cacheDir ++ "/" ++ key ++ ".json";
  let now = getUnixTimestamp();
  let expires = now + ttlSeconds;
  let entry = encode(jo([
    kv("value", js(value)),
    kv("expires", js(show(expires))),
    kv("cachedAt", js(show(now)))
  ]));
  writeFile(cachePath, entry);
  Ok("Cached '" ++ key ++ "' (expires in " ++ show(ttlSeconds) ++ "s)")
}

func readCacheEntry(sessionDir: string, key: string) -> Result[string, string] ! {FS, Process} {
  let cachePath = sessionDir ++ "/cache/" ++ key ++ ".json";
  if not fileExists(cachePath) then Ok("Not found: no cached data for '" ++ key ++ "'")
  else {
    let content = readFile(cachePath);
    match decode(content) {
      Ok(json) => {
        let value = getOrElse(getString(json, "value"), "");
        let expiresStr = getOrElse(getString(json, "expires"), "0");
        let expires = match stringToInt(expiresStr) { Some(n) => n, None => 0 };
        let now = getUnixTimestamp();
        if now > expires then
          Ok("Expired: cached data for '" ++ key ++ "' has expired")
        else
          Ok(value)
      },
      Err(e) => Err("Cache read error: " ++ e)
    }
  }
}

-- ============================================================
-- Tool: Take Screenshot
-- ============================================================
-- Captures a single frame from screen or webcam on demand.
-- Returns base64 JPEG prefixed with "SCREENSHOT:" so main.ail
-- can detect it and send as realtimeInput.mediaChunks.

func handleTakeScreenshot(argsJson: string, sessionDir: string) -> Result[string, string] ! {FS, Process, Env} {
  let source = match decode(argsJson) {
    Ok(json) => getOrElse(getString(json, "source"), "screen"),
    Err(_) => "screen"
  };
  let scriptDir = getEnvOr("GEMINI_SCRIPT_DIR", "streaming/ambient_assistant/scripts");
  let scriptPath = scriptDir ++ "/take_screenshot.sh";
  match exec(scriptPath, [source]) {
    Ok(out) => {
      let b64 = trim(toString(out.stdout));
      if length(b64) == 0 then Err("Screenshot capture returned empty result")
      else {
        -- Prefix with SCREENSHOT: so main.ail sends it as a video frame
        Ok("SCREENSHOT:" ++ b64)
      }
    },
    Err(NotFound(_)) => Err("Screenshot script not found: " ++ scriptPath),
    Err(Timeout(_)) => Err("Screenshot capture timed out"),
    Err(_) => Err("Screenshot capture failed")
  }
}
