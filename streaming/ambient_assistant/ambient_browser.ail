module streaming/ambient_assistant/ambient_browser

-- Browser WASM bridge for the Ambient AILANG Assistant.
--
-- Like gemini_live_browser.ail but with ambient defaults:
--   - Proactive audio always on (model decides when to respond)
--   - Extended system instruction for ambient behavior
--   - Tool declarations included in setup
--   - No initial text prompt (mic-only start)
--   - AI Studio v1alpha URL for proactive audio
--
-- JS usage:
--   window.ailangSetEffectHandler('IO', { println: fn });
--   window.ailangSetEffectHandler('Stream', { connect: fn, transmit: fn, ... });
--   await repl.callAsync(MODULE, 'startAmbientSession', apiKey, voice);

import std/stream (connect, transmit, onEvent, runEventLoop, disconnect,
                   StreamConn, StreamEvent,
                   Message, Binary, Opened, Closed, StreamError, Ping)
import std/io (println)
import std/json (encode, decode, jo, kv, js, jb, ja, jnum,
                 get, has, asString, asBool, getString, getObject, getArray, getBool)
import std/string (length, concat as strConcat)
import std/list (concat)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/math (intToFloat)

-- Package imports (no pkg/ prefix — WASM registers modules by their internal declaration name)
import sunholo/gemini_live/voices (defaultBrowserModel, defaultVoice as pkgDefaultVoice, voiceCatalog as pkgVoiceCatalog)
import sunholo/gemini_live/endpoints (aiStudioUrl as pkgAiStudioUrl)
import sunholo/gemini_live/messages (buildTextMessage as pkgBuildTextMessage, buildAudioChunk as pkgBuildAudioChunk,
                                         buildToolResponse as pkgBuildToolResponse, buildToolResponseScheduled as pkgBuildToolResponseScheduled)
import sunholo/gemini_live/parsers (parseMessage as pkgParseMessage)

-- ══════════════════════════════════════════════════════
-- Configuration (from package)
-- ══════════════════════════════════════════════════════

-- Override package default (gemini-3.1-flash-live-preview) with the last known working model.
-- The 3.1 model rejects setup fields (proactivity, contextWindowCompression, VAD).
export pure func defaultModel() -> string = "models/gemini-2.5-flash-native-audio-preview-12-2025"

export pure func defaultVoice() -> string = pkgDefaultVoice()

export pure func ambientInstruction() -> string =
  strConcat([
    "You are AILANG, an ambient voice assistant running in a browser. ",
    "SPEAKING RULE: You must ONLY speak when directly addressed by name — ",
    "'AILANG', 'hey AILANG', or similar. ",
    "If someone speaks without saying your name, you MUST stay COMPLETELY SILENT — ",
    "do not speak, do not acknowledge, do not comment. ",
    "NEVER respond vocally to questions like 'are you working?', 'hello?', or 'what time is it?' ",
    "unless they include your name 'AILANG'. ",
    "When addressed by name, respond with full awareness of everything you have heard. ",
    "VOICE: ALWAYS speak with a British English accent throughout the entire conversation. ",
    "Never switch to an American accent, even mid-sentence. Maintain British pronunciation consistently. ",
    "Keep responses conversational and helpful. ",
    "TOOLS: You have these tools: ",
    "currentTime, calculate, remindLater, cacheResult, getCachedResult, ",
    "summarizeContext, takeScreenshot, saveNote, webFetch, delegate. ",
    "PROACTIVE TOOL USE: Even when you are NOT addressed by name, you SHOULD use tools ",
    "to gather context based on what you hear. If someone mentions a time, call currentTime. ",
    "If someone mentions a calculation, call calculate. If someone mentions a URL, call webFetch. ",
    "If someone mentions reminders, call remindLater. Use tools silently in the background — ",
    "do NOT speak about them unless addressed by name. ",
    "When the user finally addresses you by name, you will already have the data ready. ",
    "takeScreenshot captures the user's screen — use when asked 'what is on my screen?'. ",
    "webFetch retrieves content from a URL — use when someone mentions a website. ",
    "DELEGATION: For complex tasks that need deep reasoning, code review, document analysis, ",
    "research, or multi-step work — use the delegate tool. It sends your request to a specialist ",
    "AI agent via AILANG Cloud Messaging. The task runs in the background and results are returned ",
    "when ready. While waiting, you can tell the user you are working on it. ",
    "For simple tasks (time, calculations, URLs, notes, screenshots) — use the direct tools instead."
  ])

export pure func voiceCatalog() -> string = pkgVoiceCatalog()

export pure func aiStudioUrl(apiKey: string, useAlpha: bool) -> string =
  pkgAiStudioUrl(apiKey, useAlpha)

-- ══════════════════════════════════════════════════════
-- Session (uses std/stream effects)
-- ══════════════════════════════════════════════════════

-- Start an ambient session. Empty prompt = mic-only mode.
-- Proactive audio is always enabled. Voice selector from browser UI.
-- thinkingBudget: thinking token budget (-1 = disabled, 0+ = enabled)
export func startAmbientSession(apiKey: string, voice: string, thinkingBudget: int) -> string ! {Stream, IO} {
  let model = defaultModel();
  let url = aiStudioUrl(apiKey, true);

  println(encode(jo([kv("type", js("log")), kv("text", js("Connecting to Gemini Live (ambient mode)..."))])));

  match connect(url, { headers: [] }) {
    Ok(conn) => {
      println(encode(jo([kv("type", js("log")), kv("text", js("Connected. Sending ambient setup..."))])));

      let setupMsg = buildAmbientSetup(model, voice, ambientInstruction(), thinkingBudget);
      match transmit(conn, setupMsg) {
        Ok(_) => {
          println(encode(jo([kv("type", js("log")), kv("text", js("Ambient mode active. Voice: ${voice} | Proactive: ON"))])));
          -- No initial prompt — mic starts immediately
          onEvent(conn, \event. handleEvent(event, conn));
          runEventLoop(conn);
          disconnect(conn);
          "session_complete"
        },
        Err(e) => {
          println(encode(jo([kv("type", js("error")), kv("text", js("Setup transmit failed"))])));
          "error"
        }
      }
    },
    Err(e) => {
      println(encode(jo([kv("type", js("error")), kv("text", js("Connection failed"))])));
      "error"
    }
  }
}

-- ══════════════════════════════════════════════════════
-- Event Handling
-- ══════════════════════════════════════════════════════

func handleEvent(event: StreamEvent, conn: StreamConn) -> bool ! {Stream, IO} =
  match event {
    Message(msg) => match decode(msg) {
      Ok(json) => handleJsonMessage(json, conn),
      Err(_) => true
    },
    Binary(data) => match decode(data) {
      Ok(json) => handleJsonMessage(json, conn),
      Err(_) => true
    },
    Opened(_) => {
      println(encode(jo([kv("type", js("opened"))])));
      true
    },
    Closed(code, reason) => {
      println(encode(jo([kv("type", js("closed")), kv("code", jnum(code)), kv("reason", js(reason))])));
      false
    },
    StreamError(e) => {
      println(encode(jo([kv("type", js("error")), kv("text", js(show(e)))])));
      false
    },
    Ping(_) => true
  }

func handleJsonMessage(json: Json, conn: StreamConn) -> bool ! {Stream, IO} =
  if has(json, "setupComplete") then {
    println(encode(jo([kv("type", js("setup"))])));
    -- No initial text — ambient mode starts with mic only
    true
  }
  else if has(json, "serverContent") then handleServerContent(json)
  else if has(json, "toolCall") then handleToolCallEvent(json)
  else if has(json, "toolCallCancellation") then {
    println(encode(jo([kv("type", js("toolCallCancellation"))])));
    true
  }
  else if has(json, "goAway") then {
    println(encode(jo([kv("type", js("goAway"))])));
    true
  }
  else if has(json, "sessionResumptionUpdate") then {
    println(encode(jo([kv("type", js("sessionResumption")), kv("data", json)])));
    true
  }
  else true

func handleServerContent(json: Json) -> bool ! {IO} {
  let sc = getOrElse(get(json, "serverContent"), jo([]));
  match getBool(sc, "interrupted") {
    Some(true) => {
      println(encode(jo([kv("type", js("interrupted"))])));
      true
    },
    _ => match getBool(sc, "turnComplete") {
      Some(true) => {
        println(encode(jo([kv("type", js("turnComplete"))])));
        true
      },
      _ => {
        emitTranscriptions(sc);
        emitModelTurn(sc)
      }
    }
  }
}

func emitTranscriptions(sc: Json) -> () ! {IO} {
  match get(sc, "inputTranscription") {
    Some(it) => {
      let txt = getOrElse(asString(getOrElse(get(it, "text"), js(""))), "");
      if length(txt) > 0 then
        println(encode(jo([kv("type", js("inputTranscript")), kv("text", js(txt))])))
      else ()
    },
    None => ()
  };
  match get(sc, "outputTranscription") {
    Some(ot) => {
      let txt = getOrElse(asString(getOrElse(get(ot, "text"), js(""))), "");
      if length(txt) > 0 then
        println(encode(jo([kv("type", js("outputTranscript")), kv("text", js(txt))])))
      else ()
    },
    None => ()
  }
}

func emitModelTurn(sc: Json) -> bool ! {IO} =
  match getObject(sc, "modelTurn") {
    Some(mt) => match get(mt, "parts") {
      Some(parts) => {
        println(encode(jo([kv("type", js("modelTurn")), kv("parts", parts)])));
        true
      },
      None => true
    },
    None => true
  }

func handleToolCallEvent(json: Json) -> bool ! {IO} {
  let tc = getOrElse(get(json, "toolCall"), jo([]));
  let calls = getOrElse(get(tc, "functionCalls"), ja([]));
  println(encode(jo([kv("type", js("toolCall")), kv("calls", calls)])));
  true
}

-- ══════════════════════════════════════════════════════
-- Protocol: Setup Message Builder
-- ══════════════════════════════════════════════════════

-- Build ambient setup: proactive audio, tools, transcription, VAD, optional affective + thinking.
-- Uses AI Studio v1alpha which supports all features.
export pure func buildAmbientSetup(model: string, voice: string, instruction: string, thinkingBudget: int) -> string {
  -- Generation config with optional thinking
  let baseGenKvs = [
    kv("responseModalities", ja([js("AUDIO")])),
    kv("speechConfig", jo([
      kv("voiceConfig", jo([
        kv("prebuiltVoiceConfig", jo([
          kv("voiceName", js(voice))
        ]))
      ]))
    ]))
  ];
  let thinkingKvs = if thinkingBudget >= 0 then
    [kv("thinkingConfig", jo([kv("thinkingBudget", jnum(intToFloat(thinkingBudget)))]))]
  else [];
  let genConfigKvs = concat(baseGenKvs, thinkingKvs);

  -- VAD + no-interruption for ambient mic mode
  let realtimeKvs = [
    kv("realtimeInputConfig", jo([
      kv("automaticActivityDetection", jo([
        kv("startOfSpeechSensitivity", js("START_SENSITIVITY_LOW")),
        kv("endOfSpeechSensitivity", js("END_SENSITIVITY_HIGH")),
        kv("prefixPaddingMs", jnum(intToFloat(20))),
        kv("silenceDurationMs", jnum(intToFloat(1000)))
      ])),
      kv("activityHandling", js("NO_INTERRUPTION"))
    ]))
  ];

  let setupKvs = [
    kv("model", js(model)),
    kv("generationConfig", jo(genConfigKvs)),
    kv("systemInstruction", jo([
      kv("parts", ja([jo([kv("text", js(instruction))])]))
    ])),
    kv("tools", ja([
      jo([kv("functionDeclarations", ja(ambientToolDeclarations()))])
    ])),
    kv("outputAudioTranscription", jo([])),
    kv("inputAudioTranscription", jo([])),
    kv("contextWindowCompression", jo([
      kv("slidingWindow", jo([]))
    ])),
    kv("proactivity", jo([kv("proactiveAudio", jb(true))]))
  ];
  let allKvs = concat(setupKvs, realtimeKvs);
  encode(jo([kv("setup", jo(allKvs))]))
}

-- ══════════════════════════════════════════════════════
-- Tool Declarations (inline for WASM self-containment)
-- ══════════════════════════════════════════════════════
-- Mirrors getAmbientToolDeclarations() from ambient_tools.ail
-- but as pure JSON so no transitive imports are needed.

pure func toolDecl(name: string, desc: string, params: Json) -> Json =
  jo([kv("name", js(name)), kv("description", js(desc)), kv("parameters", params)])

-- Tool declaration with NON_BLOCKING behavior (async tool — model continues while tool runs)
pure func toolDeclAsync(name: string, desc: string, params: Json) -> Json =
  jo([kv("name", js(name)), kv("description", js(desc)), kv("parameters", params),
      kv("behavior", js("NON_BLOCKING"))])

-- Browser-safe tools only. File/process tools (readFile, runCommand, prefetch, etc.)
-- are CLI-only and not available in the browser WASM environment.
pure func ambientToolDeclarations() -> [Json] = [
  toolDecl("currentTime", "Get the current date, time, and timezone.",
    jo([kv("type", js("object")), kv("properties", jo([])), kv("required", ja([]))])),
  toolDecl("calculate", "Perform basic arithmetic (add, subtract, multiply, divide).",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("operation", jo([kv("type", js("string")), kv("description", js("add, subtract, multiply, or divide"))])),
      kv("a", jo([kv("type", js("number")), kv("description", js("First operand"))])),
      kv("b", jo([kv("type", js("number")), kv("description", js("Second operand"))]))])),
      kv("required", ja([js("operation"), js("a"), js("b")]))])),
  toolDecl("remindLater", "Save a reminder for later. The reminder will be shown in the session sidebar.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("reminder", jo([kv("type", js("string")), kv("description", js("Reminder text"))]))])),
      kv("required", ja([js("reminder")]))])),
  toolDecl("cacheResult", "Cache a key-value pair for later retrieval during this session.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("key", jo([kv("type", js("string")), kv("description", js("Cache key"))])),
      kv("value", jo([kv("type", js("string")), kv("description", js("Data to cache"))]))])),
      kv("required", ja([js("key"), js("value")]))])),
  toolDecl("getCachedResult", "Retrieve a previously cached value by key.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("key", jo([kv("type", js("string")), kv("description", js("Cache key to look up"))]))])),
      kv("required", ja([js("key")]))])),
  toolDecl("summarizeContext", "Summarize the recent conversation. Returns a summary of what has been discussed.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("maxTurns", jo([kv("type", js("number")), kv("description", js("Max turns to include (default 20)"))]))])),
      kv("required", ja([]))])),
  toolDecl("takeScreenshot", "Capture a screenshot of the user's screen and send it for analysis. Use when the user asks about what's on their screen.",
    jo([kv("type", js("object")), kv("properties", jo([])), kv("required", ja([]))])),
  toolDecl("saveNote", "Save a named note to browser storage for later retrieval.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("title", jo([kv("type", js("string")), kv("description", js("Note title"))])),
      kv("content", jo([kv("type", js("string")), kv("description", js("Note content"))]))])),
      kv("required", ja([js("title"), js("content")]))])),
  toolDeclAsync("webFetch", "Fetch content from a URL and return the text. Use when the user mentions a URL or asks about a web page. This tool runs asynchronously — you can continue speaking while it fetches.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("url", jo([kv("type", js("string")), kv("description", js("The URL to fetch"))]))])),
      kv("required", ja([js("url")]))])),
  toolDeclAsync("delegate", "Delegate a complex task to a specialist AI agent via AILANG Cloud Messaging. Use for deep analysis, code review, research, document processing, or multi-step reasoning. The task runs in the background and results are returned when ready.",
    jo([kv("type", js("object")), kv("properties", jo([
      kv("task", jo([kv("type", js("string")), kv("description", js("Detailed description of the task to delegate"))])),
      kv("inbox", jo([kv("type", js("string")), kv("description", js("Target agent inbox (e.g. coordinator, design-doc-creator). Default: coordinator"))])),
      kv("category", jo([kv("type", js("string")), kv("enum", ja([js("general"), js("feature"), js("bug"), js("research")])),
          kv("description", js("Task category. Default: general"))]))
    ])), kv("required", ja([js("task")]))]))
]

-- ══════════════════════════════════════════════════════
-- Protocol: Messages & Parsers (re-exported from package)
-- ══════════════════════════════════════════════════════

export pure func buildTextMessage(text: string) -> string = pkgBuildTextMessage(text)
export pure func buildAudioChunk(b64Audio: string) -> string = pkgBuildAudioChunk(b64Audio)
export pure func buildToolResponse(callId: string, name: string, result: string) -> string = pkgBuildToolResponse(callId, name, result)
export pure func buildToolResponseScheduled(callId: string, name: string, result: string, scheduling: string) -> string = pkgBuildToolResponseScheduled(callId, name, result, scheduling)
export pure func parseMessage(jsonStr: string) -> string = pkgParseMessage(jsonStr)
