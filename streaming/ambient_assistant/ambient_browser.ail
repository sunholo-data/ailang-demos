-- ══════════════════════════════════════════════════════
-- URL Builders
-- ══════════════════════════════════════════════════════

-- AI Studio URL — v1alpha needed for proactive audio + affective dialog
export pure func aiStudioUrl(apiKey: string, useAlpha: bool) -> string {
  let version = if useAlpha then "v1alpha" else "v1beta";
  "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage." ++ version ++ ".GenerativeService.BidiGenerateContent?key=" ++ apiKey
}

-- ══════════════════════════════════════════════════════
-- Session (uses std/stream effects)
-- ══════════════════════════════════════════════════════

-- Start an ambient session. Empty prompt = mic-only mode.
-- Proactive audio is always enabled. Voice selector from browser UI.
export func startAmbientSession(apiKey: string, voice: string) -> string ! {Stream, IO} {
  let model = defaultModel();
  let url = aiStudioUrl(apiKey, true);

  println(encode(jo([kv("type", js("log")), kv("text", js("Connecting to Gemini Live (ambient mode)..."))])));

  match connect(url, { headers: [] }) {
    Ok(conn) => {
      println(encode(jo([kv("type", js("log")), kv("text", js("Connected. Sending ambient setup..."))])));

      let setupMsg = buildAmbientSetup(model, voice, ambientInstruction());
      match transmit(conn, setupMsg) {
        Ok(_) => {
          println(encode(jo([kv("type", js("log")), kv("text", js("Ambient mode active. Voice: " ++ voice ++ " | Proactive: ON"))])));
          -- No initial prompt — mic starts immediately
          onEvent(conn, \event. handleEvent(event, conn));
          runEventLoop(conn);
          disconnect(conn);
          "session_complete"
        },
        Err(e) => {
          println(encode(jo([kv("type", js("error")), kv("text", js("Setup transmit failed"))])));
          "error"
        }
      }
    },
    Err(e) => {
      println(encode(jo([kv("type", js("error")), kv("text", js("Connection failed"))])));
      "error"
    }
  }
}

-- ══════════════════════════════════════════════════════
-- Event Handling
-- ══════════════════════════════════════════════════════

func handleEvent(event: StreamEvent, conn: StreamConn) -> bool ! {Stream, IO} =
  match event {
    Message(msg) => match decode(msg) {
      Ok(json) => handleJsonMessage(json, conn),
      Err(_) => true
    },
    Binary(data) => match decode(data) {
      Ok(json) => handleJsonMessage(json, conn),
      Err(_) => true
    },
    Opened(_) => {
      println(encode(jo([kv("type", js("opened"))])));
      true
    },
    Closed(code, reason) => {
      println(encode(jo([kv("type", js("closed")), kv("code", jnum(code)), kv("reason", js(reason))])));
      false
    },
    StreamError(e) => {
      println(encode(jo([kv("type", js("error")), kv("text", js(show(e)))])));
      false
    },
    Ping(_) => true
  }

func handleJsonMessage(json: Json, conn: StreamConn) -> bool ! {Stream, IO} =
  if has(json, "setupComplete") then {
    println(encode(jo([kv("type", js("setup"))])));
    -- No initial text — ambient mode starts with mic only
    true
  }
  else if has(json, "serverContent") then handleServerContent(json)
  else if has(json, "toolCall") then handleToolCallEvent(json)
  else if has(json, "toolCallCancellation") then {
    println(encode(jo([kv("type", js("toolCallCancellation"))])));
    true
  }
  else if has(json, "goAway") then {
    println(encode(jo([kv("type", js("goAway"))])));
    true
  }
  else if has(json, "sessionResumptionUpdate") then {
    println(encode(jo([kv("type", js("sessionResumption")), kv("data", json)])));
    true
  }
  else true

func handleServerContent(json: Json) -> bool ! {IO} {
  let sc = getOrElse(get(json, "serverContent"), jo([]));
  match getBool(sc, "interrupted") {
    Some(true) => {
      println(encode(jo([kv("type", js("interrupted"))])));
      true
    },
    _ => match getBool(sc, "turnComplete") {
      Some(true) => {
        println(encode(jo([kv("type", js("turnComplete"))])));
        true
      },
      _ => {
        emitTranscriptions(sc);
        emitModelTurn(sc)
      }
    }
  }
}

func emitTranscriptions(sc: Json) -> () ! {IO} {
  match get(sc, "inputTranscription") {
    Some(it) => {
      let txt = getOrElse(asString(getOrElse(get(it, "text"), js(""))), "");
      if length(txt) > 0 then
        println(encode(jo([kv("type", js("inputTranscript")), kv("text", js(txt))])))
      else ()
    },
    None => ()
  };
  match get(sc, "outputTranscription") {
    Some(ot) => {
      let txt = getOrElse(asString(getOrElse(get(ot, "text"), js(""))), "");
      if length(txt) > 0 then
        println(encode(jo([kv("type", js("outputTranscript")), kv("text", js(txt))])))
      else ()
    },
    None => ()
  }
}

func emitModelTurn(sc: Json) -> bool ! {IO} =
  match getObject(sc, "modelTurn") {
    Some(mt) => match get(mt, "parts") {
      Some(parts) => {
        println(encode(jo([kv("type", js("modelTurn")), kv("parts", parts)])));
        true
      },
      None => true
    },
    None => true
  }

func handleToolCallEvent(json: Json) -> bool ! {IO} {
  let tc = getOrElse(get(json, "toolCall"), jo([]));
  let calls = getOrElse(get(tc, "functionCalls"), ja([]));
  println(encode(jo([kv("type", js("toolCall")), kv("calls", calls)])));
  true
}

-- ══════════════════════════════════════════════════════
-- Protocol: Setup Message Builder
-- ══════════════════════════════════════════════════════

-- Build ambient setup: proactive audio ON, affective ON, session resumption, transcription.
-- Uses AI Studio v1alpha which supports all features.
export pure func buildAmbientSetup(model: string, voice: string, instruction: string) -> string {
  let setupKvs = [
    kv("model", js(model)),
    kv("generationConfig", jo([
      kv("responseModalities", ja([js("AUDIO")])),
      kv("speechConfig", jo([
        kv("voiceConfig", jo([
          kv("prebuiltVoiceConfig", jo([
            kv("voiceName", js(voice))
          ]))
        ]))
      ]))
    ])),
    kv("systemInstruction", jo([
      kv("parts", ja([jo([kv("text", js(instruction))])]))
    ])),
    kv("outputAudioTranscription", jo([])),
    kv("inputAudioTranscription", jo([])),
    kv("contextWindowCompression", jo([
      kv("slidingWindow", jo([]))
    ])),
    -- Proactive audio: model decides when to respond
    kv("proactivity", jo([kv("proactiveAudio", jb(true))])),
    -- Affective dialog: emotion-aware tone (v1alpha only)
    kv("enableAffectiveDialog", jb(true))
  ];
  encode(jo([kv("setup", jo(setupKvs))]))
}

-- ══════════════════════════════════════════════════════
-- Protocol: Outgoing Messages (pure helpers)
-- ══════════════════════════════════════════════════════

export pure func buildTextMessage(text: string) -> string =
  encode(jo([
    kv("clientContent", jo([
      kv("turns", ja([jo([
        kv("role", js("user")),
        kv("parts", ja([jo([kv("text", js(text))])]))
      ])])),
      kv("turnComplete", jb(true))
    ]))
  ]))

export pure func buildAudioChunk(b64Audio: string) -> string =
  encode(jo([
    kv("realtimeInput", jo([
      kv("mediaChunks", ja([jo([
        kv("mimeType", js("audio/pcm;rate=16000")),
        kv("data", js(b64Audio))
      ])]))
    ]))
  ]))

export pure func buildToolResponse(callId: string, name: string, result: string) -> string =
  encode(jo([
    kv("toolResponse", jo([
      kv("functionResponses", ja([jo([
        kv("id", js(callId)),
        kv("name", js(name)),
        kv("response", jo([kv("result", js(result))]))
      ])]))
    ]))
  ]))

-- ══════════════════════════════════════════════════════
-- Protocol: Incoming Message Parsing (pure helper)
-- ══════════════════════════════════════════════════════

export pure func parseMessage(jsonStr: string) -> string {
  match decode(jsonStr) {
    Err(e) => encode(jo([kv("type", js("error")), kv("text", js(e))])),
    Ok(json) => {
      if has(json, "setupComplete")
      then encode(jo([kv("type", js("setup"))]))
      else if has(json, "toolCall") then {
        let tc = getOrElse(get(json, "toolCall"), jo([]));
        let calls = getOrElse(get(tc, "functionCalls"), ja([]));
        encode(jo([kv("type", js("toolCall")), kv("calls", calls)]))
      }
      else if has(json, "serverContent")
      then parseServerContentPure(json)
      else if has(json, "toolCallCancellation")
      then encode(jo([kv("type", js("toolCallCancellation"))]))
      else if has(json, "goAway")
      then encode(jo([kv("type", js("goAway"))]))
      else encode(jo([kv("type", js("unknown"))]))
    }
  }
}

pure func parseServerContentPure(json: Json) -> string {
  let sc = getOrElse(get(json, "serverContent"), jo([]));
  match getBool(sc, "interrupted") {
    Some(true) => encode(jo([kv("type", js("interrupted"))])),
    _ => match getBool(sc, "turnComplete") {
      Some(true) => encode(jo([kv("type", js("turnComplete"))])),
      _ => {
        -- Check transcriptions first
        if has(sc, "inputTranscription") then {
          let it = getOrElse(get(sc, "inputTranscription"), jo([]));
          let txt = getOrElse(asString(getOrElse(get(it, "text"), js(""))), "");
          if length(txt) > 0
          then encode(jo([kv("type", js("inputTranscript")), kv("text", js(txt))]))
          else checkOutputTranscriptPure(sc)
        }
        else checkOutputTranscriptPure(sc)
      }
    }
  }
}

pure func checkOutputTranscriptPure(sc: Json) -> string {
  if has(sc, "outputTranscription") then {
    let ot = getOrElse(get(sc, "outputTranscription"), jo([]));
    let txt = getOrElse(asString(getOrElse(get(ot, "text"), js(""))), "");
    if length(txt) > 0
    then encode(jo([kv("type", js("outputTranscript")), kv("text", js(txt))]))
    else checkModelTurnPure(sc)
  }
  else checkModelTurnPure(sc)
}

pure func checkModelTurnPure(sc: Json) -> string =
  match getObject(sc, "modelTurn") {
    Some(mt) => match get(mt, "parts") {
      Some(parts) => encode(jo([kv("type", js("modelTurn")), kv("parts", parts)])),
      None => encode(jo([kv("type", js("unknown"))]))
    },
    None => encode(jo([kv("type", js("unknown"))]))
  }
