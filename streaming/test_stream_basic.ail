module streaming/test_stream_basic

-- std/stream verification suite
--
-- connect/transmit return Result[_, StreamErrorKind]; every call site matches
-- on it explicitly. An earlier revision of this suite relied on Ok(StreamConn)
-- being auto-unwrapped into a bare StreamConn, which the stdlib no longer does
-- (and should not: a failed connect is a value the caller has to handle).
import std/stream (connect, transmit, onEvent, runEventLoop, disconnect, status, defaultConfig, withStream, withSSE, sseConnect)
import std/string (startsWith)

let echoUrl = "wss://ws.postman-echo.com/raw"

-- Connect, hand the live connection to `body`, then always disconnect.
-- A failed connect is reported and the test is skipped rather than crashing.
func withConnection(label: string, cfg: {headers: [{name: string, value: string}]},
                    body: (StreamConn) -> () ! {IO, Stream}) -> () ! {IO, Stream} =
  match connect(echoUrl, cfg) {
    Ok(conn) => {
      body(conn);
      disconnect(conn);
      println("  PASS");
      println("")
    },
    Err(e) => {
      println("  FAIL: connect: ${e}");
      println("")
    }
  }

-- ============================================================================
-- Test 1: defaultConfig
-- ============================================================================
func testDefaultConfig() -> () ! {IO} {
  println("[Test 1] defaultConfig...");
  let cfg = defaultConfig(());
  println("  Result: ${cfg}");
  println("  PASS");
  println("")
}

-- ============================================================================
-- Test 2: connect + disconnect
-- ============================================================================
func testConnect() -> () ! {IO, Stream} {
  println("[Test 2] connect + disconnect...");
  withConnection("connect", defaultConfig(()), \conn. {
    println("  connect(): Ok(${conn})")
  })
}

-- ============================================================================
-- Test 3: status
-- ============================================================================
func testStatus() -> () ! {IO, Stream} {
  println("[Test 3] status...");
  withConnection("status", defaultConfig(()), \conn. {
    println("  status(): ${status(conn)}")
  })
}

-- ============================================================================
-- Test 4: onEvent + runEventLoop
-- ============================================================================
func testOnEvent() -> () ! {IO, Stream} {
  println("[Test 4] onEvent + runEventLoop...");
  withConnection("onEvent", defaultConfig(()), \conn. {
    onEvent(conn, \event. {
      println("  Event: ${event}");
      false  -- stop after first event
    });
    runEventLoop(conn)
  })
}

-- ============================================================================
-- Test 5: withStream
-- ============================================================================
func testWithStream() -> () ! {IO, Stream} {
  println("[Test 5] withStream...");
  let result = withStream(echoUrl, \event. {
    println("  withStream event: ${event}");
    false
  });
  println("  withStream returned: ${result}");
  println("  PASS");
  println("")
}

-- ============================================================================
-- Test 6: Error handling — a bad URL must surface as Err, not as a crash
-- ============================================================================
func testBadUrl() -> () ! {IO, Stream} {
  println("[Test 6] Connect to bad URL...");
  match connect("wss://this-will-fail.invalid/ws", defaultConfig(())) {
    Ok(conn) => {
      disconnect(conn);
      println("  FAIL: expected Err from an unresolvable host")
    },
    Err(e) => {
      println("  Err as expected: ${e}");
      println("  PASS")
    }
  };
  println("")
}

-- ============================================================================
-- Test 7: transmit
-- ============================================================================
func testTransmit() -> () ! {IO, Stream} {
  println("[Test 7] transmit with plain string...");
  withConnection("transmit", defaultConfig(()), \conn. {
    match transmit(conn, "Hello from AILANG!") {
      Ok(_) => println("  transmit(): Ok"),
      Err(e) => println("  transmit(): Err ${e}")
    };
    onEvent(conn, \event. {
      println("  Echo event: ${event}");
      false
    });
    runEventLoop(conn)
  })
}

-- ============================================================================
-- Test 8: Config with headers
-- ============================================================================
func testHeaders() -> () ! {IO, Stream} {
  println("[Test 8] Config with custom headers...");
  withConnection("headers", {headers: [{name: "X-Custom", value: "ailang-test"}]}, \conn. {
    println("  Connected with headers: ${conn}")
  })
}

-- ============================================================================
-- Test 9: Full echo round-trip (send message, receive echo back)
-- ============================================================================
func testEchoRoundTrip() -> () ! {IO, Stream} {
  println("[Test 9] Full echo round-trip...");
  withConnection("echo", defaultConfig(()), \conn. {
    match transmit(conn, "AILANG echo test 123") {
      Ok(_) => println("  Sent: Ok"),
      Err(e) => println("  Sent: Err ${e}")
    };
    -- Stop as soon as a Message (the echo) arrives; keep going on Opened.
    onEvent(conn, \event. {
      println("  Event: ${event}");
      not (startsWith(show(event), "Message"))
    });
    runEventLoop(conn)
  })
}

-- ============================================================================
-- Main
-- ============================================================================
export func main() -> () ! {IO, Stream} {
  println("=== std/stream Verification ===");
  println("");

  testDefaultConfig();
  testConnect();
  testStatus();
  testOnEvent();
  testWithStream();
  testBadUrl();
  testTransmit();
  testHeaders();
  testEchoRoundTrip();

  println("=== Summary ===");
  println("  connect, disconnect, status, transmit, onEvent, runEventLoop, withStream");
  println("")
}
